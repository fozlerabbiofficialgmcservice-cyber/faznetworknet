<%
const dashboardBody = `
<section class="space-y-7">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
    <div><p class="text-sm font-medium text-cyan-600">FAZ NETWORK</p><h2 class="text-3xl font-black">Network Overview</h2><p class="text-slate-500">Live MikroTik resources and interface traffic monitoring.</p></div>
    <div id="current-time" class="text-sm text-slate-500"></div>
  </div>

  <div class="bg-white rounded-2xl border border-cyan-100 shadow-sm overflow-hidden">
    <div class="p-6 md:p-8 bg-gradient-to-br from-cyan-50 via-white to-emerald-50">
      <div class="max-w-3xl">
        <p class="text-xs font-black uppercase tracking-widest text-cyan-700">Customer Self-Care</p>
        <h3 class="mt-1 text-2xl md:text-3xl font-black text-slate-900">Check Your Internet Account / Validity</h3>
        <p class="mt-2 text-sm text-slate-500">Enter your PPPoE username, phone number, or Customer ID to see your live account status.</p>
        <form id="publicCustomerCheckForm" class="mt-5 flex flex-col sm:flex-row gap-2">
          <input id="publicCustomerQuery" type="text" maxlength="120" autocomplete="off" class="flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-cyan-500" placeholder="Username, phone number, or Customer ID" required>
          <button id="publicCustomerCheckBtn" type="submit" class="rounded-xl bg-cyan-600 px-5 py-3 text-sm font-bold text-white hover:bg-cyan-700 disabled:opacity-60">Check Account</button>
        </form>
        <div id="publicCustomerResult" class="mt-5 hidden"></div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
    <div class="summary-card"><p class="label">Today Collection</p><p id="today-collection-dashboard" class="metric">৳0.00</p><p class="hint">Processed payments</p></div>
    <div class="summary-card"><p class="label">CPU Load</p><p id="cpu-value" class="metric">0.0%</p><div class="gauge-track"><div id="cpu-bar" class="gauge-fill" style="width:0%"></div></div></div>
    <div class="summary-card"><p class="label">RAM Usage</p><p id="memory-value" class="metric">0.0%</p><div class="gauge-track"><div id="memory-bar" class="gauge-fill" style="width:0%"></div></div></div>
    <div class="summary-card"><p class="label">System Uptime</p><p id="uptime-value" class="metric metric-small">Waiting...</p><p class="hint">RouterOS system uptime</p></div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200"><div class="flex items-center justify-between"><div><h3 class="font-bold text-lg">Recent Payments</h3><p class="text-sm text-slate-500">Latest bKash, Nagad and Rocket collections.</p></div><a href="/transactions" class="text-sm font-bold text-cyan-700">View all →</a></div><div id="dashboard-payments" class="mt-4 space-y-2"><p class="text-sm text-slate-400">Loading payments...</p></div></div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div><h3 class="font-bold text-lg">Live MikroTik Traffic</h3><p class="text-sm text-slate-500">Real-time interface throughput, sampled every 2.5 seconds.</p></div>
        <div class="w-full sm:w-72"><label for="interface-select" class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Interface</label><select id="interface-select" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium outline-none focus:ring-2 focus:ring-cyan-500"><option value="">Loading interfaces...</option></select></div>
      </div>
    </div>
    <div class="p-6"><div class="h-80"><canvas id="traffic-chart"></canvas></div></div>
  </div>
</section>`;
%>
<script>
(() => {
  const form=document.getElementById('publicCustomerCheckForm');
  const result=document.getElementById('publicCustomerResult');
  const button=document.getElementById('publicCustomerCheckBtn');
  const input=document.getElementById('publicCustomerQuery');
  if(!form||!result||!button||!input)return;

  const esc=(value)=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const show=(html)=>{result.innerHTML=html;result.classList.remove('hidden');};

  form.addEventListener('submit',async event=>{
    event.preventDefault();
    const query=input.value.trim();
    if(!query)return;
    button.disabled=true;button.textContent='Checking...';
    show('<div class="rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-500">Checking live account status...</div>');
    try{
      const response=await fetch('/api/public/customer-check?query='+encodeURIComponent(query),{headers:{Accept:'application/json'}});
      const data=await response.json().catch(()=>({success:false,message:'Invalid server response.'}));
      if(!response.ok||!data.success)throw new Error(data.message||'Customer account was not found.');
      const c=data.customer||{};
      const online=c.connectionStatus==='Online';
      const paid=String(c.billingStatus||'').toLowerCase()==='paid';
      const days=c.remainingDays==null?'—':String(c.remainingDays);
      const expiry=c.expirationDate||'No expiry date';
      const contact=c.supportPhone?'<a class="font-bold text-cyan-700 hover:underline" href="tel:'+esc(c.supportPhone)+'">Call '+esc(c.supportPhone)+'</a>':'<span class="text-slate-500">Contact your ISP support team</span>';
      const recharge=c.rechargeUrl?'<a class="rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white hover:bg-emerald-700" href="'+esc(c.rechargeUrl)+'">Recharge</a>':'';
      show('<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">'+
        '<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">'+
          '<div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Customer</p><h4 class="text-xl font-black text-slate-900">'+esc(c.name||c.username)+'</h4><p class="text-sm text-slate-500 font-mono">'+esc(c.username||'')+'</p></div>'+
          '<span class="inline-flex w-fit items-center rounded-full px-3 py-1 text-xs font-bold '+(online?'bg-emerald-100 text-emerald-700':'bg-slate-100 text-slate-600')+'">'+(online?'● Online':'● Offline')+'</span>'+
        '</div>'+
        '<div class="mt-5 grid grid-cols-2 md:grid-cols-4 gap-3">'+
          '<div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-400">Package / Plan</p><p class="mt-1 font-bold text-slate-800">'+esc(c.package||c.profile||'-')+'</p></div>'+
          '<div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-400">Expiration</p><p class="mt-1 font-bold text-slate-800">'+esc(expiry)+'</p></div>'+
          '<div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-400">Remaining Days</p><p class="mt-1 font-bold text-slate-800">'+esc(days)+'</p></div>'+
          '<div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-400">Billing Status</p><p class="mt-1 font-bold '+(paid?'text-emerald-600':'text-red-600')+'">'+esc(paid?'Paid':'Unpaid')+'</p></div>'+
        '</div>'+
        '<div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm">'+
          '<div><span class="font-semibold">Live IP:</span> '+esc(c.liveIp||'Not online')+'</div>'+
          '<div class="flex items-center gap-2">'+contact+recharge+'</div>'+
        '</div>'+
      '</div>');
    }catch(error){
      show('<div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700">'+esc(error.message)+'</div>');
    }finally{button.disabled=false;button.textContent='Check Account';}
  });
})();
</script>
<%- include("layout", { body: dashboardBody, title: title, page: page }) %>
