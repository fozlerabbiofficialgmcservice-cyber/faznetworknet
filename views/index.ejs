<%
const dashboardBody = `
<section class="bg-white border border-slate-200 rounded-2xl shadow-sm px-4 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <div>
    <p class="text-xs font-black uppercase tracking-widest text-cyan-600">FAZ NETWORK</p>
    <p class="text-sm text-slate-500">Customer Service Portal</p>
  </div>
  <div class="flex items-center gap-2 justify-end">
    <button type="button" id="openSupportBtn" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 hover:border-cyan-400 hover:text-cyan-700">
      <span>💬</span> Support
    </button>
    <button type="button" id="openCustomerLoginBtn" class="inline-flex items-center gap-2 rounded-xl bg-cyan-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-cyan-700">
      <span>👤</span> Customer Login
    </button>
  </div>
</section>

  <section class="space-y-7">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
    <div><p class="text-sm font-medium text-cyan-600">FAZ NETWORK</p><h2 class="text-3xl font-black">Network Overview</h2><p class="text-slate-500">Live MikroTik resources and interface traffic monitoring.</p></div>
    <div id="current-time" class="text-sm text-slate-500"></div>
  </div>

  <div class="bg-white rounded-2xl border border-cyan-100 shadow-sm overflow-hidden">
    <div class="p-6 md:p-8 bg-gradient-to-br from-cyan-50 via-white to-emerald-50">
      <div class="max-w-3xl">
        <p class="text-xs font-black uppercase tracking-widest text-cyan-700">Customer Self-Care</p>
        <h3 class="mt-1 text-2xl md:text-3xl font-black text-slate-900">Check Your Internet Account / Validity</h3>
        <p class="mt-2 text-sm text-slate-500">Enter your PPPoE username, phone number, or Customer ID to see your live account status.</p>
        <form id="publicCustomerCheckForm" class="mt-5 flex flex-col sm:flex-row gap-2">
          <input id="publicCustomerQuery" type="text" maxlength="120" autocomplete="off" class="flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-cyan-500" placeholder="Username, phone number, or Customer ID" required>
          <button id="publicCustomerCheckBtn" type="submit" class="rounded-xl bg-cyan-600 px-5 py-3 text-sm font-bold text-white hover:bg-cyan-700 disabled:opacity-60">Check Account</button>
        </form>
        <div id="publicCustomerResult" class="mt-5 hidden"></div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
    <div class="summary-card"><p class="label">Today Collection</p><p id="today-collection-dashboard" class="metric">৳0.00</p><p class="hint">Processed payments</p></div>
    <div class="summary-card"><p class="label">CPU Load</p><p id="cpu-value" class="metric">0.0%</p><div class="gauge-track"><div id="cpu-bar" class="gauge-fill" style="width:0%"></div></div></div>
    <div class="summary-card"><p class="label">RAM Usage</p><p id="memory-value" class="metric">0.0%</p><div class="gauge-track"><div id="memory-bar" class="gauge-fill" style="width:0%"></div></div></div>
    <div class="summary-card"><p class="label">System Uptime</p><p id="uptime-value" class="metric metric-small">Waiting...</p><p class="hint">RouterOS system uptime</p></div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200"><div class="flex items-center justify-between"><div><h3 class="font-bold text-lg">Recent Payments</h3><p class="text-sm text-slate-500">Latest bKash, Nagad and Rocket collections.</p></div><a href="/transactions" class="text-sm font-bold text-cyan-700">View all →</a></div><div id="dashboard-payments" class="mt-4 space-y-2"><p class="text-sm text-slate-400">Loading payments...</p></div></div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div><h3 class="font-bold text-lg">Live MikroTik Traffic</h3><p class="text-sm text-slate-500">Real-time interface throughput, sampled every 2.5 seconds.</p></div>
        <div class="w-full sm:w-72"><label for="interface-select" class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Interface</label><select id="interface-select" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium outline-none focus:ring-2 focus:ring-cyan-500"><option value="">Loading interfaces...</option></select></div>
      </div>
    </div>
    <div class="p-6"><div class="h-80"><canvas id="traffic-chart"></canvas></div></div>
  </div>
<div id="customerLoginModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4" role="dialog" aria-modal="true" aria-labelledby="customerLoginTitle">
  <div class="w-full max-w-2xl max-h-[92vh] overflow-y-auto rounded-2xl bg-white shadow-2xl">
    <div class="flex items-start justify-between border-b border-slate-200 px-5 py-4">
      <div><p class="text-xs font-black uppercase tracking-widest text-cyan-600">Self-Care</p><h3 id="customerLoginTitle" class="text-xl font-black text-slate-900">Customer Login</h3><p class="mt-1 text-xs text-slate-500">Use your PPPoE username or registered phone number.</p></div>
      <button type="button" id="closeCustomerLoginBtn" class="rounded-lg px-3 py-1 text-2xl text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Close">×</button>
    </div>
    <div class="p-5">
      <div id="customerLoginPanel">
        <form id="customerLoginForm" class="space-y-4">
          <div><label for="customerLoginIdentifier" class="mb-1 block text-sm font-bold text-slate-700">Username / Phone Number</label><input id="customerLoginIdentifier" type="text" maxlength="120" autocomplete="username" required class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-cyan-500" placeholder="PPPoE username or phone number"></div>
          <div><label for="customerLoginPassword" class="mb-1 block text-sm font-bold text-slate-700">Password</label><input id="customerLoginPassword" type="password" maxlength="255" autocomplete="current-password" required class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-cyan-500" placeholder="PPPoE password"></div>
          <div id="customerLoginError" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></div>
          <button id="customerLoginSubmit" type="submit" class="w-full rounded-xl bg-cyan-600 px-5 py-3 text-sm font-bold text-white hover:bg-cyan-700 disabled:opacity-60">Login to Account</button>
        </form>
      </div>
      <div id="customerDashboardPanel" class="hidden"></div>
    </div>
  </div>
</div>

<div id="supportModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4" role="dialog" aria-modal="true" aria-labelledby="supportTitle">
  <div class="w-full max-w-lg rounded-2xl bg-white shadow-2xl">
    <div class="flex items-start justify-between border-b border-slate-200 px-5 py-4">
      <div><p class="text-xs font-black uppercase tracking-widest text-cyan-600">Helpdesk</p><h3 id="supportTitle" class="text-xl font-black text-slate-900">FAZ NETWORK Support</h3></div>
      <button type="button" id="closeSupportBtn" class="rounded-lg px-3 py-1 text-2xl text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Close">×</button>
    </div>
    <div class="p-5 space-y-3">
      <a href="https://wa.me/8801339932887" target="_blank" rel="noopener" class="flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 hover:bg-emerald-100">
        <span class="text-xl">💬</span><span><strong class="block text-slate-900">WhatsApp</strong><span class="text-sm text-slate-600">Chat with FAZ NETWORK support</span></span>
      </a>
      <a href="tel:01339932887" class="flex items-center gap-3 rounded-xl border border-cyan-200 bg-cyan-50 p-4 hover:bg-cyan-100">
        <span class="text-xl">☎</span><span><strong class="block text-slate-900">Helpline</strong><span class="text-sm text-slate-600">01339932887</span></span>
      </a>
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <p class="text-xs font-black uppercase tracking-wide text-slate-400">Office Address</p>
        <p class="mt-1 text-sm font-semibold text-slate-800"><%= process.env.OFFICE_ADDRESS || "FAZ NETWORK Office — Please contact the helpline for the current office address." %></p>
      </div>
    </div>
  </div>
</div>

</section>`;
%>
<script>
(() => {
  const form=document.getElementById('publicCustomerCheckForm');
  const result=document.getElementById('publicCustomerResult');
  const button=document.getElementById('publicCustomerCheckBtn');
  const input=document.getElementById('publicCustomerQuery');
  const loginModal=document.getElementById('customerLoginModal');
  const supportModal=document.getElementById('supportModal');
  const loginForm=document.getElementById('customerLoginForm');
  const loginIdentifier=document.getElementById('customerLoginIdentifier');
  const loginPassword=document.getElementById('customerLoginPassword');
  const loginSubmit=document.getElementById('customerLoginSubmit');
  const loginError=document.getElementById('customerLoginError');
  const dashboardPanel=document.getElementById('customerDashboardPanel');
  const loginPanel=document.getElementById('customerLoginPanel');
  const openLogin=document.getElementById('openCustomerLoginBtn');
  const openSupport=document.getElementById('openSupportBtn');
  const closeLogin=document.getElementById('closeCustomerLoginBtn');
  const closeSupport=document.getElementById('closeSupportBtn');
  if(!form||!result||!button||!input)return;

  const setModal=(el,show)=>{
    if(!el)return;
    el.classList.toggle('hidden',!show);
    el.classList.toggle('flex',show);
    if(show) document.body.classList.add('overflow-hidden');
    else if(!document.querySelector('[role="dialog"].flex')) document.body.classList.remove('overflow-hidden');
  };
  const resetLogin=()=>{
    if(loginPanel){loginPanel.classList.remove('hidden','opacity-0','translate-y-1');loginPanel.classList.add('opacity-100');}
    if(dashboardPanel){dashboardPanel.classList.add('hidden');dashboardPanel.classList.remove('opacity-100');dashboardPanel.innerHTML='';}
    if(loginError){loginError.classList.add('hidden');loginError.textContent='';}
    if(loginForm)loginForm.reset();
  };
  openLogin?.addEventListener('click',()=>{resetLogin();setModal(loginModal,true);setTimeout(()=>loginIdentifier?.focus(),50);});
  closeLogin?.addEventListener('click',()=>setModal(loginModal,false));
  openSupport?.addEventListener('click',()=>setModal(supportModal,true));
  closeSupport?.addEventListener('click',()=>setModal(supportModal,false));
  [loginModal,supportModal].forEach(modal=>modal?.addEventListener('click',e=>{if(e.target===modal)setModal(modal,false);}));
  document.addEventListener('keydown',e=>{if(e.key==='Escape'){setModal(loginModal,false);setModal(supportModal,false);}});

  loginForm?.addEventListener('submit',async event=>{
    event.preventDefault();
    const identifier=loginIdentifier?.value.trim()||'';
    const password=loginPassword?.value||'';
    if(!identifier||!password)return;
    loginSubmit.disabled=true;loginSubmit.innerHTML='<span class="inline-flex items-center justify-center gap-2"><span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span> Verifying...</span>';
    loginError?.classList.add('hidden');
    try{
      const response=await fetch('/api/public/customer-login',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({identifier,password})});
      const data=await response.json().catch(()=>({success:false,message:'Invalid server response.'}));
      if(!response.ok||!data.success){
        const message=String(data.message||'Login failed. Please try again.');
        throw new Error(message);
      }
      const c=data.customer||{};
      const paid=String(c.billingStatus||'').toLowerCase()==='paid';
      const online=c.connectionStatus==='Online';
      const recharge=c.rechargeUrl
        ? '<a href="'+esc(c.rechargeUrl)+'" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white hover:bg-emerald-700">Pay / Recharge Bill</a>'
        : '<div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800"><strong>Recharge:</strong> Contact Helpline 01339932887 or use WhatsApp support for bKash/Nagad payment instructions.</div>';
      if(loginPanel){
        loginPanel.classList.add('opacity-0','translate-y-1','transition','duration-200');
        setTimeout(()=>loginPanel.classList.add('hidden'),180);
      }
      if(dashboardPanel){
        dashboardPanel.classList.remove('hidden','opacity-0');
        dashboardPanel.classList.add('opacity-100','transition','duration-300');
        dashboardPanel.innerHTML='<div class="flex items-start justify-between gap-3"><div><p class="text-xs font-black uppercase tracking-wide text-cyan-600">My Account</p><h4 class="mt-1 text-2xl font-black text-slate-900">'+esc(c.name||c.username)+'</h4><p class="text-sm font-mono text-slate-500">'+esc(c.username||'')+'</p></div><span class="rounded-full px-3 py-1 text-xs font-bold '+(online?'bg-emerald-100 text-emerald-700':'bg-slate-100 text-slate-600')+'">'+(online?'● Online':'● Offline')+'</span></div>'+
        '<div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">'+
        '<div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Registered Phone</p><p class="mt-1 font-bold text-slate-800">'+esc(c.phone||'-')+'</p></div>'+
        '<div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Package / Bandwidth</p><p class="mt-1 font-bold text-slate-800">'+esc(c.package||c.profile||'-')+'</p></div>'+
        '<div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Expiration Date</p><p class="mt-1 font-bold text-slate-800">'+esc(c.expirationDate||'-')+'</p></div>'+
        '<div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Remaining Days</p><p class="mt-1 font-bold text-slate-800">'+esc(c.remainingDays==null?'—':c.remainingDays)+'</p></div>'+
        '<div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Billing Status</p><p class="mt-1 font-bold '+(paid?'text-emerald-600':'text-red-600')+'">'+(paid?'Paid':'Unpaid')+'</p></div>'+
        '<div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Live Connection</p><p class="mt-1 font-bold text-slate-800">'+(online?'Online · '+esc(c.liveIp||'Connected'):'Offline')+'</p>'+(c.uptime?'<p class="text-xs text-slate-500 mt-1">Uptime: '+esc(c.uptime)+'</p>':'')+'</div>'+
        '</div><div class="mt-5 space-y-3">'+recharge+'<div class="flex gap-2"><a href="'+esc(c.whatsappUrl||'https://wa.me/8801339932887')+'" target="_blank" rel="noopener" class="flex-1 rounded-xl border border-emerald-300 px-4 py-3 text-center text-sm font-bold text-emerald-700 hover:bg-emerald-50">WhatsApp Support</a><a href="tel:01339932887" class="flex-1 rounded-xl border border-cyan-300 px-4 py-3 text-center text-sm font-bold text-cyan-700 hover:bg-cyan-50">Call Helpline</a></div><p class="text-xs text-slate-400 text-center">Office: '+esc(c.officeAddress||'Contact support for office address')+'</p></div>';
      }
    }catch(error){
      if(loginError){loginError.textContent=error.message||'Invalid Username/Phone or Password';loginError.classList.remove('hidden');}
    }finally{loginSubmit.disabled=false;loginSubmit.textContent='Login to Account';}
  });

  const esc=(value)=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const show=(html)=>{result.innerHTML=html;result.classList.remove('hidden');};

  form.addEventListener('submit',async event=>{
    event.preventDefault();
    const query=input.value.trim();
    if(!query)return;
    button.disabled=true;button.textContent='Checking...';
    show('<div class="rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-500">Checking live account status...</div>');
    try{
      const response=await fetch('/api/public/customer-check?query='+encodeURIComponent(query),{headers:{Accept:'application/json'}});
      const data=await response.json().catch(()=>({success:false,message:'Invalid server response.'}));
      if(!response.ok||!data.success)throw new Error(data.message||'Customer account was not found.');
      const c=data.customer||{};
      const online=c.connectionStatus==='Online';
      const paid=String(c.billingStatus||'').toLowerCase()==='paid';
      const days=c.remainingDays==null?'—':String(c.remainingDays);
      const expiry=c.expirationDate||'No expiry date';
      const contact=c.supportPhone?'<a class="font-bold text-cyan-700 hover:underline" href="tel:'+esc(c.supportPhone)+'">Call '+esc(c.supportPhone)+'</a>':'<span class="text-slate-500">Contact your ISP support team</span>';
      const recharge=c.rechargeUrl?'<a class="rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white hover:bg-emerald-700" href="'+esc(c.rechargeUrl)+'">Recharge</a>':'';
      show('<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">'+
        '<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">'+
          '<div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Customer</p><h4 class="text-xl font-black text-slate-900">'+esc(c.name||c.username)+'</h4><p class="text-sm text-slate-500 font-mono">'+esc(c.username||'')+'</p></div>'+
          '<span class="inline-flex w-fit items-center rounded-full px-3 py-1 text-xs font-bold '+(online?'bg-emerald-100 text-emerald-700':'bg-slate-100 text-slate-600')+'">'+(online?'● Online':'● Offline')+'</span>'+
        '</div>'+
        '<div class="mt-5 grid grid-cols-2 md:grid-cols-4 gap-3">'+
          '<div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-400">Package / Plan</p><p class="mt-1 font-bold text-slate-800">'+esc(c.package||c.profile||'-')+'</p></div>'+
          '<div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-400">Expiration</p><p class="mt-1 font-bold text-slate-800">'+esc(expiry)+'</p></div>'+
          '<div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-400">Remaining Days</p><p class="mt-1 font-bold text-slate-800">'+esc(days)+'</p></div>'+
          '<div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-400">Billing Status</p><p class="mt-1 font-bold '+(paid?'text-emerald-600':'text-red-600')+'">'+esc(paid?'Paid':'Unpaid')+'</p></div>'+
        '</div>'+
        '<div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm">'+
          '<div><span class="font-semibold">Live IP:</span> '+esc(c.liveIp||'Not online')+'</div>'+
          '<div class="flex items-center gap-2">'+contact+recharge+'</div>'+
        '</div>'+
      '</div>');
    }catch(error){
      show('<div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700">'+esc(error.message)+'</div>');
    }finally{button.disabled=false;button.textContent='Check Account';}
  });
})();
</script>
<%- include("layout", { body: dashboardBody, title: title, page: page }) %>
