<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= title ? title+" | FAZ NETWORK" : "FAZ NETWORK" %></title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-100 text-slate-900">
<div class="min-h-screen flex">
<aside class="w-72 bg-slate-950 text-white hidden lg:flex lg:flex-col">
<div class="px-6 py-7 border-b border-slate-800"><div class="text-2xl font-black">FAZ <span class="text-cyan-400">NETWORK</span></div><p class="mt-1 text-xs text-slate-400">ISP & Hotspot Billing</p></div>
<nav class="flex-1 p-4 space-y-2">
<a href="/" class="nav-link <%= page === "dashboard" ? "active" : "" %>">Dashboard <span>Overview</span></a>
<a href="/pppoe" class="nav-link <%= page === "pppoe" ? "active" : "" %>">PPPoE Users & Profiles</a>
<a href="/hotspot" class="nav-link">Hotspot Vouchers</a>
<a href="/transactions" class="nav-link">Transactions <span>bKash / Nagad / Rocket</span></a>
<a href="/router" class="nav-link <%= page === "router" ? "active" : "" %>">Router Settings</a>
</nav>
<div class="p-5 border-t border-slate-800 text-xs text-slate-500">FAZ NETWORK Web Panel</div>
</aside>
<div class="flex-1 min-w-0">
<header class="bg-white border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center justify-between">
<div><p class="text-xs uppercase tracking-widest text-slate-400">Control Panel</p><h1 class="text-xl font-bold"><%= title || "Dashboard" %></h1></div>
<span id="router-status" class="inline-flex items-center gap-2 rounded-full bg-red-50 text-red-700 px-3 py-1.5 text-xs font-bold"><span class="h-2 w-2 rounded-full bg-red-500"></span>Disconnected</span>
</header>
<main class="p-5 lg:p-8"><%- body %></main>
</div></div>
<script src="/js/main.js"></script>
</body></html>
