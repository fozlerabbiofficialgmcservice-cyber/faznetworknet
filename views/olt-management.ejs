<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>FAZ NETWORK — OLT Management</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
:root{--faz:#0a3d2e;--accent:#10b981}body{background:#f8fafc;color:#172b24;font-family:Inter,system-ui,sans-serif}.top{background:var(--faz);color:#fff;padding:1rem 1.25rem}.card{border:0;border-radius:14px;box-shadow:0 2px 14px #0a3d2e10}.btn-faz{background:var(--faz);color:#fff}.btn-faz:hover{background:#0d4d3a;color:#fff}.muted{color:#64748b}.form-label{font-size:.85rem;font-weight:650}.status{display:inline-flex;align-items:center;gap:.5rem;border-radius:999px;padding:.45rem .7rem;background:#f1f5f9;color:#475569;font-size:.78rem;font-weight:750}.status.reachable_unverified{background:#fffbeb;color:#92400e}.status.unreachable{background:#fef2f2;color:#991b1b}.status.not_tested{background:#f1f5f9;color:#475569}.status.connected{background:#ecfdf5;color:#065f46}
</style></head>
<body>
<header class="top d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong><i class="bi bi-hdd-network me-2"></i>FAZ NETWORK</strong><div class="small">OLT Management · V-SOL GEPON OLT</div></div><a class="btn btn-outline-light btn-sm" href="/admin"><i class="bi bi-arrow-left me-1"></i>Back to Admin Panel</a></header>
<main class="container-fluid p-3 p-lg-4">
<div id="notice" class="alert alert-info" role="status">Loading OLT settings…</div>
<div class="row g-3">
<div class="col-12 col-xl-7"><section class="card p-3 p-lg-4">
<div class="d-flex justify-content-between flex-wrap gap-2 align-items-start mb-3"><div><h4 class="mb-1">Connection Settings</h4><div class="muted small">Configure the web-management endpoint. Credentials are encrypted at rest.</div></div><span id="connectionStatus" class="status not_tested">Not tested</span></div>
<form id="oltForm" class="row g-3">
<div class="col-12 col-md-6"><label class="form-label">Device name</label><input class="form-control" name="name" maxlength="120" value="Main OLT" required></div>
<div class="col-12 col-md-6"><label class="form-label">Vendor / model</label><input class="form-control" value="V-SOL V1601E04-DP" disabled></div>
<div class="col-12 col-md-7"><label class="form-label">Management IPv4</label><input class="form-control" name="managementIp" inputmode="decimal" placeholder="OLT-এর বর্তমান LAN IP" required></div>
<div class="col-6 col-md-3"><label class="form-label">Web protocol</label><select class="form-select" name="protocol"><option value="http">HTTP</option><option value="https">HTTPS</option></select></div>
<div class="col-6 col-md-2"><label class="form-label">Port</label><input class="form-control" name="port" type="number" min="1" max="65535" value="80" required></div>
<div class="col-12 col-md-6"><label class="form-label">OLT username</label><input class="form-control" name="username" autocomplete="username" placeholder="Your configured username"></div>
<div class="col-12 col-md-6"><label class="form-label">OLT password</label><input class="form-control" name="password" type="password" autocomplete="new-password" placeholder="Leave blank to keep saved password"></div>
<div class="col-12 d-flex flex-wrap gap-2"><button class="btn btn-faz" type="submit"><i class="bi bi-shield-lock me-1"></i>Save Settings</button><button class="btn btn-outline-success" type="button" id="testBtn"><i class="bi bi-plug me-1"></i>Test Connection</button><span id="formMessage" class="small muted align-self-center"></span></div>
</form></section></div>
<div class="col-12 col-xl-5"><section class="card p-3 p-lg-4 h-100"><h5><i class="bi bi-info-circle me-2 text-success"></i>Connection Status</h5><div id="statusText" class="muted mb-3">No connection test has run.</div><dl class="row small mb-0"><dt class="col-5">Last tested</dt><dd class="col-7" id="lastTest">—</dd><dt class="col-5">HTTP response</dt><dd class="col-7" id="httpStatus">—</dd><dt class="col-5">Credentials</dt><dd class="col-7" id="credentialsState">Not configured</dd></dl><hr><div class="alert alert-warning small mb-0"><strong>Important:</strong> a reachable login page does not prove authentication. This test will never show “Connected” until a supported V-SOL login/API handshake is implemented and verified. Render also cannot directly reach an OLT on your private LAN without a secure network path or local collector.</div></section></div>
</div></main>
<script>
const $=s=>document.querySelector(s);
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(url,options={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(options.headers||{})},...options});let d={};try{d=await r.json()}catch{}if(!r.ok||d.success===false)throw new Error(d.message||('HTTP '+r.status));return d}
function notice(msg,type='info'){const n=$('#notice');n.className='alert alert-'+type;n.textContent=msg}
function showStatus(status,message,httpStatus,lastTest){const el=$('#connectionStatus');el.className='status '+(status||'not_tested');el.textContent=({not_tested:'Not tested',reachable_unverified:'Reachable · Login unverified',unreachable:'Unreachable',connected:'Connected'})[status]||status||'Not tested';$('#statusText').textContent=message||'No connection test has run.';$('#httpStatus').textContent=httpStatus||'—';$('#lastTest').textContent=lastTest?new Date(lastTest).toLocaleString():'—'}
async function loadConfig(){try{const d=await api('/api/olt-management/config');const c=d.config;if(!c){showStatus('not_tested','Configure the OLT management endpoint, then save and test.');return}const f=$('#oltForm');f.elements.name.value=c.name||'Main OLT';f.elements.managementIp.value=c.managementIp||'';f.elements.protocol.value=c.protocol||'http';f.elements.port.value=c.port||80;f.elements.username.value=c.username||'';f.elements.password.value='';$('#credentialsState').textContent=c.hasPassword?'Saved encrypted':'Not configured';showStatus(c.connectionStatus,c.lastError||'Settings loaded. Run a fresh connection test.',c.lastHttpStatus,c.lastTestAt)}catch(e){notice(e.message,'danger')}}
$('#oltForm').addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,b=f.querySelector('button[type=submit]');b.disabled=true;$('#formMessage').textContent='Saving securely…';try{const data=Object.fromEntries(new FormData(f));const d=await api('/api/olt-management/config',{method:'PUT',body:JSON.stringify(data)});notice(d.message,'success');$('#formMessage').textContent='Saved';$('#credentialsState').textContent=d.config?.hasPassword?'Saved encrypted':'Not configured';showStatus('not_tested','Settings saved. Run Test Connection to check reachability.')}catch(err){notice(err.message,'danger');$('#formMessage').textContent='Save failed'}finally{b.disabled=false}});
$('#testBtn').addEventListener('click',async function(){const b=this;b.disabled=true;b.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Testing…';notice('Testing the configured OLT web endpoint…','info');try{const d=await api('/api/olt-management/test-connection',{method:'POST',body:'{}'});showStatus(d.status,d.message,d.httpStatus,d.checkedAt);notice(d.message,d.status==='unreachable'?'warning':'success')}catch(e){notice(e.message,'danger')}finally{b.disabled=false;b.innerHTML='<i class="bi bi-plug me-1"></i>Test Connection'}});
loadConfig();
</script></body></html>
