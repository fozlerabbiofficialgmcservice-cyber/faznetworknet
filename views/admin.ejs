        <div id="dynamicPageContent">
            <!-- Add Customer Card -->
            <div id="section-add-customer" class="card card-custom mb-4">
                <div class="card-custom-header">
                    <i class="bi bi-person-plus-fill text-success fs-5"></i>
                    <span class="fs-5" data-key="add_new_customer">Add New Customer</span>
                </div>
                <div class="card-body p-4">
                    <form id="addCustomerForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="fullName" class="form-label" data-key="label_fullname">Full Name *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" id="fullName" placeholder="e.g. John Doe" data-placeholder-key="ph_fullname" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="phoneNumber" class="form-label" data-key="label_phone">Phone Number *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input type="tel" class="form-control" id="phoneNumber" placeholder="e.g. 01700000000" data-placeholder-key="ph_phone" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="username" class="form-label" data-key="label_username">Username *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-at"></i></span>
                                    <input type="text" class="form-control" id="username" placeholder="pppoe_user" data-placeholder-key="ph_username" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="password" class="form-label" data-key="label_password">Password *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                                    <input type="password" class="form-control" id="password" placeholder="••••••••" data-placeholder-key="ph_password" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="packageSelect" class="form-label" data-key="label_package">Package Selection *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-speedometer"></i></span>
                                    <select class="form-select" id="packageSelect" required>
                                        <option value="Profile-10M">Standard - 10 Mbps</option>
                                        <option value="Profile-20M">Premium - 20 Mbps</option>
                                        <option value="default">Default</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="billingDuration" class="form-label" data-key="label_billing_duration">Billing Duration *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                    <select class="form-select" id="billingDuration" required>
                                        <option value="1_month" selected data-key="opt_1_month">1 Month (30 Days)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 mt-4 pt-2 border-top d-flex justify-content-end gap-2">
                                <button type="reset" class="btn btn-light border px-4" data-key="btn_reset">Reset</button>
                                <button type="submit" class="btn btn-theme px-4" data-key="btn_save_customer">
                                    <i class="bi bi-check2-circle me-1"></i> Save Customer
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Customer List Table (Persistent, no reload wipe) -->
            <div id="section-all-customer" class="card card-custom mb-4">
                <div class="card-custom-header">
                    <i class="bi bi-people text-success fs-5"></i>
                    <span>PPPoE Customer Records</span>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Username</th>
                                <th>Profile</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Expiry</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="pppoeUserList">
                            <tr><td colspan="6" class="text-center py-3 text-muted">Loading customer records...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div id="section-core-monitor" class="card card-custom mb-4">
            <div class="card-custom-header"><i class="bi bi-speedometer2 text-success fs-5"></i><span data-key="monitor">MikroTik Monitor</span><span id="routerLiveStatus" class="badge bg-secondary ms-auto">Offline</span></div>
            <div class="card-body p-4"><div class="row g-3 mb-4"><div class="col-md-4"><div class="p-3 bg-light rounded"><small>CPU</small><div id="liveCpu" class="fs-3 fw-bold">—</div></div></div><div class="col-md-4"><div class="p-3 bg-light rounded"><small>RAM</small><div id="liveRam" class="fs-3 fw-bold">—</div></div></div><div class="col-md-4"><div class="p-3 bg-light rounded"><small>Uptime</small><div id="liveUptime" class="fs-6 fw-bold mt-2">—</div></div></div></div><div class="d-flex justify-content-between align-items-center mb-2"><strong>Live Traffic</strong><select id="monitorInterface" class="form-select form-select-sm" style="max-width:240px"></select></div><div style="height:280px"><canvas id="liveTrafficChart"></canvas></div></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
