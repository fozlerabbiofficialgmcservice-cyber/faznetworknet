<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FAZ NETWORK Enterprise Admin</title><script src="https://cdn.tailwindcss.com"></script><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><link rel="stylesheet" href="/css/admin.css"></head>
<body class="bg-slate-100 text-slate-900"><div class="min-h-screen flex">
<aside class="w-72 bg-slate-950 text-white hidden lg:flex flex-col"><div class="p-6 border-b border-slate-800"><div class="text-2xl font-black">FAZ <span class="text-cyan-400">NETWORK</span></div><div class="text-xs text-slate-500">Enterprise ISP Control Center</div></div><nav id="side" class="flex-1 overflow-y-auto p-4 space-y-1"></nav><div class="p-4 border-t border-slate-800 text-xs text-slate-500">RB4011 • MikroTik Automation</div></aside>
<div class="flex-1 min-w-0"><header class="sticky top-0 z-20 bg-white/95 backdrop-blur border-b p-4 flex justify-between items-center"><div><p class="text-xs uppercase tracking-widest text-slate-400">Control Center</p><h1 id="page-title" class="text-xl font-black">Dashboard</h1></div><div class="flex gap-2"><button id="lang" class="px-3 py-2 rounded-xl border font-bold">বাংলা</button><span id="router-badge" class="px-3 py-2 rounded-xl bg-red-50 text-red-700 text-xs font-bold">Router offline</span></div></header>
<main class="p-4 lg:p-7"><section id="dashboard-view" class="space-y-6"><div class="grid grid-cols-2 xl:grid-cols-4 gap-4"><div class="card"><span data-i18n="collection">Today Collection</span><b id="collection">৳0</b></div><div class="card"><span>CPU</span><b id="cpu">—</b></div><div class="card"><span>RAM</span><b id="ram">—</b></div><div class="card"><span>PPPoE Online</span><b id="online">—</b></div></div>
<div class="card"><div class="flex justify-between"><div><h2 class="font-black text-lg">Live Traffic</h2><p class="text-sm text-slate-400">RB4011 interface TX/RX</p></div><select id="iface" class="rounded-xl border px-3 py-2"></select></div><canvas id="traffic" class="mt-4 h-72"></canvas></div>
<div class="card"><div class="flex justify-between items-center"><h2 class="font-black">Recent Payments</h2><a href="/transactions" class="text-cyan-700 font-bold text-sm">All Payments →</a></div><div id="payments" class="mt-3 space-y-2"></div></div></section>
<section id="module-view" class="hidden space-y-6"></section></main></div></div>
<script src="/js/admin.js"></script></body></html>