        async function submitManualMatch() {
            const trxId = document.getElementById('manualMatchTrx')?.value.trim();
            const username = document.getElementById('manualMatchUsername')?.value.trim();
            if (!trxId || !username) return alert('Transaction ID and username are required.');
            try {
                await jsonFetch('/api/payments/manual-match', {
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({trxId, username})
