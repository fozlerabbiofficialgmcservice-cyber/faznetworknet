                'payments':'Payments','pending_invoice':'Pending Invoice','all_payments':'All Payments','payment_request':'Payment Request','bkash_payments':'bKash Payments','nagad_payments':'Nagad Payments','rocket_payments':'Rocket Payments',
                'hotspot':'Hotspot','hotspot_dashboard':'Dashboard','hotspot_all_users':'All Users','hotspot_active_users':'Active Users','hotspot_online_users':'Online Users','hotspot_profile':'Profile','hotspot_server_profile':'Server Profile',
                'core_system':'Core System','pppoe':'PPPoE','devices':'Devices','plan_packages':'Plan & Packages','ip_pools':'IP Pools','olt_management':'OLT Management','monitor':'Monitor','usage':'Usage','online':'Online','network_diagram':'Network Diagram',
                'general_setting':'General Setting','website_setting':'Website Setting','sms_setting':'SMS Setting','backup_restore':'Backup & Restore',
                'vpn_server':'VPN Server','vpn':'VPN','vpn_port_forwarding':'VPN Port Forwarding',
                'account_support':'Account & Support','account_dashboard':'Dashboard','manage':'Manage','support':'Support','support_tickets':'Support Tickets','software_support_tickets':'Software Support Tickets','website_support_tickets':'Website Support Tickets',
                'expenses':'Expenses','add_expenses':'Add Expenses','all_expenses':'All Expenses','expenses_report':'Expenses Report',
                'human_resource':'Human Resource','department':'Department','all_employees':'All Employees','added_employees':'Added Employees',
                'live_tracking':'Live Tracking','google_map':'Google Map','user_reseller':'User & Reseller','sub_staff':'Sub-Staff',
                'customer_management':'Customer Management','add_new_customer':'Add New Customer','label_fullname':'Full Name *','label_phone':'Phone Number *','label_username':'Username *','label_password':'Password *','label_package':'Package Selection *','label_billing_duration':'Billing Duration *','opt_1_month':'1 Month (30 Days)','btn_reset':'Reset','btn_save_customer':'Save Customer',
                'ph_fullname':'e.g. John Doe','ph_phone':'e.g. 01700000000','ph_username':'pppoe_user','ph_password':'••••••••'
            },
            'bn': {
                'brand':'FAZ NETWORK','dashboard':'ড্যাশবোর্ড','customer':'কাস্টমার','all_customer':'অল কাস্টমার','add_customer':'অ্যাড কাস্টমার',
                'online_customer':'অনলাইন কাস্টমার','offline_customer':'অফলাইন কাস্টমার','active_customer':'অ্যাক্টিভ কাস্টমার','left_customer':'লেফট কাস্টমার',
                'expire_customer':'এক্সপায়ার কাস্টমার','expire_today_yesterday':'আজ ও গতকাল এক্সপায়ার','expire_7_days':'৭ দিনে এক্সপায়ার','new_customer':'নতুন কাস্টমার','due_collection':'বকেয়া কালেকশন',
                'report':'রিপোর্ট','monthly_collection_due':'মাসিক কালেকশন ও বকেয়া','monthly_sales':'মাসিক বিক্রয়','invoice_report':'ইনভয়েস রিপোর্ট',
                'payments':'পেমেন্টস','pending_invoice':'পেন্ডিং ইনভয়েস','all_payments':'অল পেমেন্টস','payment_request':'পেমেন্ট রিকোয়েস্ট','bkash_payments':'বিকাশ পেমেন্টস','nagad_payments':'নগদ পেমেন্টস','rocket_payments':'রকেট পেমেন্টস',
                'hotspot':'হটস্পট','hotspot_dashboard':'ড্যাশবোর্ড','hotspot_all_users':'অল ইউজার','hotspot_active_users':'অ্যাক্টিভ ইউজার','hotspot_online_users':'অনলাইন ইউজার','hotspot_profile':'প্রোফাইল','hotspot_server_profile':'সার্ভার প্রোফাইল',
                'core_system':'কোর সিস্টেম','pppoe':'PPPoE','devices':'ডিভাইস','plan_packages':'প্ল্যান ও প্যাকেজ','ip_pools':'IP পুলস','olt_management':'OLT ম্যানেজমেন্ট','monitor':'মনিটর','usage':'ইউসেজ','online':'অনলাইন','network_diagram':'নেটওয়ার্ক ডায়াগ্রাম',
                'general_setting':'জেনারেল সেটিং','website_setting':'ওয়েবসাইট সেটিং','sms_setting':'SMS সেটিং','backup_restore':'ব্যাকআপ ও রিস্টোর',
                'vpn_server':'VPN সার্ভার','vpn':'VPN','vpn_port_forwarding':'VPN পোর্ট ফরওয়ার্ডিং',
                'account_support':'অ্যাকাউন্ট ও সাপোর্ট','account_dashboard':'ড্যাশবোর্ড','manage':'ম্যানেজ','support':'সাপোর্ট','support_tickets':'সাপোর্ট টিকেট','software_support_tickets':'সফটওয়্যার সাপোর্ট টিকেট','website_support_tickets':'ওয়েবসাইট সাপোর্ট টিকেট',
                'expenses':'খরচ','add_expenses':'খরচ যোগ করুন','all_expenses':'সব খরচ','expenses_report':'খরচের রিপোর্ট',
                'human_resource':'হিউম্যান রিসোর্স','department':'ডিপার্টমেন্ট','all_employees':'সব কর্মচারী','added_employees':'যুক্ত কর্মচারী',
                'live_tracking':'লাইভ ট্র্যাকিং','google_map':'গুগল ম্যাপ','user_reseller':'ইউজার ও রিসেলার','sub_staff':'সাব-স্টাফ',
                'customer_management':'কাস্টমার ম্যানেজমেন্ট','add_new_customer':'নতুন কাস্টমার যুক্ত করুন','label_fullname':'পূর্ণ নাম *','label_phone':'ফোন নম্বর *','label_username':'ইউজারনেম *','label_password':'পাসওয়ার্ড *','label_package':'প্যাকেজ নির্বাচন *','label_billing_duration':'বিলিং মেয়াদ *','opt_1_month':'১ মাস (৩০ দিন)','btn_reset':'রিসেট','btn_save_customer':'সংরক্ষণ করুন',
                'ph_fullname':'যেমন: জন ডো','ph_phone':'যেমন: ০১৭০০০০০০০০','ph_username':'pppoe_user','ph_password':'••••••••'
            }
        };

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
        }

        function toggleSubmenu(event, button) {
            event.stopPropagation();
            const submenu = button.nextElementSibling;
            if (submenu) submenu.classList.toggle('show');
            const arrow = button.querySelector('.arrow-icon');
            if (arrow) arrow.classList.toggle('bi-chevron-up');
        }

        const viewTitles = {
            dashboard: 'Dashboard',
            'add-customer': 'Add New Customer',
            'all-customer': 'All Customer (PPPoE)',
            payments: 'All Payments'
        };

        let currentPaymentChannel = '';
        let trafficChart = null;
        let trafficTimer = null;
        let metricsTimer = null;

        function switchView(viewName, channel = '') {
            const target = document.getElementById('view-' + viewName) ? viewName : 'dashboard';
            document.querySelectorAll('.admin-view').forEach(view => view.style.display = 'none');
            document.getElementById('view-' + target).style.display = 'block';

            document.getElementById('pageTitle').innerText = viewTitles[target] || 'Dashboard';
            currentPaymentChannel = channel || '';
            if (target === 'dashboard') {
                refreshDashboard();
                startTrafficPolling();
            } else if (target === 'all-customer') {
                fetchCustomers();
            } else if (target === 'payments') {
                fetchPayments(currentPaymentChannel);
            }
            if (window.innerWidth <= 768) document.getElementById('sidebar').classList.remove('show');
        }

        function updateLanguage(lang) {
            document.documentElement.lang = lang;
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (translations[lang] && translations[lang][key]) el.innerText = translations[lang][key];
            });
            document.querySelectorAll('[data-placeholder-key]').forEach(el => {
                const key = el.getAttribute('data-placeholder-key');
                if (translations[lang] && translations[lang][key]) el.placeholder = translations[lang][key];
            });
            localStorage.setItem('faz_preferred_lang', lang);
        }

        const langSelect = document.getElementById('langSelect');
        const savedLang = localStorage.getItem('faz_preferred_lang') || 'en';
        langSelect.value = savedLang;
        langSelect.addEventListener('change', function() { updateLanguage(this.value); });
        updateLanguage(savedLang);

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]));
        }

        async function jsonFetch(url, options = {}) {
            const response = await fetch(url, options);
            const data = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(data.error || 'Request failed');
            return data;
        }

        async function fetchCustomers() {
            const tbody = document.getElementById('pppoeUserList');
            if (!tbody) return;
            try {
                const data = await jsonFetch('/api/pppoe/users');
                const users = data.users || [];
                tbody.innerHTML = users.length ? users.map(u => {
                    const disabled = Boolean(u.disabled);
                    return '<tr>' +
                        '<td><strong>' + escapeHtml(u.username) + '</strong></td>' +
                        '<td><span class="badge bg-info text-dark">' + escapeHtml(u.profile || u.profile_name || 'N/A') + '</span></td>' +
                        '<td>' + escapeHtml(u.phone || '-') + '</td>' +
                        '<td><span class="badge ' + (disabled ? 'bg-danger' : 'bg-success') + '">' + (disabled ? 'Disabled' : 'Active') + '</span></td>' +
                        '<td>' + escapeHtml(u.expiry_date ? new Date(u.expiry_date).toLocaleString() : 'Active') + '</td>' +
                        '<td><button class="btn btn-sm btn-outline-danger" onclick="kickUser(\'' + escapeHtml(u.username).replace(/'/g, "\\'") + '\')">Kick</button></td>' +
                    '</tr>';
                }).join('') : '<tr><td colspan="6" class="text-center py-3">No customers found. Click Sync MikroTik.</td></tr>';
            } catch (error) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-danger">' + escapeHtml(error.message) + '</td></tr>';
            }
        }

        async function kickUser(username) {
            if (!confirm('Kick user ' + username + '?')) return;
            try {
                await jsonFetch('/api/pppoe/kick-user', {
                    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({username})
                });
                fetchCustomers();
            } catch (error) { alert(error.message); }
        }

        async function syncMikrotik(btn) {
            btn.disabled = true;
            const old = btn.innerHTML;
            btn.innerHTML = 'Syncing...';
            try {
                await jsonFetch('/api/pppoe/sync', {method:'POST'});
                await fetchCustomers();
                await refreshDashboard();
            } catch (error) { alert(error.message); }
            finally { btn.disabled = false; btn.innerHTML = old; }
        }

        document.getElementById('addCustomerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const button = this.querySelector('button[type="submit"]');
            button.disabled = true;
            try {
                const payload = {
                    username: document.getElementById('username').value.trim(),
                    password: document.getElementById('password').value.trim(),
                    phone: document.getElementById('phoneNumber').value.trim(),
                    profile: document.getElementById('packageSelect').value
                };
                await jsonFetch('/api/pppoe/users/create', {
                    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)
                });
                alert('Customer created and synced with MikroTik!');
                this.reset();
                switchView('all-customer');
            } catch (error) { alert(error.message); }
            finally { button.disabled = false; }
        });

        async function fetchPayments(channel = '') {
            const body = document.getElementById('paymentsBody');
            if (!body) return;
            try {
                const url = channel ? '/api/payments/transactions?channel=' + encodeURIComponent(channel) : '/api/payments/transactions';
                const data = await jsonFetch(url);
                const rows = (data.transactions || []).slice(0, 500);
                document.getElementById('paymentFilterLabel').innerText = channel ? channel.toUpperCase() : 'All Gateways';
                body.innerHTML = rows.length ? rows.map(t =>
                    '<tr><td><strong>' + escapeHtml(t.trx_id) + '</strong></td>' +
                    '<td>' + escapeHtml(t.channel || '-') + '</td>' +
                    '<td>৳' + Number(t.amount || 0).toFixed(2) + '</td>' +
                    '<td>' + escapeHtml(t.sender_phone || '-') + '</td>' +
                    '<td><span class="badge ' + (t.status === 'processed' ? 'bg-success' : 'bg-warning text-dark') + '">' + escapeHtml(t.status || 'unknown') + '</span></td>' +
                    '<td>' + escapeHtml(t.created_at ? new Date(t.created_at).toLocaleString() : '-') + '</td></tr>'
                ).join('') : '<tr><td colspan="6" class="text-center py-3 text-muted">No payment records found.</td></tr>';
            } catch (error) {
                body.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-danger">' + escapeHtml(error.message) + '</td></tr>';
            }
        }

        async function refreshDashboard() {
            try {
                const [users, active, summary] = await Promise.all([
                    jsonFetch('/api/pppoe/users'),
                    jsonFetch('/api/pppoe/active'),
                    jsonFetch('/api/payments/summary')
                ]);
                document.getElementById('metricCustomers').innerText = (users.users || []).length;
                document.getElementById('metricSessions').innerText = (active.sessions || active.active || []).length;
                document.getElementById('metricCollection').innerText = '৳' + Number(summary.summary?.today_collection || 0).toFixed(2);
                const recent = summary.recent || [];
                document.getElementById('recentPaymentsBody').innerHTML = recent.slice(0,5).map(t =>
                    '<tr><td>' + escapeHtml(t.trx_id) + '</td><td>' + escapeHtml(t.channel) + '</td><td>৳' + Number(t.amount || 0).toFixed(2) + '</td><td><span class="badge ' + (t.status === 'processed' ? 'bg-success' : 'bg-warning text-dark') + '">' + escapeHtml(t.status) + '</span></td><td>' + escapeHtml(new Date(t.created_at).toLocaleString()) + '</td></tr>'
                ).join('') || '<tr><td colspan="5" class="text-center py-3 text-muted">No recent payments.</td></tr>';
            } catch (error) {
                console.error('[Dashboard]', error);
            }
            await loadRouterMetrics();
        }

        async function loadRouterMetrics() {
            try {
                const data = await jsonFetch('/api/router/resources');
                const r = data.resources || {};
                const cpu = Number(r.cpuLoad || 0);
                const ram = Number(r.memoryUsagePercent || 0);
                document.getElementById('metricCpu').innerText = cpu + '%';
                document.getElementById('metricRam').innerText = ram + '%';
                document.getElementById('cpuBar').style.width = Math.min(cpu,100) + '%';
                document.getElementById('ramBar').style.width = Math.min(ram,100) + '%';
                const status = document.getElementById('dashboardRouterStatus');
                status.className = 'badge bg-success ms-auto';
                status.innerText = 'Online';
            } catch (error) {
                document.getElementById('metricCpu').innerText = '—';
                document.getElementById('metricRam').innerText = '—';
                const status = document.getElementById('dashboardRouterStatus');
                status.className = 'badge bg-danger ms-auto';
                status.innerText = 'Offline';
            }
        }

        async function loadInterfaces() {
            try {
                const data = await jsonFetch('/api/router/interfaces');
                const interfaces = data.interfaces || [];
                const select = document.getElementById('dashboardInterface');
                const current = select.value;
                if (!select.options.length) select.innerHTML = interfaces.map(i => '<option value="' + escapeHtml(i.name) + '">' + escapeHtml(i.name) + '</option>').join('');
                if (current) select.value = current;
                if (select.value) startTrafficPolling();
            } catch (error) {
                console.error('[Traffic]', error);
            }
        }

        async function pollTraffic() {
            const select = document.getElementById('dashboardInterface');
            if (!select || !select.value) return;
            try {
                const data = await jsonFetch('/api/router/traffic?interface=' + encodeURIComponent(select.value));
                const t = data.traffic || data;
                if (!trafficChart) {
                    trafficChart = new Chart(document.getElementById('dashboardTrafficChart'), {
                        type:'line',
                        data:{labels:[],datasets:[
                            {label:'RX Mbps',data:[],tension:.3},
                            {label:'TX Mbps',data:[],tension:.3}
                        ]},
                        options:{responsive:true,maintainAspectRatio:false,animation:false}
                    });
                }
                trafficChart.data.labels.push(new Date().toLocaleTimeString());
                trafficChart.data.datasets[0].data.push(Number(t.rxMbps || 0));
                trafficChart.data.datasets[1].data.push(Number(t.txMbps || 0));
                if (trafficChart.data.labels.length > 30) {
                    trafficChart.data.labels.shift();
                    trafficChart.data.datasets.forEach(d => d.data.shift());
                }
                trafficChart.update('none');
            } catch (error) { console.error('[Traffic]', error); }
        }

        function startTrafficPolling() {
            if (trafficTimer) clearInterval(trafficTimer);
            loadInterfaces();
            pollTraffic();
            trafficTimer = setInterval(pollTraffic, 2500);
        }

        document.getElementById('dashboardInterface').addEventListener('change', function() {
            if (trafficChart) {
                trafficChart.data.labels = [];
                trafficChart.data.datasets.forEach(d => d.data = []);
                trafficChart.update('none');
            }
            pollTraffic();
        });

        // Background live metrics: 5-second refresh regardless of current view.
        metricsTimer = setInterval(() => {
            loadRouterMetrics();
            if (document.getElementById('view-dashboard').style.display !== 'none') refreshDashboard();
        }, 5000);

        // Dashboard is the initial operational view.
        switchView('dashboard');
        startTrafficPolling();
    </script>
</body>
</html>