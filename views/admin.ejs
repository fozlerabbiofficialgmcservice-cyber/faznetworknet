                    <div class="card-custom-header"><i class="bi bi-receipt text-success fs-5"></i><span>Recent Payments</span></div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-hover mb-0"><thead class="table-light"><tr><th>TrxID</th><th>Gateway</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
                        <tbody id="recentPaymentsBody"><tr><td colspan="5" class="text-center py-3 text-muted">Loading payments...</td></tr></tbody></table>
                    </div>
                </div>
            </section>

            <!-- VIEW 2: ADD CUSTOMER -->
            <section id="view-add-customer" class="admin-view" style="display:none">
                <div class="card card-custom mb-4">
                    <div class="card-custom-header"><i class="bi bi-person-plus-fill text-success fs-5"></i><span class="fs-5" data-key="add_new_customer">Add New Customer</span></div>
                    <div class="card-body p-4">
                        <form id="addCustomerForm">
