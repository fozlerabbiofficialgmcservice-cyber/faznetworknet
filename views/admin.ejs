                '<td>' + index + '</td>' +
                '<td><strong>' + escapeHtml(tx.trx_id || '-') + '</strong></td>' +
                '<td><span class="badge payment-gateway-badge ' + paymentGatewayClass(gateway) + '">' + escapeHtml(gatewayLabel) + '</span></td>' +
