.brand{padding:24px 20px 18px;border-bottom:1px solid rgba(167,243,208,.14)}
.brand-name{font-size:25px;font-weight:900;letter-spacing:.02em}.brand-sub{font-size:11px;color:#86efac;margin-top:4px}
.lang-wrap{padding:14px 16px;border-bottom:1px solid rgba(167,243,208,.12)}
