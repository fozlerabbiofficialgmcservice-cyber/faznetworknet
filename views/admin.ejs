    <div class="main-content" id="mainContent">
        <nav class="navbar navbar-expand-lg navbar-light bg-white rounded shadow-sm mb-4 p-2">
            <div class="container-fluid">
                <button class="btn btn-outline-success d-md-none" onclick="toggleSidebar()">
                    <i class="bi bi-list"></i>
                </button>
                <span class="fs-5 fw-semibold text-secondary d-none d-md-block" id="pageTitle" data-key="customer_management">Customer Management</span>
                <div class="ms-auto d-flex gap-2">
                    <button class="btn btn-outline-success" onclick="syncMikrotik(this)">
                        <i class="bi bi-arrow-repeat"></i> 🔄 Sync MikroTik
                    </button>
                </div>
            </div>
        </nav>
        
        <div id="dynamicPageContent">
            <!-- VIEW 1: DASHBOARD -->
            <section id="view-dashboard" class="admin-view">
                <div class="row g-3 mb-4">
                    <div class="col-md-6 col-xl-3"><div class="card card-custom h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><div class="text-muted small">Total PPPoE Customers</div><div id="metricCustomers" class="fs-3 fw-bold mt-1">—</div></div><i class="bi bi-people fs-3 text-success"></i></div></div></div></div>
                    <div class="col-md-6 col-xl-3"><div class="card card-custom h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><div class="text-muted small">Online / Active Sessions</div><div id="metricSessions" class="fs-3 fw-bold mt-1">—</div></div><i class="bi bi-wifi fs-3 text-success"></i></div></div></div></div>
                    <div class="col-md-6 col-xl-3"><div class="card card-custom h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><div class="text-muted small">Today's Collection</div><div id="metricCollection" class="fs-3 fw-bold mt-1">৳0.00</div></div><i class="bi bi-cash-stack fs-3 text-success"></i></div></div></div></div>
                    <div class="col-md-6 col-xl-3"><div class="card card-custom h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div class="w-100"><div class="text-muted small">MikroTik CPU & RAM Usage</div><div class="d-flex justify-content-between small mt-2"><span>CPU</span><strong id="metricCpu">—</strong></div><div class="progress" style="height:6px"><div id="cpuBar" class="progress-bar bg-success" style="width:0%"></div></div><div class="d-flex justify-content-between small mt-2"><span>RAM</span><strong id="metricRam">—</strong></div><div class="progress" style="height:6px"><div id="ramBar" class="progress-bar bg-success" style="width:0%"></div></div></div><i class="bi bi-cpu fs-3 text-success ms-2"></i></div></div></div></div>
                </div>

                <div class="card card-custom mb-4">
                    <div class="card-custom-header"><i class="bi bi-activity text-success fs-5"></i><span>Live Traffic Monitor</span><span id="dashboardRouterStatus" class="badge bg-secondary ms-auto">Checking...</span></div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2"><span class="text-muted small">Interface RX/TX bandwidth</span><select id="dashboardInterface" class="form-select form-select-sm" style="max-width:240px"></select></div>
                        <div style="height:300px"><canvas id="dashboardTrafficChart"></canvas></div>
                    </div>
                </div>

                <div class="card card-custom">
                    <div class="card-custom-header"><i class="bi bi-receipt text-success fs-5"></i><span>Recent Payments</span></div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-hover mb-0"><thead class="table-light"><tr><th>TrxID</th><th>Gateway</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
                        <tbody id="recentPaymentsBody"><tr><td colspan="5" class="text-center py-3 text-muted">Loading payments...</td></tr></tbody></table>
                    </div>
                </div>
            </section>

            <!-- VIEW 2: ADD CUSTOMER -->
            <section id="view-add-customer" class="admin-view" style="display:none">
                <div class="card card-custom mb-4">
                    <div class="card-custom-header"><i class="bi bi-person-plus-fill text-success fs-5"></i><span class="fs-5" data-key="add_new_customer">Add New Customer</span></div>
                    <div class="card-body p-4">
                        <form id="addCustomerForm">
                            <div class="row g-3">
                                <div class="col-md-6"><label for="fullName" class="form-label" data-key="label_fullname">Full Name *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-person"></i></span><input type="text" class="form-control" id="fullName" placeholder="e.g. John Doe" data-placeholder-key="ph_fullname" required></div></div>
                                <div class="col-md-6"><label for="phoneNumber" class="form-label" data-key="label_phone">Phone Number *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span><input type="tel" class="form-control" id="phoneNumber" placeholder="e.g. 01700000000" data-placeholder-key="ph_phone" required></div></div>
                                <div class="col-md-6"><label for="username" class="form-label" data-key="label_username">Username *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-at"></i></span><input type="text" class="form-control" id="username" placeholder="pppoe_user" data-placeholder-key="ph_username" required></div></div>
                                <div class="col-md-6"><label for="password" class="form-label" data-key="label_password">Password *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-key"></i></span><input type="password" class="form-control" id="password" placeholder="••••••••" data-placeholder-key="ph_password" required></div></div>
                                <div class="col-md-6"><label for="packageSelect" class="form-label" data-key="label_package">Package Selection *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-speedometer"></i></span><select class="form-select" id="packageSelect" required><option value="Profile-10M">Standard - 10 Mbps</option><option value="Profile-20M">Premium - 20 Mbps</option><option value="default">Default</option></select></div></div>
                                <div class="col-md-6"><label for="billingDuration" class="form-label" data-key="label_billing_duration">Billing Duration *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span><select class="form-select" id="billingDuration" required><option value="1_month" selected data-key="opt_1_month">1 Month (30 Days)</option></select></div></div>
                                <div class="col-12 mt-4 pt-2 border-top d-flex justify-content-end gap-2"><button type="reset" class="btn btn-light border px-4" data-key="btn_reset">Reset</button><button type="submit" class="btn btn-theme px-4" data-key="btn_save_customer"><i class="bi bi-check2-circle me-1"></i> Save Customer</button></div>
                            </div>
                        </form>
                    </div>
                </div>
            </section>

            <!-- VIEW 3: ALL CUSTOMER -->
            <section id="view-all-customer" class="admin-view" style="display:none">
                <div class="card card-custom">
                    <div class="card-custom-header"><i class="bi bi-people text-success fs-5"></i><span>PPPoE Customer Records</span><button id="customerSyncBtn" class="btn btn-outline-success btn-sm ms-auto" onclick="syncMikrotik(this)"><i class="bi bi-arrow-repeat"></i> 🔄 Sync MikroTik</button></div>
                    <div class="card-body p-0 table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Username</th><th>Profile</th><th>Phone</th><th>Status</th><th>Expiry Date</th><th>Action</th></tr></thead><tbody id="pppoeUserList"><tr><td colspan="6" class="text-center py-3 text-muted">Loading customer records...</td></tr></tbody></table></div>
                </div>
            </section>

            <!-- VIEW 4: PAYMENTS -->
            <section id="view-payments" class="admin-view" style="display:none">
                <div class="card card-custom">
                    <div class="card-custom-header"><i class="bi bi-credit-card text-success fs-5"></i><span>All Payments</span><span id="paymentFilterLabel" class="badge bg-light text-dark ms-2">All Gateways</span></div>
                    <div class="card-body p-0 table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>TrxID</th><th>Gateway</th><th>Amount</th><th>Sender Phone</th><th>Status</th><th>Date</th></tr></thead><tbody id="paymentsBody"><tr><td colspan="6" class="text-center py-3 text-muted">Loading payments...</td></tr></tbody></table></div>
                </div>
            </section>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        const translations = {
            'en': {
                'brand':'FAZ NETWORK','dashboard':'Dashboard','customer':'Customer','all_customer':'All Customer','add_customer':'Add Customer',
