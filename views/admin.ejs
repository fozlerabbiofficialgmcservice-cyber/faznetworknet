const api=(url,options={})=>fetch(url,Object.assign({cache:"no-store",headers:{"Content-Type":"application/json"}},options)).then(async r=>{const d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw new Error(d.error||"Request failed");return d});

function toggleSubmenu(id,button){const el=document.getElementById(id);if(!el)return;const open=el.classList.toggle("show");button.classList.toggle("open",open)}
function toggleSidebar(force){const sb=document.getElementById("sidebar"),ov=document.getElementById("sidebarOverlay");const show=typeof force==="boolean"?force:!sb.classList.contains("show");sb.classList.toggle("show",show);ov.classList.toggle("show",show)}
function updateLanguage(language){
 currentLanguage=language==="bn"?"bn":"en";document.getElementById("languageSwitcher").value=currentLanguage;
 document.querySelectorAll("[data-i18n]").forEach(el=>{const key=el.getAttribute("data-i18n");if(translations[currentLanguage][key])el.textContent=translations[currentLanguage][key]});
 if(document.getElementById("pageTitle").dataset.key)document.getElementById("pageTitle").textContent=t(document.getElementById("pageTitle").dataset.key);
 loadDashboard(); 
}
function setTitle(label,key){const el=document.getElementById("pageTitle");el.dataset.key=key||"";el.textContent=key?t(key):label}
function loadContentPage(page){
 toggleSidebar(false);
 const dash=document.getElementById("dashboard"),content=document.getElementById("contentPage"),box=document.getElementById("pageContent");dash.classList.remove("active");content.classList.add("active");
 const titles={customers:["allCustomer","All Customer"],addCustomer:["addNewCustomer","Add New Customer"],online:["onlineCustomer","Online Customer"],offline:["offlineCustomer","Offline Customer"],active:["activeCustomer","Active Customer"],expired:["expireCustomer","Expire Customer"],expireNear:["expireTodayYesterday","Expire Today & Yesterday"],expire7:["expire7Days","Expire in 7 Days"],newCustomer:["newCustomer","New Customer"],due:["dueCollection","Due Collection"],payments:["allPayments","All Payments"],bkash:["bkashPayments","bKash Payments"],nagad:["nagadPayments","Nagad Payments"],rocket:["rocketPayments","Rocket Payments"],pppoe:["pppoe","PPPoE"],monitor:["monitor","Monitor"],devices:["devices","Devices"],hotspot:["hotspotDashboard","Dashboard"],hotspotUsers:["allUsers","All Users"],hotspotActive:["activeUsers","Active Users"],hotspotOnline:["onlineUsers","Online Users"],hotspotProfiles:["profiles","Profiles"],hotspotServer:["serverProfiles","Server Profiles"],reports:["monthlyCollectionDue","Monthly Collection & Due"],sales:["monthlySales","Monthly Sales"],invoice:["invoiceReport","Invoice Report"],pending:["pendingInvoice","Pending Invoice"],requests:["paymentRequest","Payment Request"],settings:["generalSetting","General Setting"],vpn:["vpnServer","VPN Server"],support:["accountSupport","Account & Support"],expenses:["expenses","Expenses"],hr:["hr","HR"],tracking:["liveTracking","Live Tracking"],reseller:["userReseller","User & Reseller"],plans:["plans","Plan & Packages"],pools:["ipPools","IP Pools"],olt:["oltManagement","OLT Management"],diagram:["networkDiagram","Network Diagram"]};
 const meta=titles[page]||["module","Module"];setTitle(meta[1],meta[0]);
 if(page==="addCustomer"||page==="pppoe"){renderCustomerPage();return}
 if(["payments","bkash","nagad","rocket"].includes(page)){renderPayments(page==="payments"?"":page);return}
 if(page==="monitor"||page==="devices"){renderMonitor();return}
 if(page==="hotspot"||page==="hotspotUsers"||page==="hotspotActive"||page==="hotspotOnline"||page==="hotspotProfiles"||page==="hotspotServer"){box.innerHTML='<div class="card-clean section-card"><div class="section-title">'+esc(t("hotspotDashboard"))+'</div><div class="section-subtitle mt-1">Hotspot API module</div><div class="mt-4"><a class="btn btn-green" href="/hotspot">Open Hotspot Engine</a></div></div>';return}
 box.innerHTML='<div class="card-clean section-card"><div class="section-title">'+esc(t(meta[0]))+'</div><div class="section-subtitle mt-2">'+esc(t("moduleShell"))+'</div><div class="d-flex flex-wrap gap-2 mt-4"><a class="btn btn-green" href="/pppoe">'+esc(t("openPppoe"))+'</a><a class="btn btn-green" href="/hotspot">'+esc(t("openHotspot"))+'</a><a class="btn btn-green" href="/transactions">'+esc(t("openPayments"))+'</a></div></div>';
}
function renderCustomerPage(){
 const box=document.getElementById("pageContent");
 box.innerHTML='<div class="card-clean section-card mb-4"><div class="section-title">'+esc(t("addNewCustomer"))+'</div><div class="section-subtitle mb-4">PPPoE / MikroTik customer provisioning</div><form id="customerForm" class="row g-3"><div class="col-md-6"><label class="form-label fw-bold">'+esc(t("username"))+'</label><input name="username" class="form-control" required></div><div class="col-md-6"><label class="form-label fw-bold">'+esc(t("password"))+'</label><input name="password" class="form-control" required></div><div class="col-md-6"><label class="form-label fw-bold">'+esc(t("profile"))+'</label><select id="customerProfile" name="profile" class="form-select" required></select></div><div class="col-md-6"><label class="form-label fw-bold">'+esc(t("callerId"))+'</label><input name="callerId" class="form-control"></div><div class="col-12"><label class="form-label fw-bold">'+esc(t("phoneComment"))+'</label><input name="comment" class="form-control"></div><div class="col-12 d-flex align-items-center gap-3"><button class="btn btn-green" type="submit"><i class="bi bi-person-plus me-1"></i>'+esc(t("createCustomer"))+'</button><span id="customerResult" class="small"></span></div></form></div><div class="card-clean section-card"><div class="section-title mb-3">'+esc(t("pppoeUsers"))+'</div><div id="userTable" class="table-wrap"></div></div>';
 api("/api/pppoe/profiles").then(d=>{document.getElementById("customerProfile").innerHTML=(d.profiles||[]).map(x=>'<option value="'+esc(x.name)+'">'+esc(x.name)+'</option>').join("")}).catch(()=>{});
 loadUsers();
 document.getElementById("customerForm").onsubmit=async e=>{e.preventDefault();const result=document.getElementById("customerResult");result.textContent="";try{await api("/api/pppoe/users/create",{method:"POST",body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});result.className="small text-success fw-bold";result.textContent=t("customerCreated");e.target.reset();await loadUsers()}catch(err){result.className="small text-danger fw-bold";result.textContent=err.message||t("customerError")}};
}
async function loadUsers(){const box=document.getElementById("userTable");if(!box)return;try{const d=await api("/api/pppoe/users");const rows=d.users||[];box.innerHTML=rows.length?'<table class="table align-middle"><thead><tr><th>'+t("username")+'</th><th>'+t("profile")+'</th><th>'+t("status")+'</th><th>'+t("action")+'</th></tr></thead><tbody>'+rows.map(x=>'<tr><td class="fw-bold">'+esc(x.username)+'</td><td>'+esc(x.profile||"—")+'</td><td><span class="badge badge-soft rounded-pill">'+esc(x.disabled?t("disabled"):t("active"))+'</span></td><td><button class="btn btn-sm btn-outline-dark me-1" data-kick="'+esc(x.username)+'">'+t("kick")+'</button><button class="btn btn-sm btn-green" data-toggle="'+esc(x.username)+'" data-disabled="'+(!x.disabled)+'">'+(x.disabled?t("enable"):t("disable"))+'</button></td></tr>').join("")+'</tbody></table>':'<div class="empty">'+t("noUsers")+'</div>';box.querySelectorAll("[data-kick]").forEach(b=>b.onclick=async()=>{await api("/api/pppoe/kick-user",{method:"POST",body:JSON.stringify({username:b.dataset.kick})});loadUsers()});box.querySelectorAll("[data-toggle]").forEach(b=>b.onclick=async()=>{await api("/api/pppoe/toggle-user",{method:"POST",body:JSON.stringify({username:b.dataset.toggle,disabled:b.dataset.disabled==="true"})});loadUsers()})}catch(e){box.innerHTML='<div class="empty text-danger">'+esc(e.message)+'</div>}}
async function renderPayments(filter){const box=document.getElementById("pageContent");box.innerHTML='<div class="card-clean section-card"><div class="section-title mb-3">'+esc(t("paymentTransactions"))+'</div><div id="txTable" class="table-wrap"></div></div>';try{const d=await api("/api/payments/transactions"+(filter?"?channel="+encodeURIComponent(filter):""));const rows=d.transactions||[];document.getElementById("txTable").innerHTML=rows.length?'<table class="table"><thead><tr><th>'+t("channel")+'</th><th>'+t("trxId")+'</th><th>'+t("sender")+'</th><th>'+t("amount")+'</th><th>'+t("status")+'</th><th>'+t("used")+'</th></tr></thead><tbody>'+rows.map(x=>'<tr><td>'+esc(x.channel)+'</td><td class="fw-bold">'+esc(x.trx_id)+'</td><td>'+esc(x.sender_phone||"—")+'</td><td>৳'+Number(x.amount).toFixed(2)+'</td><td>'+esc(x.status)+'</td><td>'+(x.used?t("yes"):t("no"))+'</td></tr>').join("")+'</tbody></table>':'<div class="empty">'+t("noPayments")+'</div>'}catch(e){document.getElementById("txTable").innerHTML='<div class="empty text-danger">'+esc(e.message)+'</div>'}}
async function renderMonitor(){const box=document.getElementById("pageContent");box.innerHTML='<div class="card-clean section-card"><div class="section-title">'+esc(t("mikrotikMonitor"))+'</div><div class="row g-3 mt-1"><div class="col-md-4"><div class="p-3 rounded-3 bg-light"><small>CPU</small><div id="mc" class="fs-3 fw-black fw-bold">—</div></div></div><div class="col-md-4"><div class="p-3 rounded-3 bg-light"><small>RAM</small><div id="mr" class="fs-3 fw-bold">—</div></div></div><div class="col-md-4"><div class="p-3 rounded-3 bg-light"><small>'+esc(t("uptime"))+'</small><div id="mu" class="fs-6 fw-bold mt-2">—</div></div></div></div><div class="mt-4" style="height:300px"><canvas id="monitorChart"></canvas></div></div>';try{const r=await api("/api/router/resources");document.getElementById("mc").textContent=r.cpuLoad+"%";document.getElementById("mr").textContent=r.memoryUsagePercent+"%";document.getElementById("mu").textContent=r.uptime}catch(e){}}
async function loadDashboard(){
 try{const [r,p,i,s]=await Promise.all([api("/api/router/resources"),api("/api/pppoe/active"),api("/api/router/interfaces"),api("/api/payments/summary")]);
 document.getElementById("cpu").textContent=r.cpuLoad+"%";document.getElementById("ram").textContent=r.memoryUsagePercent+"%";document.getElementById("online").textContent=(p.sessions||[]).length;document.getElementById("collection").textContent="৳"+Number((s.summary||{}).today_collection||0).toLocaleString();
 const status=document.getElementById("routerStatus");status.className="router-status status-on";status.innerHTML='<i class="bi bi-circle-fill me-1"></i><span>'+esc(t("routerOnline"))+'</span>';
 const sel=document.getElementById("iface");const current=sel.value;if(!sel.options.length)sel.innerHTML=(i.interfaces||[]).map(x=>'<option value="'+esc(x.name)+'">'+esc(x.name)+'</option>').join("");if(current)sel.value=current;
 document.getElementById("payments").innerHTML=(s.recent||[]).map(x=>'<div class="d-flex justify-content-between align-items-center border-bottom py-2"><span><b>'+esc(String(x.channel).toUpperCase())+'</b> <span class="text-secondary">· '+esc(x.trx_id)+'</span></span><b>৳'+Number(x.amount).toFixed(2)+'</b></div>').join("")||'<div class="empty">'+t("noPayments")+'</div>';
 if(sel.value&&!trafficTimer)startTraffic(sel.value);
 }catch(e){const status=document.getElementById("routerStatus");status.className="router-status status-off";status.innerHTML='<i class="bi bi-circle-fill me-1"></i><span>'+esc(t("routerOffline"))+'</span>'}
}
async function pollTraffic(name){if(!name)return;try{const d=await api("/api/router/traffic?interface="+encodeURIComponent(name));if(!trafficChart){trafficChart=new Chart(document.getElementById("trafficChart"),{type:"line",data:{labels:[],datasets:[{label:"RX Mbps",data:[],tension:.3},{label:"TX Mbps",data:[],tension:.3}]},options:{responsive:true,maintainAspectRatio:false,animation:false,plugins:{legend:{position:"bottom"}}}})}trafficChart.data.labels.push(new Date().toLocaleTimeString());trafficChart.data.datasets[0].data.push(d.rxMbps);trafficChart.data.datasets[1].data.push(d.txMbps);if(trafficChart.data.labels.length>30){trafficChart.data.labels.shift();trafficChart.data.datasets.forEach(x=>x.data.shift())}trafficChart.update()}catch(e){}}
function startTraffic(name){if(trafficTimer)clearInterval(trafficTimer);pollTraffic(name);trafficTimer=setInterval(()=>pollTraffic(name),2500)}
document.getElementById("iface").addEventListener("change",e=>startTraffic(e.target.value));
loadDashboard();setInterval(loadDashboard,5000);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>