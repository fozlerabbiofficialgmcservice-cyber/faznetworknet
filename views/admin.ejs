@media(max-width:991.98px){.sidebar{transform:translateX(-100%)}.sidebar.show{transform:translateX(0)}.main-shell{margin-left:0}.mobile-toggle{display:inline-grid;place-items:center}.sidebar-overlay.show{display:block;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1035}.content{padding:16px}.topbar{padding:0 15px}.desktop-only{display:none!important}}
