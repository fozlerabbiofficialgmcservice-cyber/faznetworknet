                    <li><a href="javascript:void(0)"><span data-key="manage">Manage</span></a></li>
                    <li>
                        <button class="dropdown-toggle" onclick="toggleSubmenu(event, this)">
                            <i class="bi bi-headset"></i> <span data-key="support">Support</span>
                            <i class="bi bi-chevron-down ms-auto arrow-icon"></i>
                        </button>
                        <ul class="submenu">
                            <li><a href="javascript:void(0)"><span data-key="support_tickets">Support Tickets</span></a></li>
                            <li><a href="javascript:void(0)"><span data-key="software_support_tickets">Software Support Tickets</span></a></li>
                            <li><a href="javascript:void(0)"><span data-key="website_support_tickets">Website Support Tickets</span></a></li>
                        </ul>
                    </li>
                </ul>
            </li>

            <li class="menu-item">
                <button class="dropdown-toggle" onclick="toggleSubmenu(event, this)">
                    <i class="bi bi-wallet2"></i> <span data-key="expenses">Expenses</span>
                    <i class="bi bi-chevron-down ms-auto arrow-icon"></i>
                </button>
                <ul class="submenu">
