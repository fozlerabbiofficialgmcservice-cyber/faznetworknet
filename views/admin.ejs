            if(!input.value){badge.className='badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2';badge.textContent='Status: Select expiration date';return;}
            const expired=input.value<localDateValue(); badge.className=expired?'badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2':'badge bg-success-subtle text-success border border-success-subtle px-3 py-2'; badge.textContent=expired?'Status: Expired / Suspended':'Status: Active';
        }
