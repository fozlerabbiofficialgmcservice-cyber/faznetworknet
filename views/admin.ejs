                                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                    <input id="customerLiveSearch" type="search" class="form-control" placeholder="${escapeHtml(t.search_customers)}" data-placeholder-key="search_customers" oninput="filterCustomerRows(this.value)">
                                </div>
                            </div>
                            <button class="btn btn-outline-success btn-sm mt-2 mt-md-0" onclick="refreshCustomerSection()"><i class="bi bi-arrow-clockwise"></i></button>
                        </div>
                        <div class="card-body p-0 table-responsive">
                            <table class="table table-hover mb-0 customer-live-table">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th data-key="full_name_phone">${escapeHtml(t.full_name_phone)}</th>
                                        <th data-key="username">${escapeHtml(t.username)}</th>
                                        <th data-key="package_profile">${escapeHtml(t.package_profile)}</th>
                                        <th data-key="ip_caller_id">${escapeHtml(t.ip_caller_id)}</th>
                                        <th data-key="status_badge">${escapeHtml(t.status_badge)}</th>
                                        <th data-key="expiry_date">${escapeHtml(t.expiry_date)}</th>
                                        <th data-key="actions">${escapeHtml(t.actions)}</th>
                                    </tr>
                                </thead>
                                <tbody id="customerFilterBody">
                                    ${users.length ? users.map((user, index) => customerRowHtml(user, index + 1, t)).join('') : `<tr><td colspan="8" class="text-center py-5 text-muted" data-key="no_customers">${escapeHtml(t.no_customers)}</td></tr>`}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>`;

            updateLanguage(lang);
        }

        function customerRowHtml(user, index, t) {
            const status = customerStatus(user);
            const fullName = user.comment || user.raw_config?.['full-name'] || user.raw_config?.name || '-';
            const phone = user.phone || '-';
            const ip = user.session_ip || user.remote_address || user.remoteAddress || '-';
            const caller = user.session_caller_id || user.caller_id || '-';
            const expiry = user.expiry_date ? new Date(user.expiry_date).toLocaleString() : '-';
            const sessionMeta = status.online
                ? `<div class="customer-session text-success"><i class="bi bi-broadcast"></i> ${escapeHtml(t.uptime)}: ${escapeHtml(user.session_uptime || '-')}</div>`
                : '';
            const statusBadge = `<span class="badge ${status.cls} customer-status" data-key="${status.key}">${escapeHtml(t[status.key])}</span>${sessionMeta}`;
            const disabled = Boolean(user.disabled);
            const toggleLabel = disabled ? t.enable : t.disable;
            const toggleIcon = disabled ? 'bi-toggle-on' : 'bi-toggle-off';
            const safeUsername = encodeURIComponent(user.username || '');
            return `<tr data-customer-row>
                <td>${index}</td>
                <td><div class="fw-semibold">${escapeHtml(fullName)}</div><div class="text-muted small">${escapeHtml(phone)}</div></td>
                <td><strong>${escapeHtml(user.username)}</strong></td>
                <td><span class="badge bg-info text-dark">${escapeHtml(user.profile || 'N/A')}</span></td>
                <td><div class="customer-ip">${escapeHtml(ip)}</div><div class="text-muted small">${escapeHtml(caller)}</div></td>
                <td>${statusBadge}</td>
                <td>${escapeHtml(expiry)}</td>
                <td>
                    <div class="btn-group btn-group-sm customer-action-group">
                        <button class="btn btn-outline-danger" title="${escapeHtml(t.kick)}" onclick="kickCustomerFromSection('${safeUsername}')"><i class="bi bi-power"></i></button>
                        <button class="btn btn-outline-success" title="${escapeHtml(toggleLabel)}" onclick="toggleCustomerFromSection('${safeUsername}', ${!disabled})"><i class="bi ${toggleIcon}"></i></button>
                        <button class="btn btn-outline-secondary" title="${escapeHtml(t.view)}" onclick="viewCustomerDetails('${safeUsername}')"><i class="bi bi-eye"></i></button>
                    </div>
                </td>
            </tr>`;
        }

        async function loadCustomerSection(filterType, titleKey) {
            purgeStuckBackdrops();
            currentCustomerFilter = filterType;
            currentCustomerTitleKey = titleKey;
            document.querySelectorAll('.admin-view').forEach(view => view.style.display = 'none');
            setPageTitleSafe(customerTitle(titleKey));
            document.getElementById('dynamicPageContent').innerHTML = `
                <section id="view-customer-filter" class="admin-view">
                    <div class="card card-custom">
                        <div class="card-custom-header"><i class="bi bi-hourglass-split text-success fs-5"></i><span data-key="loading_customers">Loading customers...</span></div>
                        <div class="card-body text-center py-5"><div class="spinner-border text-success" role="status"></div></div>
                    </div>
                </section>`;
            try {
                const data = await jsonFetch('/api/pppoe/users?filter=' + encodeURIComponent(filterType));
                renderCustomerTable(data.users || []);
            } catch (error) {
                document.getElementById('dynamicPageContent').innerHTML = '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>' + escapeHtml(error.message) + '</div>';
            }
            if (window.innerWidth <= 768) document.getElementById('sidebar').classList.remove('show');
        }

        async function refreshCustomerSection() {
            await loadCustomerSection(currentCustomerFilter, currentCustomerTitleKey || 'all_customer');
        }

        async function kickCustomerFromSection(encodedUsername) {
            const username = decodeURIComponent(encodedUsername);
            if (!confirm('Kick user ' + username + '?')) return;
            try {
                await jsonFetch('/api/pppoe/kick-user', {
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({username})
                });
                await refreshCustomerSection();
            } catch (error) { alert(error.message); }
        }

        async function toggleCustomerFromSection(encodedUsername, disabled) {
            const username = decodeURIComponent(encodedUsername);
            try {
                await jsonFetch('/api/pppoe/toggle-user', {
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({username, disabled})
                });
                await refreshCustomerSection();
            } catch (error) { alert(error.message); }
        }

        function viewCustomerDetails(encodedUsername) {
            const username = decodeURIComponent(encodedUsername);
            const user = currentCustomerUsers.find(item => String(item.username) === username);
            if (!user) return;
            const session = user.session || {};
            const lang = localStorage.getItem('faz_preferred_lang') || 'en';
            const t = translations[lang] || translations.en;
            const modal = document.createElement('div');
            modal.className = 'modal fade';
            modal.innerHTML = `
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="bi bi-person-circle text-success me-2"></i>${escapeHtml(t.view_customer)}: ${escapeHtml(user.username)}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-2">
                                <div class="col-6"><small class="text-muted">${escapeHtml(t.full_name_phone)}</small><div>${escapeHtml(user.comment || '-')}</div><div>${escapeHtml(user.phone || '-')}</div></div>
                                <div class="col-6"><small class="text-muted">${escapeHtml(t.package_profile)}</small><div>${escapeHtml(user.profile || '-')}</div></div>
                                <div class="col-6"><small class="text-muted">${escapeHtml(t.ip_caller_id)}</small><div>${escapeHtml(user.session_ip || user.remote_address || '-')}</div><div>${escapeHtml(user.session_caller_id || user.caller_id || '-')}</div></div>
                                <div class="col-6"><small class="text-muted">${escapeHtml(t.expiry_date)}</small><div>${escapeHtml(user.expiry_date ? new Date(user.expiry_date).toLocaleString() : '-')}</div></div>
                            </div>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(modal);
            const instance = new bootstrap.Modal(modal);
            modal.addEventListener('hidden.bs.modal', () => modal.remove());
            instance.show();
        }

        async function fetchCustomers() {
            try {
                const data = await jsonFetch('/api/pppoe/users?filter=all');
                const users = data.users || [];
                const tbody = document.getElementById('pppoeUserList');
                if (!tbody) return;
                tbody.innerHTML = users.length ? users.map(u => {
                    const disabled = Boolean(u.disabled);
                    const safeUsername = encodeURIComponent(u.username || '');
                    return '<tr>' +
                        '<td><strong>' + escapeHtml(u.username) + '</strong></td>' +
                        '<td><span class="badge bg-info text-dark">' + escapeHtml(u.profile || 'N/A') + '</span></td>' +
                        '<td>' + escapeHtml(u.phone || '-') + '</td>' +
                        '<td><span class="badge ' + (disabled ? 'bg-danger' : 'bg-success') + '">' + (disabled ? 'Disabled' : 'Active') + '</span></td>' +
                        '<td>' + escapeHtml(u.expiry_date ? new Date(u.expiry_date).toLocaleString() : 'Active') + '</td>' +
                        '<td><button class="btn btn-sm btn-outline-danger" onclick="kickUser(decodeURIComponent(\'' + safeUsername + '\'))">Kick</button></td>' +
                    '</tr>';
                }).join('') : '<tr><td colspan="6" class="text-center py-3">No customers found. Click Sync MikroTik.</td></tr>';
            } catch (error) {
                const tbody = document.getElementById('pppoeUserList');
                if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-danger">' + escapeHtml(error.message) + '</td></tr>';
            }
        }

        async function kickUser(username) {
            if (!confirm('Kick user ' + username + '?')) return;
            try {
                await jsonFetch('/api/pppoe/kick-user', {
                    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({username})
                });
                fetchCustomers();
            } catch (error) { alert(error.message); }
        }

        async function syncMikrotik(btn) {
            btn.disabled = true;
            const old = btn.innerHTML;
            btn.innerHTML = 'Syncing...';
            try {
                await jsonFetch('/api/pppoe/sync', {method:'POST'});
                await fetchCustomers();
                await refreshDashboard();
            } catch (error) { alert(error.message); }
            finally { btn.disabled = false; btn.innerHTML = old; }
        }

        function localDateValue() {
            const now = new Date();
            const offset = now.getTimezoneOffset();
            return new Date(now.getTime() - offset * 60000).toISOString().slice(0, 10);
        }

        async function loadCustomerPackages(selectedProfile = '') {
            const select = document.getElementById('packageSelect');
            if (!select) return;
            select.innerHTML = '<option value="">Loading packages...</option>';
            try {
                const data = await jsonFetch('/api/packages');
                const packages = data.packages || [];
                if (!packages.length) {
                    select.innerHTML = '<option value="">No packages configured</option>';
                    applyCustomerPackagePrice();
                    return;
                }
                select.innerHTML = '<option value="">Select a package / profile</option>' + packages.map(pkg => {
                    const price = Number(pkg.price || 0);
                    return '<option value="' + escapeHtml(pkg.profile || pkg.name) + '" data-price="' + price.toFixed(2) + '">' +
                        escapeHtml(pkg.name || pkg.profile) + ' — ৳' + price.toFixed(2) + '</option>';
                }).join('');
                if (selectedProfile) select.value = selectedProfile;
                applyCustomerPackagePrice();
            } catch (error) {
                select.innerHTML = '<option value="">Unable to load packages</option>';
                const hint = document.getElementById('packagePriceHint');
                if (hint) hint.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>' + escapeHtml(error.message);
            }
        }

        function applyCustomerPackagePrice() {
            const select = document.getElementById('packageSelect');
            const input = document.getElementById('monthlyBillInput');
            const hint = document.getElementById('packagePriceHint');
            if (!select || !input) return;
            const option = select.options[select.selectedIndex];
            const price = option ? Number(option.dataset.price || 0) : 0;
            if (select.value) {
                input.value = price.toFixed(2);
                if (hint) hint.innerHTML = '<i class="bi bi-check-circle-fill me-1 text-success"></i>Preset package price loaded. You can edit it for a custom discount.';
            } else {
                input.value = '';
                if (hint) hint.innerHTML = '<i class="bi bi-info-circle me-1"></i>Select a package to load its preset price.';
            }
        }

        async function showAddCustomerForm() {
            purgeStuckBackdrops();
            switchView('add-customer');
            const dateInput = document.getElementById('connectionDate');
            if (dateInput && !dateInput.value) dateInput.value = localDateValue();
            await loadCustomerPackages();
            if (window.innerWidth <= 768 && typeof closeSidebarMobile === 'function') closeSidebarMobile();
        }

        function applyPhoneCredentials() {
            const helper = document.getElementById('phoneCredentialHelper');
            const phone = document.getElementById('phoneNumber');
            const username = document.getElementById('username');
            const password = document.getElementById('password');
            if (!helper || !phone || !username || !password || !helper.checked) return;
            const value = phone.value.trim();
            if (value) {
                username.value = value;
                password.value = value;
            }
        }

        document.getElementById('packageSelect')?.addEventListener('change', applyCustomerPackagePrice);
        document.getElementById('phoneCredentialHelper')?.addEventListener('change', function(){ if(this.checked) applyPhoneCredentials(); });
        document.getElementById('phoneNumber')?.addEventListener('input', applyPhoneCredentials);
        document.getElementById('toggleCustomerPassword')?.addEventListener('click', function(){
            const input=document.getElementById('password');
            if(!input) return;
            const visible=input.type==='text';
            input.type=visible?'password':'text';
            this.innerHTML='<i class="bi '+(visible?'bi-eye':'bi-eye-slash')+'"></i>';
        });

        document.getElementById('addCustomerForm').addEventListener('reset', function(){
            setTimeout(function(){
                const dateInput=document.getElementById('connectionDate');
                if(dateInput) dateInput.value=localDateValue();
                applyCustomerPackagePrice();
            },0);
        });

        document.getElementById('addCustomerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const form=this;
            if(!form.checkValidity()){ form.classList.add('was-validated'); return; }
            const button=document.getElementById('saveCustomerBtn');
            const oldHtml=button.innerHTML;
            button.disabled=true;
            button.innerHTML='<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving...';
            try {
                const packageSelect=document.getElementById('packageSelect');
                const profile=packageSelect.value.trim();
                const selectedOption=packageSelect.options[packageSelect.selectedIndex];
                const payload={
                    fullName:document.getElementById('fullName').value.trim(),
                    phone:document.getElementById('phoneNumber').value.trim(),
                    connectionDate:document.getElementById('connectionDate').value,
                    username:document.getElementById('username').value.trim(),
                    password:document.getElementById('password').value.trim(),
                    package:selectedOption?.textContent?.split(' — ৳')[0]?.trim() || profile,
                    profile,
                    bill:document.getElementById('monthlyBillInput').value,
                    nid:document.getElementById('nidNumber').value.trim(),
                    installationAddress:document.getElementById('installationAddress').value.trim(),
                    fiberBox:document.getElementById('fiberBox').value.trim(),
                    onuMac:document.getElementById('onuMac').value.trim(),
                    remarks:document.getElementById('customerRemarks').value.trim()
                };
                const data=await jsonFetch('/api/customers',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                alert(data.message || 'Customer created successfully');
                form.reset();
                form.classList.remove('was-validated');
                const dateInput=document.getElementById('connectionDate');
                if(dateInput) dateInput.value=localDateValue();
                await loadCustomerPackages();
                switchView('all-customer');
            } catch(error) {
                alert(error.message);
            } finally {
                button.disabled=false;
                button.innerHTML=oldHtml;
            }
        });



        async function fetchPayments(channel = '') {
            const body = document.getElementById('paymentsBody');
            if (!body) return;
            try {
                const gateway = channel || 'all';
                const data = await jsonFetch('/api/payments/transactions?gateway=' + encodeURIComponent(gateway));
                const rows = (data.transactions || []).slice(0, 500);
                safeSetText('paymentFilterLabel', gateway.toUpperCase());
                body.innerHTML = rows.length ? rows.map(t =>
                    '<tr><td><strong>' + escapeHtml(t.trx_id) + '</strong></td>' +
                    '<td>' + escapeHtml(t.channel || '-') + '</td>' +
                    '<td>৳' + Number(t.amount || 0).toFixed(2) + '</td>' +
                    '<td>' + escapeHtml(t.sender_phone || '-') + '</td>' +
                    '<td><span class="badge ' + (t.status === 'processed' ? 'bg-success' : 'bg-warning text-dark') + '">' + escapeHtml(t.status || 'unknown') + '</span></td>' +
                    '<td>' + escapeHtml(t.created_at ? new Date(t.created_at).toLocaleString() : '-') + '</td></tr>'
                ).join('') : '<tr><td colspan="6" class="text-center py-3 text-muted">No payment records found.</td></tr>';
            } catch (error) {
                body.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-danger">' + escapeHtml(error.message) + '</td></tr>';
            }
        }

        async function refreshDashboard() {
            try {
                const [users, active, summary] = await Promise.all([
                    jsonFetch('/api/pppoe/users'),
                    jsonFetch('/api/pppoe/active'),
                    jsonFetch('/api/payments/summary')
                ]);
                safeSetText('metricCustomers', (users.users || []).length);
                safeSetText('metricSessions', (active.sessions || active.active || []).length);
                safeSetText('metricCollection', '৳' + Number(summary.summary?.today_collection || 0).toFixed(2));
                const recent = summary.recent || [];
                document.getElementById('recentPaymentsBody').innerHTML = recent.slice(0,5).map(t =>
                    '<tr><td>' + escapeHtml(t.trx_id) + '</td><td>' + escapeHtml(t.channel) + '</td><td>৳' + Number(t.amount || 0).toFixed(2) + '</td><td><span class="badge ' + (t.status === 'processed' ? 'bg-success' : 'bg-warning text-dark') + '">' + escapeHtml(t.status) + '</span></td><td>' + escapeHtml(new Date(t.created_at).toLocaleString()) + '</td></tr>'
                ).join('') || '<tr><td colspan="5" class="text-center py-3 text-muted">No recent payments.</td></tr>';
            } catch (error) {
                console.error('[Dashboard]', error);
            }
            await loadRouterMetrics();
        }

        async function loadRouterMetrics() {
            const dashboard = document.getElementById('view-dashboard');
            if (!dashboard || dashboard.style.display === 'none') return;
            try {
                const data = await jsonFetch('/api/router/resources');
                const r = data.resources || {};
                const cpu = Number(r.cpuLoad || 0);
                const ram = Number(r.memoryUsagePercent || 0);
                safeSetText('metricCpu', cpu + '%');
                safeSetText('metricRam', ram + '%');
                document.getElementById('cpuBar').style.width = Math.min(cpu,100) + '%';
                document.getElementById('ramBar').style.width = Math.min(ram,100) + '%';
                const status = document.getElementById('dashboardRouterStatus');
                status.className = 'badge bg-success ms-auto';
                safeSetText('dashboardRouterStatus', 'Online');
            } catch (error) {
                safeSetText('metricCpu', '—');
                safeSetText('metricRam', '—');
                const status = document.getElementById('dashboardRouterStatus');
                status.className = 'badge bg-danger ms-auto';
                safeSetText('dashboardRouterStatus', 'Offline');
            }
        }

        async function loadInterfaces() {
            try {
                const data = await jsonFetch('/api/router/interfaces');
                const interfaces = data.interfaces || [];
                const select = document.getElementById('dashboardInterface');
                const current = select.value;
                if (!select.options.length) select.innerHTML = interfaces.map(i => '<option value="' + escapeHtml(i.name) + '">' + escapeHtml(i.name) + '</option>').join('');
                if (current) select.value = current;
                if (select.value) startTrafficPolling();
            } catch (error) {
                console.error('[Traffic]', error);
            }
        }

        async function pollTraffic() {
            const select = document.getElementById('dashboardInterface');
            if (!select || !select.value) return;
            try {
                const data = await jsonFetch('/api/router/traffic?interface=' + encodeURIComponent(select.value));
                const t = data.traffic || data;
                if (!trafficChart) {
                    trafficChart = new Chart(document.getElementById('dashboardTrafficChart'), {
                        type:'line',
                        data:{labels:[],datasets:[
                            {label:'RX Mbps',data:[],tension:.3},
                            {label:'TX Mbps',data:[],tension:.3}
                        ]},
                        options:{responsive:true,maintainAspectRatio:false,animation:false}
                    });
                }
                trafficChart.data.labels.push(new Date().toLocaleTimeString());
                trafficChart.data.datasets[0].data.push(Number(t.rxMbps || 0));
                trafficChart.data.datasets[1].data.push(Number(t.txMbps || 0));
                if (trafficChart.data.labels.length > 30) {
                    trafficChart.data.labels.shift();
                    trafficChart.data.datasets.forEach(d => d.data.shift());
                }
                trafficChart.update('none');
            } catch (error) { console.error('[Traffic]', error); }
        }

        function startTrafficPolling() {
            if (trafficTimer) clearInterval(trafficTimer);
            loadInterfaces();
            pollTraffic();
            trafficTimer = setInterval(pollTraffic, 2500);
        }

        document.getElementById('dashboardInterface').addEventListener('change', function() {
            if (trafficChart) {
                trafficChart.data.labels = [];
                trafficChart.data.datasets.forEach(d => d.data = []);
                trafficChart.update('none');
            }
            pollTraffic();
        });

        // Background live metrics: 5-second refresh regardless of current view.
        metricsTimer = setInterval(() => {
            loadRouterMetrics();
            if (document.getElementById('view-dashboard')?.style.display !== 'none') refreshDashboard();
            if (currentHotspotMode === 'dashboard' && document.getElementById('hotspotDashboardSessions')) refreshHotspotDashboardMetrics();
            if (currentPaymentTitleKey && document.getElementById('view-payment-ledger')) fetchPaymentsSection();
        }, 5000);

        // Dashboard is the initial operational view.
        switchView('dashboard');
        startTrafficPolling();
    </script>
</body>
</html>