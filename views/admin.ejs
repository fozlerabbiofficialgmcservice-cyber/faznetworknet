        function openHotspotProfileModal(profileName) {
            const existing=profileName?currentHotspotProfiles.find(function(p){return String(p.name)===String(profileName);}):null;
            let modal=document.getElementById('hotspotProfileModal');
            if(!modal){
                modal=document.createElement('div'); modal.id='hotspotProfileModal'; modal.className='modal fade'; modal.tabIndex=-1;
                modal.innerHTML='<div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="bi bi-speedometer2 text-success me-2"></i>Create / Edit Profile</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form id="hotspotProfileForm"><div class="modal-body"><input type="hidden" id="hotspotProfileOriginalName"><div class="row g-3"><div class="col-md-6"><label class="form-label">Profile Name</label><input id="hotspotProfileName" class="form-control" required maxlength="100"></div><div class="col-md-6"><label class="form-label">Rate Limit / Speed (Rx/Tx)</label><input id="hotspotProfileRate" class="form-control" required placeholder="10M/10M"></div><div class="col-md-4"><label class="form-label">Shared Users</label><input id="hotspotProfileShared" type="number" min="1" class="form-control" value="1"></div><div class="col-md-4"><label class="form-label">Validity Value</label><input id="hotspotProfileValidityValue" type="number" min="1" step="1" class="form-control" value="1" required></div><div class="col-md-4"><label class="form-label">Validity Unit</label><select id="hotspotProfileValidityUnit" class="form-select" required><option value="m">Minutes</option><option value="h">Hours</option><option value="d" selected>Days</option></select></div><div class="col-12"><label class="form-label">On-Login Script</label><textarea id="hotspotProfileOnLogin" class="form-control font-monospace" rows="9" readonly></textarea><div class="form-text">Auto-generated MikroTik validity and MAC-lock script.</div></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-theme" id="hotspotProfileSave"><i class="bi bi-cloud-check me-1"></i>Save to MikroTik Router</button></div></form></div></div>';
                document.body.appendChild(modal);
                const buildScript=function(){
                    const value=Number(document.getElementById('hotspotProfileValidityValue')?.value||1);
                    const unit=document.getElementById('hotspotProfileValidityUnit')?.value||'d';
                    const validity=value+unit;
                    const shared=Number(document.getElementById('hotspotProfileShared')?.value||1);
                    const macLock=shared===1?':local mac $"mac-address"; :if ([:len $mac] > 0) do={ /ip hotspot user set [find name=$user] mac-address=$mac; }':'';
                    return ':local validity "'+validity+'"; :local userName $user; '+macLock+' /system scheduler add name=("hs-exp-"+$userName) interval=$validity start-time=([/system clock get time]) on-event="/ip hotspot user disable [find name=\\\"$userName\\\"]; /ip hotspot active remove [find user=\\\"$userName\\\"]; /system scheduler remove [find name=\\\"hs-exp-$userName\\\"];";';
                };
                const refreshScript=function(){ const el=document.getElementById('hotspotProfileOnLogin'); if(el) el.value=buildScript(); };
                ['hotspotProfileValidityValue','hotspotProfileValidityUnit','hotspotProfileShared'].forEach(function(id){ const el=document.getElementById(id); if(el) el.addEventListener('input',refreshScript); if(el) el.addEventListener('change',refreshScript); });
                const form=document.getElementById('hotspotProfileForm');
                if(form) form.onsubmit=async function(e){
                    e.preventDefault();
                    const button=document.getElementById('hotspotProfileSave'); if(!button)return;
                    const original=document.getElementById('hotspotProfileOriginalName')?.value.trim();
                    const name=document.getElementById('hotspotProfileName')?.value.trim();
                    const rateLimit=document.getElementById('hotspotProfileRate')?.value.trim();
                    const validityValue=Math.max(1,Number(document.getElementById('hotspotProfileValidityValue')?.value||1));
                    const validityUnit=document.getElementById('hotspotProfileValidityUnit')?.value||'d';
                    const validity=validityValue+validityUnit;
                    const onLogin=document.getElementById('hotspotProfileOnLogin')?.value||'';
                    const payload={name,rateLimit,sharedUsers:Number(document.getElementById('hotspotProfileShared')?.value||1),validityValue,validityUnit,sessionTimeout:validity,keepaliveTimeout:'',onLogin};
                    if(!name||!rateLimit)return;
                    button.disabled=true;
                    try{
                        const endpoint=original?'/api/hotspot/profiles/update':'/api/hotspot/profiles/create';
                        await jsonFetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                        const instance=bootstrap.Modal.getInstance(modal); if(instance)instance.hide();
                        await loadHotspotProfiles('hotspot_profile');
                    }catch(error){alert(error.message);}finally{button.disabled=false;}
                };
            }
            const original=document.getElementById('hotspotProfileOriginalName'); if(original) original.value=existing?.name||'';
            const name=document.getElementById('hotspotProfileName'); if(name){name.value=existing?.name||'';name.disabled=Boolean(existing);}
            const rate=document.getElementById('hotspotProfileRate'); if(rate) rate.value=existing?.rateLimit||existing?.['rate-limit']||'';
            const shared=document.getElementById('hotspotProfileShared'); if(shared) shared.value=Number(existing?.sharedUsers||existing?.['shared-users']||1);
            const validityText=String(existing?.sessionTimeout||existing?.['session-timeout']||'1d').trim();
            const match=validityText.match(/^(\\d+)\\s*([mhd])$/i);
            const valueEl=document.getElementById('hotspotProfileValidityValue'); if(valueEl) valueEl.value=match?Number(match[1]):1;
            const unitEl=document.getElementById('hotspotProfileValidityUnit'); if(unitEl) unitEl.value=match?match[2].toLowerCase():'d';
            const scriptEl=document.getElementById('hotspotProfileOnLogin');
            if(scriptEl) {
                const v=Number(valueEl?.value||1),u=unitEl?.value||'d',sharedUsers=Number(shared?.value||1);
                const macLock=sharedUsers===1?':local mac $"mac-address"; :if ([:len $mac] > 0) do={ /ip hotspot user set [find name=$user] mac-address=$mac; }':'';
                scriptEl.value=':local validity "'+v+u+'"; :local userName $user; '+macLock+' /system scheduler add name=("hs-exp-"+$userName) interval=$validity start-time=([/system clock get time]) on-event="/ip hotspot user disable [find name=\\\"$userName\\\"]; /ip hotspot active remove [find user=\\\"$userName\\\"]; /system scheduler remove [find name=\\\"hs-exp-$userName\\\"];";';
            }
            // Always mount Hotspot modals at body root and purge stale Bootstrap backdrops first.
            if (modal.parentElement !== document.body) document.body.appendChild(modal);
            document.querySelectorAll('.modal-backdrop').forEach(function(el){ el.remove(); });
            document.body.classList.remove('modal-open');
            const editModalEl = modal;
            const editModal = bootstrap.Modal.getOrCreateInstance(editModalEl, { backdrop: 'static', keyboard: true });
            editModal.show();
            editModalEl.addEventListener('hidden.bs.modal', function(){
                document.body.classList.remove('modal-open');
                document.querySelectorAll('.modal-backdrop').forEach(function(el){ el.remove(); });
                editModalEl.classList.remove('show');
                editModalEl.setAttribute('aria-hidden', 'true');
                editModalEl.style.display = 'none';
            }, { once: true });
        }
