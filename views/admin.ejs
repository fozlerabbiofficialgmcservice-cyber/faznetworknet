            const gatewayLabel = gateway === 'bkash' ? 'bKash' : gateway === 'nagad' ? 'Nagad' : gateway === 'rocket' ? 'Rocket' : gateway || '-';
            const action = unmatched ? '<button class="btn btn-sm btn-outline-success" title="' + escapeHtml(t.manual_match) + '" onclick="openManualMatchModal(' + JSON.stringify(tx.trx_id) + ')"><i class="bi bi-person-check"></i></button>' : '<span class="text-muted">—</span>';
