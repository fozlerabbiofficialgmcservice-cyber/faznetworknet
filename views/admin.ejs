                                <div class="col-md-6"><label for="phoneNumber" class="form-label" data-key="label_phone">Phone Number *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span><input type="tel" class="form-control" id="phoneNumber" placeholder="e.g. 01700000000" data-placeholder-key="ph_phone" required></div></div>
                                <div class="col-md-6"><label for="username" class="form-label" data-key="label_username">Username *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-at"></i></span><input type="text" class="form-control" id="username" placeholder="pppoe_user" data-placeholder-key="ph_username" required></div></div>
                                <div class="col-md-6"><label for="password" class="form-label" data-key="label_password">Password *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-key"></i></span><input type="password" class="form-control" id="password" placeholder="••••••••" data-placeholder-key="ph_password" required></div></div>
                                <div class="col-md-6"><label for="packageSelect" class="form-label" data-key="label_package">Package Selection *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-speedometer"></i></span><select class="form-select" id="packageSelect" required><option value="Profile-10M">Standard - 10 Mbps</option><option value="Profile-20M">Premium - 20 Mbps</option><option value="default">Default</option></select></div></div>
                                <div class="col-md-6"><label for="billingDuration" class="form-label" data-key="label_billing_duration">Billing Duration *</label><div class="input-group"><span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span><select class="form-select" id="billingDuration" required><option value="1_month" selected data-key="opt_1_month">1 Month (30 Days)</option></select></div></div>
                                <div class="col-12 mt-4 pt-2 border-top d-flex justify-content-end gap-2"><button type="reset" class="btn btn-light border px-4" data-key="btn_reset">Reset</button><button type="submit" class="btn btn-theme px-4" data-key="btn_save_customer"><i class="bi bi-check2-circle me-1"></i> Save Customer</button></div>
                            </div>
                        </form>
                    </div>
                </div>
            </section>

            <!-- VIEW 3: ALL CUSTOMER -->
            <section id="view-all-customer" class="admin-view" style="display:none">
                <div class="card card-custom">
                    <div class="card-custom-header"><i class="bi bi-people text-success fs-5"></i><span>PPPoE Customer Records</span><button id="customerSyncBtn" class="btn btn-outline-success btn-sm ms-auto" onclick="syncMikrotik(this)"><i class="bi bi-arrow-repeat"></i> 🔄 Sync MikroTik</button></div>
                    <div class="card-body p-0 table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Username</th><th>Profile</th><th>Phone</th><th>Status</th><th>Expiry Date</th><th>Action</th></tr></thead><tbody id="pppoeUserList"><tr><td colspan="6" class="text-center py-3 text-muted">Loading customer records...</td></tr></tbody></table></div>
                </div>
            </section>

            <!-- VIEW 4: PAYMENTS -->
            <section id="view-payments" class="admin-view" style="display:none">
                <div class="card card-custom">
                    <div class="card-custom-header"><i class="bi bi-credit-card text-success fs-5"></i><span>All Payments</span><span id="paymentFilterLabel" class="badge bg-light text-dark ms-2">All Gateways</span></div>
                    <div class="card-body p-0 table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>TrxID</th><th>Gateway</th><th>Amount</th><th>Sender Phone</th><th>Status</th><th>Date</th></tr></thead><tbody id="paymentsBody"><tr><td colspan="6" class="text-center py-3 text-muted">Loading payments...</td></tr></tbody></table></div>
                </div>
            </section>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
        let currentHotspotMode = '';
        let currentHotspotTitleKey = '';
        let currentHotspotProfiles = [];
        let currentVoucherBatch = [];

        function hotspotTitle(key) {
            const lang = localStorage.getItem('faz_preferred_lang') || 'en';
            return translations[lang]?.[key] || translations.en[key] || key;
        }

        function hideAdminViews() {
            document.querySelectorAll('.admin-view').forEach(function(view){ view.style.display='none'; });
        }

        function removeHotspotView() {
            document.querySelectorAll('.hotspot-dynamic-view').forEach(function(view){ view.remove(); });
        }

        function appendHotspotView(html) {
            hideAdminViews();
            removeHotspotView();
            document.getElementById('dynamicPageContent').insertAdjacentHTML('beforeend', html);
            const view = document.querySelector('.hotspot-dynamic-view:last-child');
            if(view) view.style.display='block';
            if(window.innerWidth<=768) document.getElementById('sidebar').classList.remove('show');
        }

        function setHotspotTitle(key) {
            currentHotspotTitleKey=key;
            document.getElementById('pageTitle').innerText=hotspotTitle(key);
        }

        async function loadHotspotDashboard() {
            currentHotspotMode='dashboard';
            setHotspotTitle('hotspot_dashboard');
            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="row g-3 mb-4">'+
                '<div class="col-md-6 col-xl-3"><div class="card card-custom hotspot-kpi h-100"><div class="card-body"><div class="text-muted small" data-key="total_hotspot_accounts">Total Hotspot Accounts</div><div id="hotspotTotalAccounts" class="fs-3 fw-bold mt-1">—</div></div></div></div>'+
                '<div class="col-md-6 col-xl-3"><div class="card card-custom hotspot-kpi h-100"><div class="card-body"><div class="text-muted small" data-key="currently_online_clients">Currently Online Clients</div><div id="hotspotOnlineCount" class="fs-3 fw-bold mt-1">—</div></div></div></div>'+
                '<div class="col-md-6 col-xl-3"><div class="card card-custom hotspot-kpi h-100"><div class="card-body"><div class="text-muted small" data-key="total_vouchers_generated">Total Vouchers Generated</div><div id="hotspotVoucherCount" class="fs-3 fw-bold mt-1">—</div></div></div></div>'+
                '<div class="col-md-6 col-xl-3"><div class="card card-custom hotspot-kpi h-100"><div class="card-body"><div class="text-muted small" data-key="hotspot_revenue">Hotspot Revenue</div><div id="hotspotRevenue" class="fs-3 fw-bold mt-1 text-success">৳0.00</div></div></div></div>'+
                '</div><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-wifi text-success fs-5"></i> <span data-key="live_hotspot_overview">Live Hotspot Overview</span></div><div class="card-body"><div id="hotspotDashboardBody" class="text-muted">Loading live MikroTik Hotspot data...</div></div></div></section>');
            try {
                const all=await jsonFetch('/api/hotspot/users?filter=all');
                const online=await jsonFetch('/api/hotspot/users?filter=online');
                const users=all.users||[];
                document.getElementById('hotspotTotalAccounts').innerText=users.length;
                document.getElementById('hotspotVoucherCount').innerText=users.length;
                document.getElementById('hotspotOnlineCount').innerText=(online.users||[]).length;
                const revenue=users.reduce(function(sum,v){return sum+Number(v.price||0);},0);
                document.getElementById('hotspotRevenue').innerText='৳'+revenue.toFixed(2);
                document.getElementById('hotspotDashboardBody').innerHTML='<div class="d-flex flex-wrap gap-2"><span class="badge bg-success">MikroTik Connected</span><span class="badge bg-light text-dark border">'+users.length+' accounts</span><span class="badge bg-light text-dark border">'+(online.users||[]).length+' online</span></div>';
            } catch(error) {
                const el=document.getElementById('hotspotDashboardBody'); if(el) el.innerHTML='<div class="alert alert-danger mb-0">'+escapeHtml(error.message)+'</div>';
            }
        }

        function hotspotStatusBadge(user) {
            if(user.online) return '<span class="badge bg-success">Online</span>';
            if(user.active) return '<span class="badge bg-primary">Active</span>';
            if(user.status==='expired') return '<span class="badge bg-danger">Expired</span>';
            return '<span class="badge bg-secondary">Unused</span>';
        }

        function formatBytes(value) {
            const n=Number(value||0); if(!n) return '0 B';
            const units=['B','KB','MB','GB','TB']; const i=Math.min(Math.floor(Math.log(n)/Math.log(1024)),units.length-1);
            return (n/Math.pow(1024,i)).toFixed(i?1:0)+' '+units[i];
        }

        function renderHotspotTable(data, mode, titleKey) {
            const lang=localStorage.getItem('faz_preferred_lang')||'en';
            const users=data.users||[];
            let rows='';
            if(mode==='online') {
                rows=users.map(function(u,i){ const s=u.online||u; return '<tr>'+
                    '<td>'+(i+1)+'</td><td><strong>'+escapeHtml(s.username||u.username)+'</strong></td><td>'+escapeHtml(u.password||'-')+'</td><td>'+escapeHtml(s.profile||u.profile||'-')+'</td>'+
                    '<td class="font-monospace">'+escapeHtml(s.address||'-')+'</td><td class="font-monospace">'+escapeHtml(s.macAddress||'-')+'</td><td>'+escapeHtml(s.uptime||'-')+'</td>'+
                    '<td>'+formatBytes(s.bytesIn)+' / '+formatBytes(s.bytesOut)+'</td><td><span class="badge bg-success">Online</span></td>'+
                    '<td><button class="btn btn-sm btn-outline-warning" onclick="kickHotspotUser('+JSON.stringify(s.username||u.username)+')"><i class="bi bi-box-arrow-right"></i></button> <button class="btn btn-sm btn-outline-danger" onclick="removeHotspotUser('+JSON.stringify(s.username||u.username)+')"><i class="bi bi-trash"></i></button></td></tr>'; }).join('');
            } else {
                rows=users.map(function(u,i){ return '<tr>'+
                    '<td>'+(i+1)+'</td><td><strong>'+escapeHtml(u.username)+'</strong></td><td class="font-monospace">'+escapeHtml(u.password||u.mikrotik?.password||'-')+'</td>'+
                    '<td>'+escapeHtml(u.profile||u.mikrotik?.profile||'-')+'</td><td>'+escapeHtml(u.online?.address||'-')+'</td><td>'+escapeHtml(u.online?.macAddress||'-')+'</td>'+
                    '<td>'+escapeHtml(u.online?.uptime||'-')+'</td><td>'+hotspotStatusBadge(u)+'</td>'+
                    '<td><button class="btn btn-sm btn-outline-warning" '+(u.online?'':'disabled')+' onclick="kickHotspotUser('+JSON.stringify(u.username)+')"><i class="bi bi-box-arrow-right"></i></button> <button class="btn btn-sm btn-outline-danger" onclick="removeHotspotUser('+JSON.stringify(u.username)+')"><i class="bi bi-trash"></i></button></td></tr>'; }).join('');
            }
            if(!rows) rows='<tr><td colspan="10" class="text-center py-5 text-muted">No Hotspot users found.</td></tr>';
            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-custom-header flex-wrap"><div><i class="bi bi-wifi text-success fs-5 me-2"></i>'+escapeHtml(hotspotTitle(titleKey))+' <span class="badge bg-success">'+users.length+'</span></div><div class="hotspot-search ms-auto mt-2 mt-md-0"><div class="input-group input-group-sm"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input id="hotspotSearch" class="form-control" placeholder="Search username, profile, IP or MAC..." data-placeholder-key="search_hotspot" oninput="filterHotspotRows(this.value)"></div></div><button class="btn btn-outline-success btn-sm ms-2 mt-2 mt-md-0" onclick="refreshHotspotCurrent()"><i class="bi bi-arrow-clockwise"></i></button></div><div class="card-body p-0 table-responsive"><table class="table table-hover mb-0 hotspot-live-table"><thead class="table-light"><tr><th>#</th><th>Username</th><th>Password</th><th>Profile</th><th>IP</th><th>MAC Address</th><th>Uptime</th><th data-key="bytes_in_out">Bytes In/Out</th><th>Status</th><th>Actions</th></tr></thead><tbody id="hotspotUserBody">'+rows+'</tbody></table></div></div></section>');
            updateLanguage(lang);
        }

        function filterHotspotRows(query) {
            const q=String(query||'').trim().toLowerCase();
            document.querySelectorAll('#hotspotUserBody tr').forEach(function(row){row.style.display=row.innerText.toLowerCase().includes(q)?'':'none';});
        }

        async function loadHotspotSection(filter,titleKey) {
            currentHotspotMode=filter;
            currentHotspotTitleKey=titleKey;
            setHotspotTitle(titleKey);
            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-body text-center py-5"><div class="spinner-border text-success"></div></div></div></section>');
            try { const data=await jsonFetch('/api/hotspot/users?filter='+encodeURIComponent(filter)); renderHotspotTable(data,filter,titleKey); }
            catch(error){ appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="alert alert-danger">'+escapeHtml(error.message)+'</div></section>'); }
        }

        async function refreshHotspotCurrent() {
            if(!currentHotspotMode || currentHotspotMode==='dashboard' || currentHotspotMode==='generator' || currentHotspotMode==='profiles' || currentHotspotMode==='server-profiles') return;
            await loadHotspotSection(currentHotspotMode,currentHotspotTitleKey);
        }

        async function kickHotspotUser(username) {
            try { await jsonFetch('/api/hotspot/users/kick',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:username})}); await refreshHotspotCurrent(); }
            catch(error){ alert(error.message); }
        }

        async function removeHotspotUser(username) {
            if(!confirm(hotspotTitle('remove_user_confirm')+' "'+username+'"?')) return;
            try { await jsonFetch('/api/hotspot/users/remove',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:username})}); await refreshHotspotCurrent(); }
            catch(error){ alert(error.message); }
        }

        async function loadHotspotProfiles(titleKey) {
            currentHotspotMode='profiles'; currentHotspotTitleKey=titleKey; setHotspotTitle(titleKey);
            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-body text-center py-5"><div class="spinner-border text-success"></div></div></div></section>');
            try {
                const data=await jsonFetch('/api/hotspot/profiles');
                currentHotspotProfiles=data.profiles||[];
                let rows=currentHotspotProfiles.map(function(p,i){return '<tr><td>'+(i+1)+'</td><td><strong>'+escapeHtml(p.name)+'</strong></td><td>'+escapeHtml(p.rateLimit||'-')+'</td><td>'+escapeHtml(p.sharedUsers||'-')+'</td><td>'+escapeHtml(p.idleTimeout||'-')+'</td><td>'+escapeHtml(p.keepaliveTimeout||'-')+'</td></tr>';}).join('');
                if(!rows) rows='<tr><td colspan="6" class="text-center py-5 text-muted">No Hotspot user profiles found.</td></tr>';
                appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-speedometer2 text-success fs-5"></i> <span data-key="hotspot_user_profiles">Hotspot User Profiles</span> <span class="badge bg-success ms-2">'+currentHotspotProfiles.length+'</span></div><div class="card-body p-0 table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>#</th><th>Name</th><th data-key="rate_limit">Rate Limit</th><th data-key="shared_users">Shared Users</th><th data-key="idle_timeout">Idle Timeout</th><th data-key="keepalive">Keepalive</th></tr></thead><tbody>'+rows+'</tbody></table></div></div></section>');
                updateLanguage(localStorage.getItem('faz_preferred_lang')||'en');
            } catch(error){ appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="alert alert-danger">'+escapeHtml(error.message)+'</div></section>'); }
        }

        async function loadHotspotServerProfiles(titleKey) {
            currentHotspotMode='server-profiles'; currentHotspotTitleKey=titleKey; setHotspotTitle(titleKey);
            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-body text-center py-5"><div class="spinner-border text-success"></div></div></div></section>');
            try {
                const data=await jsonFetch('/api/hotspot/server-profiles');
                const rows=(data.profiles||[]).map(function(p,i){return '<tr><td>'+(i+1)+'</td><td><strong>'+escapeHtml(p.name)+'</strong></td><td>'+escapeHtml(p.hotspotAddress||'-')+'</td><td>'+escapeHtml(p.dnsName||'-')+'</td><td>'+escapeHtml(p.htmlDirectory||'-')+'</td><td>'+escapeHtml(p.rateLimit||'-')+'</td><td>'+escapeHtml(p.loginBy||'-')+'</td><td>'+escapeHtml(p.useRadius?'Yes':'No')+'</td></tr>';}).join('');
                appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-hdd-network text-success fs-5"></i> <span data-key="hotspot_server_profiles">Hotspot Server Profiles</span> <span class="badge bg-success ms-2">'+(data.profiles||[]).length+'</span></div><div class="card-body p-0 table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>#</th><th>Name</th><th data-key="hotspot_address">Hotspot Address</th><th data-key="dns_name">DNS Name</th><th data-key="html_directory">HTML Directory</th><th data-key="rate_limit">Rate Limit</th><th data-key="login_by">Login By</th><th data-key="radius">RADIUS</th></tr></thead><tbody>'+ (rows||'<tr><td colspan="8" class="text-center py-5 text-muted">No server profiles found.</td></tr>') +'</tbody></table></div></div></section>');
                updateLanguage(localStorage.getItem('faz_preferred_lang')||'en');
            } catch(error){ appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="alert alert-danger">'+escapeHtml(error.message)+'</div></section>'); }
        }

        function voucherCardHtml(v) {
            return '<div class="voucher-card"><div class="voucher-brand">FAZ NETWORK Wi-Fi Hotspot</div><div class="voucher-cut"></div><div class="small text-muted" data-key="username_label">Username</div><div class="voucher-credential">'+escapeHtml(v.username)+'</div><div class="small text-muted mt-1" data-key="password_pin">Password / PIN</div><div class="voucher-credential">'+escapeHtml(v.password)+'</div><div class="d-flex justify-content-between mt-2 small"><span>Profile: <strong>'+escapeHtml(v.profile||'-')+'</strong></span><span>Validity: <strong>'+escapeHtml(v.validity||'-')+'</strong></span></div><div class="fw-bold mt-1">Price: ৳ '+Number(v.price||0).toFixed(2)+'</div><div class="voucher-cut"></div><div class="voucher-instruction"><span data-key="instructions">Connect to Wi-Fi → Open Portal → Enter PIN</span></div></div>';
        }

        function renderVoucherCards(vouchers) {
            currentVoucherBatch=vouchers||[];
            const area=document.getElementById('voucherPrintArea') || document.getElementById('hotspotVoucherPrint');
            if(area) area.innerHTML='<div class="voucher-grid">'+currentVoucherBatch.map(voucherCardHtml).join('')+'</div>';
        }

        async function loadVoucherGeneratorSection() {
            currentHotspotMode='generator'; currentHotspotTitleKey='gen_print_vouchers'; setHotspotTitle('gen_print_vouchers');
            appendHotspotView('<section class="hotspot-dynamic-view admin-view"><div class="row g-4"><div class="col-12"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-ticket-perforated text-success fs-5"></i><span data-key="gen_print_vouchers">'+escapeHtml(hotspotTitle('gen_print_vouchers'))+'</span></div><div class="card-body"><form id="voucherGeneratorForm"><div class="row g-3"><div class="col-md-2"><label class="form-label" data-key="quantity">Quantity</label><input id="voucherQuantity" type="number" class="form-control" min="1" max="500" value="10" required></div><div class="col-md-2"><label class="form-label" data-key="user_prefix">User Prefix</label><input id="voucherPrefix" class="form-control" value="FAZ-" maxlength="20"></div><div class="col-md-2"><label class="form-label" data-key="character_length">Character Length</label><input id="voucherCharLength" type="number" class="form-control" min="4" max="16" value="6"></div><div class="col-md-3"><label class="form-label" data-key="profile">Profile</label><select id="voucherProfile" class="form-select" required><option value="">Loading profiles...</option></select></div><div class="col-md-1"><label class="form-label" data-key="price">Price</label><input id="voucherPrice" type="number" class="form-control" min="0" step="0.01" value="20"></div><div class="col-md-2"><label class="form-label" data-key="validity">Validity</label><input id="voucherValidity" class="form-control" value="1d" required></div><div class="col-12 d-flex justify-content-end gap-2 mt-3"><button type="submit" class="btn btn-theme"><i class="bi bi-magic me-1"></i> <span data-key="generate_batch_vouchers">Generate Batch Vouchers</span></button><button type="button" class="btn btn-outline-success" onclick="printVoucherCards()">🖨️ <span data-key="print_voucher_cards">Print Voucher Cards</span></button></div></div></form></div></div></div><div class="col-12"><div class="card card-custom"><div class="card-custom-header"><i class="bi bi-printer text-success fs-5"></i> <span data-key="printable_voucher_cards">Printable Voucher Cards</span> <span id="voucherBatchCount" class="badge bg-success ms-2">0</span></div><div class="card-body" id="voucherPrintArea"><div class="text-center py-5 text-muted">Generate a voucher batch to preview printable cards.</div></div></div></div></div></section>');
            try {
                const data=await jsonFetch('/api/hotspot/profiles');
                const select=document.getElementById('voucherProfile');
                const profiles=data.profiles||[];
                select.innerHTML=profiles.map(function(p){return '<option value="'+escapeHtml(p.name)+'">'+escapeHtml(p.name)+(p.rateLimit?' — '+escapeHtml(p.rateLimit):'')+'</option>';}).join('');
                if(!profiles.length) select.innerHTML='<option value="">No MikroTik profiles found</option>';
            } catch(error) {
                const select=document.getElementById('voucherProfile'); if(select) select.innerHTML='<option value="">'+escapeHtml(error.message)+'</option>';
            }
            document.getElementById('voucherGeneratorForm').addEventListener('submit',window.generateHotspotVouchers);
        }

        async function generateVoucherBatch(event) {
            event.preventDefault();
            const btn=event.submitter;
            if(btn){btn.disabled=true;btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span> '+hotspotTitle('generating')+'...';}
            try {
                const payload={quantity:Number(document.getElementById('voucherQuantity').value),profile:document.getElementById('voucherProfile').value,validity:document.getElementById('voucherValidity').value.trim(),price:Number(document.getElementById('voucherPrice').value),userPrefix:document.getElementById('voucherPrefix').value.trim(),charLength:Number(document.getElementById('voucherCharLength').value)};
                const data=await jsonFetch('/api/hotspot/vouchers/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                renderVoucherCards(data.vouchers||[]);
                const count=document.getElementById('voucherBatchCount'); if(count) count.innerText=data.count||0;
            } catch(error) { alert(error.message); }
            finally { if(btn){btn.disabled=false;btn.innerHTML='<i class="bi bi-magic me-1"></i> <span data-key="generate_batch_vouchers">Generate Batch Vouchers</span>';} }
        }

        function printVoucherCards() {
            if(!currentVoucherBatch.length){alert(hotspotTitle('generate_first'));return;}
            document.body.classList.add('hotspot-printing');
            setTimeout(function(){window.print();},50);
            setTimeout(function(){document.body.classList.remove('hotspot-printing');},1000);
        }


        // Explicit global Hotspot handlers for inline sidebar onclick bindings.
        window.loadHotspotDashboard = async function() {
            console.log('[HOTSPOT UI]', 'loadHotspotDashboard', 'invoked');
            return await loadHotspotDashboard();
        };
        window.loadHotspotSection = async function(filterType, titleKey) {
            console.log('[HOTSPOT UI]', 'loadHotspotSection', 'invoked');
            return await loadHotspotSection(filterType, titleKey);
        };
        window.loadHotspotProfiles = async function(titleKey) {
            console.log('[HOTSPOT UI]', 'loadHotspotProfiles', 'invoked');
            return await loadHotspotProfiles(titleKey);
        };
        window.loadHotspotServerProfiles = async function(titleKey) {
            console.log('[HOTSPOT UI]', 'loadHotspotServerProfiles', 'invoked');
            return await loadHotspotServerProfiles(titleKey);
        };
        window.loadVoucherGeneratorSection = async function() {
            console.log('[HOTSPOT UI]', 'loadVoucherGeneratorSection', 'invoked');
            return await loadVoucherGeneratorSection();
        };
        window.generateHotspotVouchers = async function(event) {
            console.log('[HOTSPOT UI]', 'generateHotspotVouchers', 'invoked');
            if (event && typeof event.preventDefault === 'function') event.preventDefault();
            const btn = document.querySelector('#voucherGeneratorForm button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> '+hotspotTitle('generating')+'...';
            }
            try {
                const payload = {
                    quantity: Number(document.getElementById('voucherQuantity')?.value || 0),
                    profile: document.getElementById('voucherProfile')?.value || '',
                    validity: String(document.getElementById('voucherValidity')?.value || '').trim(),
                    price: Number(document.getElementById('voucherPrice')?.value || 0),
                    userPrefix: String(document.getElementById('voucherPrefix')?.value || 'FAZ-').trim(),
                    charLength: Number(document.getElementById('voucherCharLength')?.value || 6)
                };
                const data = await jsonFetch('/api/hotspot/vouchers/generate', {
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify(payload)
                });
                currentVoucherBatch = data.vouchers || [];
                const printArea = document.getElementById('voucherPrintArea');
                if (printArea) {
                    printArea.innerHTML = '<div class="voucher-grid">'+currentVoucherBatch.map(voucherCardHtml).join('')+'</div>';
                }
                const legacyArea = document.getElementById('hotspotVoucherPrint');
                if (legacyArea) renderVoucherCards(currentVoucherBatch);
                const count = document.getElementById('voucherBatchCount');
                if (count) count.innerText = data.count || currentVoucherBatch.length;
                return data;
            } catch (error) {
                console.error('[HOTSPOT UI] generateHotspotVouchers failed', error);
                alert(error.message);
                throw error;
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-magic me-1"></i> '+hotspotTitle('generate_batch_vouchers');
                }
            }
        };
        const _existingUpdateLanguage = updateLanguage;
        updateLanguage = function(lang) {
            _existingUpdateLanguage(lang);
            if(currentHotspotTitleKey && translations[lang]?.[currentHotspotTitleKey]) {
                document.getElementById('pageTitle').innerText=translations[lang][currentHotspotTitleKey];
            }
        };
