        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
        }

        function toggleSubmenu(event, button) {
            event.stopPropagation();
            const submenu = button.nextElementSibling;
            submenu.classList.toggle('show');
            const arrow = button.querySelector('.arrow-icon');
            if (arrow) arrow.classList.toggle('bi-chevron-up');
        }

        function showSection(sectionId) {
            const addCard = document.getElementById('section-add-customer');
            const listCard = document.getElementById('section-all-customer');
            if (sectionId === 'add-customer') {
                addCard.style.display = 'block';
                listCard.style.display = 'none';
            } else {
                addCard.style.display = 'block';
                listCard.style.display = 'block';
            }
        }

        function updateLanguage(lang) {
            document.documentElement.lang = lang;
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (translations[lang] && translations[lang][key]) el.innerText = translations[lang][key];
            });
            document.querySelectorAll('[data-placeholder-key]').forEach(el => { const key=el.getAttribute('data-placeholder-key'); if (translations[lang] && translations[lang][key]) el.placeholder=translations[lang][key]; });
            localStorage.setItem('faz_preferred_lang', lang);
        }

        const langSelect = document.getElementById('langSelect');
        const savedLang = localStorage.getItem('faz_preferred_lang') || 'en';
        langSelect.value = savedLang;
        updateLanguage(savedLang);
        langSelect.addEventListener('change', function() { updateLanguage(this.value); });

        // Load customers persistently via AJAX
        async function fetchCustomers() {
            try {
                const res = await fetch('/api/pppoe/users');
                const data = await res.json();
                const tbody = document.getElementById('pppoeUserList');
                if (data.users && data.users.length > 0) {
                    tbody.innerHTML = data.users.map(u => `
                        <tr>
                            <td><strong>${u.username}</strong></td>
                            <td><span class="badge bg-info text-dark">${u.profile || u.profile_name || 'N/A'}</span></td>
                            <td>${u.phone || '-'}</td>
                            <td><span class="badge ${u.disabled ? 'bg-danger' : 'bg-success'}">${u.disabled ? 'Disabled' : 'Active'}</span></td>
                            <td>${u.expiry_date ? new Date(u.expiry_date).toLocaleDateString() : 'Active'}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" onclick="kickUser('${u.username}')">Kick</button>
                            </td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3">No customers found. Click Sync.</td></tr>';
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function kickUser(username) {
            if (!confirm('Kick user ' + username + '?')) return;
            await fetch('/api/pppoe/kick-user', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username })
            });
            fetchCustomers();
        }

        async function syncMikrotik(btn) {
            btn.disabled = true;
            btn.innerText = 'Syncing...';
            await fetch('/api/pppoe/sync', { method: 'POST' });
            btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> 🔄 Sync MikroTik';
            btn.disabled = false;
            fetchCustomers();
            loadMikrotikStats();
        }

        document.getElementById('addCustomerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const payload = {
                username: document.getElementById('username').value.trim(),
                password: document.getElementById('password').value.trim(),
                phone: document.getElementById('phoneNumber').value.trim(),
                profile: document.getElementById('packageSelect').value
            };
            const res = await fetch('/api/pppoe/users/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                alert('Customer created and synced with MikroTik!');
                document.getElementById('addCustomerForm').reset();
                fetchCustomers();
            } else {
                alert('Error creating customer.');
            }
        });

        let liveTrafficChart=null, liveTrafficTimer=null;
        async function loadMikrotikStats(){try{const [r,i]=await Promise.all([fetch('/api/router/resources').then(x=>x.json()),fetch('/api/router/interfaces').then(x=>x.json())]);document.getElementById('liveCpu').innerText=(r.cpuLoad ?? '—')+'%';document.getElementById('liveRam').innerText=(r.memoryUsagePercent ?? '—')+'%';document.getElementById('liveUptime').innerText=r.uptime||'—';const st=document.getElementById('routerLiveStatus');st.className='badge bg-success ms-auto';st.innerText='Online';const sel=document.getElementById('monitorInterface'),cur=sel.value;if(!sel.options.length)sel.innerHTML=(i.interfaces||[]).map(x=>'<option value="'+x.name+'">'+x.name+'</option>').join('');if(cur)sel.value=cur;if(sel.value)startLiveTraffic(sel.value)}catch(e){const st=document.getElementById('routerLiveStatus');st.className='badge bg-danger ms-auto';st.innerText='Offline'}}
        async function pollLiveTraffic(name){try{const d=await fetch('/api/router/traffic?interface='+encodeURIComponent(name)).then(x=>x.json());if(!liveTrafficChart)liveTrafficChart=new Chart(document.getElementById('liveTrafficChart'),{type:'line',data:{labels:[],datasets:[{label:'RX Mbps',data:[],tension:.3},{label:'TX Mbps',data:[],tension:.3}]},options:{responsive:true,maintainAspectRatio:false,animation:false}});liveTrafficChart.data.labels.push(new Date().toLocaleTimeString());liveTrafficChart.data.datasets[0].data.push(d.rxMbps||0);liveTrafficChart.data.datasets[1].data.push(d.txMbps||0);if(liveTrafficChart.data.labels.length>30){liveTrafficChart.data.labels.shift();liveTrafficChart.data.datasets.forEach(x=>x.data.shift())}liveTrafficChart.update()}catch(e){}}
        function startLiveTraffic(name){if(liveTrafficTimer)clearInterval(liveTrafficTimer);pollLiveTraffic(name);liveTrafficTimer=setInterval(()=>pollLiveTraffic(name),2500)}
        document.getElementById('monitorInterface').addEventListener('change',e=>startLiveTraffic(e.target.value));
        fetchCustomers();loadMikrotikStats();setInterval(loadMikrotikStats,5000);
    </script>
