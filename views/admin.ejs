                            <li><a href="javascript:void(0)"><span data-key="online">Online</span></a></li>
                        </ul>
                    </li>
                    <li><a href="javascript:void(0)"><span data-key="network_diagram">Network Diagram</span></a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button class="dropdown-toggle" onclick="toggleSubmenu(event, this)">
                    <i class="bi bi-sliders"></i> <span data-key="general_setting">General Setting</span>
                    <i class="bi bi-chevron-down ms-auto arrow-icon"></i>
                </button>
                <ul class="submenu">
                    <li><a href="javascript:void(0)"><span data-key="website_setting">Website Setting</span></a></li>
                    <li><a href="javascript:void(0)"><span data-key="sms_setting">SMS Setting</span></a></li>
