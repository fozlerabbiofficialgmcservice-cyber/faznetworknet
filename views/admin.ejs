                        escapeHtml(pkg.name || pkg.profile) + ' — ৳' + price.toFixed(2) + (pkg.poolRanges ? ' · ' + escapeHtml(pkg.poolRanges) : '') + '</option>';
                }).join('');
                if (selectedProfile) select.value = selectedProfile;
