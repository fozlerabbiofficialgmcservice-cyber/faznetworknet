<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAZ NETWORK - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #0a3d2e;
            --primary-hover: #0d4d3a;
            --accent-color: #10b981;
            --sidebar-width: 260px;
        }
        body { 
            background-color: #f8fafc; 
            font-family: 'Segoe UI', Arial, sans-serif; 
            margin: 0;
            padding: 0;
        }
        
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--primary-color);
            color: #fff;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            transition: all 0.3s ease;
            z-index: 1000;
            overflow-y: auto;
        }
        .sidebar-header {
            padding: 20px;
            font-size: 20px;
            font-weight: bold;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .lang-switcher {
            padding: 10px 20px;
            font-size: 13px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .lang-switcher select {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 4px 8px;
            border-radius: 5px;
            font-size: 13px;
            cursor: pointer;
            outline: none;
        }
        .lang-switcher select option {
            background-color: var(--primary-color);
            color: #fff;
        }

        .sidebar-menu { 
            list-style: none; 
            padding: 0; 
            margin: 10px 0 30px 0; 
        }
        .menu-item a, .menu-item .dropdown-toggle {
            color: #a7f3d0;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            font-size: 14px;
        }
        .menu-item a:hover, 
        .menu-item a.active, 
        .menu-item .dropdown-toggle:hover {
            background-color: rgba(16, 185, 129, 0.2);
            color: #fff;
        }
        .menu-item i { margin-right: 12px; font-size: 17px; }
        
        .dropdown-toggle::after {
            display: none;
        }
        
        .submenu {
            background-color: rgba(0, 0, 0, 0.25);
            list-style: none;
            padding: 0;
            display: none;
        }
        .submenu.show { display: block; }
        .submenu a, .submenu button { 
            padding-left: 48px; 
            font-size: 13.5px; 
        }
        .submenu .submenu a { 
            padding-left: 65px; 
            font-size: 13px; 
            background-color: rgba(0, 0, 0, 0.15);
        }
        
        .main-content {
            margin-left: var(--sidebar-width);
            transition: all 0.3s ease;
            padding: 24px;
        }

        .card-custom {
            border: none;
            border-radius: 10px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            background: #ffffff;
        }
        .card-custom-header {
            background-color: #ffffff;
            border-bottom: 1px solid #edf2f7;
            padding: 16px 24px;
            font-weight: 600;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn-theme {
            background-color: var(--primary-color);
            color: #ffffff;
            border: none;
            padding: 9px 22px;
            font-weight: 500;
        }
        .btn-theme:hover {
            background-color: var(--primary-hover);
            color: #ffffff;
        }
        .form-label {
            font-weight: 500;
            font-size: 13.5px;
            color: #334155;
            margin-bottom: 6px;
        }
        .form-control, .form-select {
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            padding: 9px 13px;
            font-size: 14px;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
        }
        .customer-live-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .customer-live-table td { vertical-align: middle; font-size: 13px; }
        .customer-status { min-width: 78px; }
        .customer-session { font-size: 11px; line-height: 1.35; }
        .customer-search-wrap { min-width: 260px; }
        .customer-action-group .btn { min-width: 34px; }
        .customer-ip { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
        .payment-ledger-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .payment-ledger-table td { vertical-align: middle; font-size: 13px; }
        .payment-search-wrap { min-width: 280px; }
        .payment-gateway-badge { color: #fff; min-width: 70px; }
        .gateway-bkash { background: #e2136e; }
        .gateway-nagad { background: #f6921e; }
        .gateway-rocket { background: #8c3494; }
        .payment-kpi { border-left: 4px solid var(--accent-color); }
        .payment-action-group .btn { min-width: 34px; }
        
        @media (max-width: 768px) {
            .sidebar { left: calc(-1 * var(--sidebar-width)); }
            .sidebar.show { left: 0; }
            .main-content { margin-left: 0; }
        }
    
        .hotspot-kpi { border-left: 4px solid var(--accent-color); }
        .hotspot-live-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .hotspot-live-table td { vertical-align: middle; font-size: 13px; }
        .hotspot-search { min-width: 260px; }
        .voucher-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:14px; }
        .voucher-card { border:1px dashed #64748b; border-radius:8px; padding:14px; background:#fff; min-height:185px; break-inside:avoid; page-break-inside:avoid; }
        .voucher-brand { color:var(--primary-color); font-weight:800; font-size:15px; letter-spacing:.02em; }
        .voucher-credential { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-weight:800; font-size:18px; letter-spacing:.04em; }
        .voucher-instruction { font-size:11px; color:#475569; }
        .voucher-cut { border-top:1px dashed #cbd5e1; margin:10px 0; }
        @media (max-width: 1100px) { .voucher-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
        @media (max-width: 800px) { .voucher-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
        @media (max-width: 520px) { .voucher-grid { grid-template-columns:1fr; } }
        @media print {
            @page { size:A4 portrait; margin:8mm; }
            body.hotspot-printing * { visibility:hidden !important; }
            body.hotspot-printing #hotspotVoucherPrint,
            body.hotspot-printing #voucherPrintArea * { visibility:visible !important; }
            body.hotspot-printing #voucherPrintArea { position:absolute; left:0; top:0; width:100%; }
            body.hotspot-printing .voucher-grid { grid-template-columns:repeat(4,1fr) !important; gap:8px !important; }
            body.hotspot-printing .voucher-card { min-height:0; padding:10px; border:1px dashed #444; }
            body.hotspot-printing .voucher-credential { font-size:15px; }
            body.hotspot-printing .voucher-instruction { font-size:9px; }
        }
    </style>
</head>
