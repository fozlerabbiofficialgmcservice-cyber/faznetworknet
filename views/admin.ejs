        function localDateValue() {
            const now = new Date();
            const offset = now.getTimezoneOffset();
            return new Date(now.getTime() - offset * 60000).toISOString().slice(0, 10);
        }
        function addCalendarMonths(dateString, months) {
            const base=new Date(String(dateString||"")+"T00:00:00Z"); if(Number.isNaN(base.getTime())) return "";
            const day=base.getUTCDate(), target=new Date(Date.UTC(base.getUTCFullYear(),base.getUTCMonth()+Number(months),1));
            const last=new Date(Date.UTC(target.getUTCFullYear(),target.getUTCMonth()+1,0)).getUTCDate(); target.setUTCDate(Math.min(day,last));
            return target.toISOString().slice(0,10);
        }
