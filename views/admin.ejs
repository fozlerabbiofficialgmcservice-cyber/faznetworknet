.table-wrap{overflow:auto}.table{margin:0}.table th{font-size:11px;text-transform:uppercase;color:var(--muted);letter-spacing:.04em;white-space:nowrap}.table td{font-size:13px;vertical-align:middle}.badge-soft{background:#d1fae5;color:#065f46}.empty{padding:28px;text-align:center;color:#94a3b8}
.mobile-toggle{display:none;border:0;background:var(--primary);color:#fff;border-radius:8px;width:40px;height:40px}.sidebar-overlay{display:none}
