<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAZ NETWORK - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #0a3d2e;
            --primary-hover: #0d4d3a;
            --accent-color: #10b981;
            --sidebar-width: 260px;
        }
        body { 
            background-color: #f8fafc; 
            font-family: 'Segoe UI', Arial, sans-serif; 
            margin: 0;
            padding: 0;
        }
        
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--primary-color);
            color: #fff;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            transition: all 0.3s ease;
            z-index: 1000;
            overflow-y: auto;
        }
        .sidebar-header {
            padding: 20px;
            font-size: 20px;
            font-weight: bold;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .lang-switcher {
            padding: 10px 20px;
            font-size: 13px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .lang-switcher select {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 4px 8px;
            border-radius: 5px;
            font-size: 13px;
            cursor: pointer;
            outline: none;
        }
        .lang-switcher select option {
            background-color: var(--primary-color);
            color: #fff;
        }

        .sidebar-menu { 
            list-style: none; 
            padding: 0; 
            margin: 10px 0 30px 0; 
        }
        .menu-item a, .menu-item .dropdown-toggle {
            color: #a7f3d0;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            font-size: 14px;
        }
        .menu-item a:hover, 
        .menu-item a.active, 
        .menu-item .dropdown-toggle:hover {
            background-color: rgba(16, 185, 129, 0.2);
            color: #fff;
        }
        .menu-item i { margin-right: 12px; font-size: 17px; }
        
        .dropdown-toggle::after {
            display: none;
        }
        
        .submenu {
            background-color: rgba(0, 0, 0, 0.25);
            list-style: none;
            padding: 0;
            display: none;
        }
        .submenu.show { display: block; }
        .submenu a, .submenu button { 
            padding-left: 48px; 
            font-size: 13.5px; 
        }
        .submenu .submenu a { 
            padding-left: 65px; 
            font-size: 13px; 
            background-color: rgba(0, 0, 0, 0.15);
        }
        
        .main-content {
            margin-left: var(--sidebar-width);
            transition: all 0.3s ease;
            padding: 24px;
        }

        .card-custom {
            border: none;
            border-radius: 10px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            background: #ffffff;
        }
        .card-custom-header {
            background-color: #ffffff;
            border-bottom: 1px solid #edf2f7;
            padding: 16px 24px;
            font-weight: 600;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn-theme {
            background-color: var(--primary-color);
            color: #ffffff;
            border: none;
            padding: 9px 22px;
            font-weight: 500;
        }
        .btn-theme:hover {
            background-color: var(--primary-hover);
            color: #ffffff;
        }
        .form-label {
            font-weight: 500;
            font-size: 13.5px;
            color: #334155;
            margin-bottom: 6px;
        }
        .form-control, .form-select {
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            padding: 9px 13px;
            font-size: 14px;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
        }
        .customer-live-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .ip-pool-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .ip-pool-table td { vertical-align: middle; font-size: 13px; }
        .ip-pool-range { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-word; }
        .ip-pool-network-badge { display:inline-flex; align-items:center; gap:5px; }
        .ip-pool-empty { min-height:220px; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#64748b; }
        @media(max-width:768px){.ip-pool-table{min-width:760px;}}
        .customer-live-table td { vertical-align: middle; font-size: 13px; }
        .customer-status { min-width: 78px; }
        .customer-session { font-size: 11px; line-height: 1.35; }
        .customer-search-wrap { min-width: 260px; }
        .customer-action-group .btn { min-width: 34px; }
        .customer-ip { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
        .payment-ledger-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .payment-ledger-table td { vertical-align: middle; font-size: 13px; }
        .payment-search-wrap { min-width: 280px; }
        .payment-gateway-badge { color: #fff; min-width: 70px; }
        .gateway-bkash { background: #e2136e; }
        .gateway-nagad { background: #f6921e; }
        .gateway-rocket { background: #8c3494; }
        .payment-kpi { border-left: 4px solid var(--accent-color); }
        .payment-action-group .btn { min-width: 34px; }
        
        @media (max-width: 768px) {
            .sidebar { left: calc(-1 * var(--sidebar-width)); }
            .sidebar.show { left: 0; }
            .main-content { margin-left: 0; }
        }
    
        .sidebar-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:999}
        .sidebar-backdrop.show{display:block}
        /* Mobile drawer/backdrop hardening: navigation must never leave an overlay behind. */
        @media (max-width:768px){
            .sidebar-backdrop{pointer-events:auto}
            body.sidebar-open .main-content{filter:none;opacity:1}
        }
        .offcanvas-backdrop{z-index:1040}
        .hotspot-enterprise-table th{white-space:nowrap;font-size:12px;color:#475569;text-transform:uppercase;letter-spacing:.025em}
        .hotspot-server-profile-table th{white-space:nowrap;font-size:12px;color:#475569;text-transform:uppercase;letter-spacing:.025em}
        .hotspot-server-profile-table td{vertical-align:middle;font-size:13px}
        .hotspot-server-profile-table{min-width:980px}
        .hotspot-server-icon{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;background:#ecfdf5;color:#059669}
        .hotspot-server-profile-table .badge{font-weight:600}
        @media(max-width:768px){.hotspot-server-profile-table{min-width:980px}}

        .hotspot-enterprise-table td{vertical-align:middle;font-size:13px}
        .hotspot-enterprise-search{min-width:260px}
        .hotspot-user-icon,.hotspot-empty-icon{display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:#ecfdf5;color:#059669}
        .hotspot-user-icon{width:30px;height:30px;font-size:12px}
        .hotspot-empty-icon{width:54px;height:54px;font-size:24px}
        .hotspot-live-dot{color:#10b981;position:relative}
        .hotspot-live-dot:after{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;background:#10b981;margin-left:5px;vertical-align:middle;box-shadow:0 0 0 0 rgba(16,185,129,.45);animation:hotspotPulse 1.6s infinite}
        @keyframes hotspotPulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.45)}70%{box-shadow:0 0 0 8px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
        @media(max-width:768px){.hotspot-enterprise-search{min-width:100%;width:100%}.hotspot-enterprise-table{min-width:900px}}

        #dynamicPageContent{width:100%;min-width:0}
        .table-responsive{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0}
        .table-responsive>.table{min-width:max-content}
        @media (max-width:768px){
            :root{--sidebar-width:280px}
            body.sidebar-open{overflow:hidden}
            .sidebar{left:calc(-1 * var(--sidebar-width));width:var(--sidebar-width);max-width:86vw;box-shadow:8px 0 24px rgba(0,0,0,.22)}
            .sidebar.show{left:0}
            .main-content{margin-left:0;width:100%;max-width:100%;padding:12px}
            .main-content>.navbar{margin-bottom:12px!important}
            .hotspot-live-table,.customer-live-table,.payment-ledger-table{min-width:760px}
            .hotspot-profile-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .hotspot-profile-table td { vertical-align: middle; font-size: 13px; }
        .hotspot-profile-table .badge { font-weight: 600; }
        @media (max-width: 768px) { .hotspot-profile-table { min-width: 920px; } }
        
        .hotspot-live-table th,.hotspot-live-table td,.customer-live-table th,.customer-live-table td,.payment-ledger-table th,.payment-ledger-table td{white-space:nowrap;padding:8px 10px}
            .hotspot-search,.customer-search-wrap,.payment-search-wrap{min-width:0;width:100%}
        }

        .hotspot-kpi { border-left: 4px solid var(--accent-color); }
        .hotspot-live-table th { white-space: nowrap; font-size: 12px; color: #475569; text-transform: uppercase; letter-spacing: .02em; }
        .hotspot-live-table td { vertical-align: middle; font-size: 13px; }
        .hotspot-search { min-width: 260px; }
        .voucher-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:14px; }
        .voucher-card { border:1px dashed #64748b; border-radius:8px; padding:14px; background:#fff; min-height:185px; break-inside:avoid; page-break-inside:avoid; }
        .voucher-brand { color:var(--primary-color); font-weight:800; font-size:15px; letter-spacing:.02em; }
        .voucher-credential { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-weight:800; font-size:18px; letter-spacing:.04em; }
        .voucher-instruction { font-size:11px; color:#475569; }
        .voucher-cut { border-top:1px dashed #cbd5e1; margin:10px 0; }
        @media (max-width: 1100px) { .voucher-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
        @media (max-width: 800px) { .voucher-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
        @media (max-width: 520px) { .voucher-grid { grid-template-columns:1fr; } }
        @media print {
            @page { size:A4 portrait; margin:8mm; }
            body.hotspot-printing * { visibility:hidden !important; }
            body.hotspot-printing #hotspotVoucherPrint,
            body.hotspot-printing #voucherPrintArea * { visibility:visible !important; }
            body.hotspot-printing #voucherPrintArea { position:absolute; left:0; top:0; width:100%; }
            body.hotspot-printing .voucher-grid { grid-template-columns:repeat(4,1fr) !important; gap:8px !important; }
            body.hotspot-printing .voucher-card { min-height:0; padding:10px; border:1px dashed #444; }
            body.hotspot-printing .voucher-credential { font-size:15px; }
            body.hotspot-printing .voucher-instruction { font-size:9px; }
        }
        .customer-add-shell{max-width:1180px;margin:0 auto;padding-bottom:24px}
        .customer-add-hero{padding:22px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px;border:1px solid #e2e8f0}
        .customer-add-icon{width:42px;height:42px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;background:#ecfdf5;color:#059669;font-size:19px}
        .customer-add-hero-meta{display:flex;align-items:center;gap:8px;color:#64748b;font-size:13px;white-space:nowrap}
        .customer-input-group .input-group-text{background:#f8fafc;border-color:#cbd5e1;color:#64748b;min-width:44px;justify-content:center}
        .customer-input-group .form-control,.customer-input-group .form-select{min-height:44px}
        .customer-helper-switch{border:1px solid #dbe5df;background:#f8fffb;border-radius:10px;padding:10px 14px;width:100%;min-height:62px}
        .customer-helper-switch .form-check-input{cursor:pointer}
        .customer-helper-switch .form-check-label{cursor:pointer;font-size:13px}
        .customer-textarea{border-color:#cbd5e1;border-radius:8px;resize:vertical}
        .billing-validity-panel{border:1px solid #dbe5df;background:#f8fffb;border-radius:12px;padding:18px}
        .billing-presets .billing-preset{border:1px solid #cbd5e1;background:#fff;color:#334155;border-radius:999px;padding:7px 16px;font-size:13px;font-weight:600;transition:.15s}
        .billing-presets .billing-preset:hover,.billing-presets .billing-preset.active{background:#0a3d2e;color:#fff;border-color:#0a3d2e}
        .customer-add-actions{position:sticky;bottom:12px;z-index:20;border:1px solid #e2e8f0}
        @media(max-width:768px){.customer-add-hero{align-items:flex-start;flex-direction:column}.customer-add-hero-meta{white-space:normal}.customer-add-actions{position:static}.customer-add-shell{padding-bottom:8px}}
        /* Bootstrap modal hardening: keep dynamically-created Hotspot modals above every backdrop. */
        .modal-backdrop { z-index: 1040 !important; }
        .modal { z-index: 1055 !important; }
        .modal.show { display: block; }
        /* IP Pools enterprise UI */
        .ip-pool-shell{position:relative}
        .ip-pool-hero{border:1px solid rgba(16,185,129,.16);background:linear-gradient(135deg,#ffffff 0%,#f0fdf8 52%,#ecfdf5 100%);border-radius:20px;padding:22px 24px;box-shadow:0 14px 40px rgba(15,23,42,.06);overflow:hidden}
        .ip-pool-hero:after{content:"";position:absolute;width:220px;height:220px;right:-90px;top:-110px;border-radius:50%;background:rgba(16,185,129,.12);filter:blur(4px)}
        .ip-pool-stat{border:1px solid #e2e8f0;background:#fff;border-radius:16px;padding:14px 16px;box-shadow:0 8px 24px rgba(15,23,42,.05)}
        .ip-pool-stat .value{font-size:22px;font-weight:800;color:#0f172a}
        .ip-pool-card{border:1px solid #e2e8f0;border-radius:18px;background:#fff;box-shadow:0 14px 34px rgba(15,23,42,.06);overflow:hidden}
        .ip-pool-table thead th{background:#f8fafc;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:13px 16px}
        .ip-pool-table tbody td{padding:15px 16px;border-color:#f1f5f9}
        .ip-pool-row{transition:transform .18s ease,background .18s ease,box-shadow .18s ease}
        .ip-pool-row:hover{background:#f8fffb;transform:translateY(-1px);box-shadow:inset 3px 0 0 #10b981}
        .ip-pool-id{font:700 11px ui-monospace,SFMono-Regular,Menlo,monospace;color:#64748b;background:#f8fafc;border:1px solid #e2e8f0;border-radius:7px;padding:3px 7px}
        .ip-pool-action{width:36px;height:36px;border-radius:10px!important;display:inline-flex;align-items:center;justify-content:center;transition:transform .18s ease,box-shadow .18s ease}
        .ip-pool-action:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(15,23,42,.12)}
        .ip-pool-modal .modal-content{border-radius:20px;box-shadow:0 28px 80px rgba(15,23,42,.24);animation:ipPoolModalIn .22s ease-out}
        .ip-pool-modal .modal-header{padding:18px 22px}
        .ip-pool-modal .modal-body{padding:22px}
        .ip-pool-modal .form-control{border-radius:12px;min-height:46px}
        .ip-pool-modal .form-control:focus{border-color:#10b981;box-shadow:0 0 0 4px rgba(16,185,129,.12)}
        .ip-pool-save{border-radius:11px;box-shadow:0 8px 20px rgba(5,150,105,.18);transition:transform .18s ease,box-shadow .18s ease}
        .ip-pool-save:hover{transform:translateY(-1px);box-shadow:0 12px 26px rgba(5,150,105,.25)}
        @keyframes ipPoolModalIn{from{opacity:0;transform:translateY(10px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}
        @media(max-width:768px){.ip-pool-hero{padding:18px}.ip-pool-table{min-width:860px}.ip-pool-modal .modal-body{padding:16px}}
    </style>
</head>
<body>

    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span data-key="brand">FAZ NETWORK</span>
            <button class="btn btn-link text-white d-md-none" onclick="toggleSidebar()">
                <i class="bi bi-x"></i>
            </button>
        </div>

        <div class="lang-switcher">
            <i class="bi bi-translate"></i>
            <select id="langSelect">
                <option value="en" selected>English (USA)</option>
                <option value="bn">বাংলা</option>
            </select>
        </div>

        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="javascript:void(0)" class="active" onclick="switchView('dashboard')"><i class="bi bi-speedometer2"></i> <span data-key="dashboard">Dashboard</span></a>
            </li>

            <li class="menu-item">
                <button class="dropdown-toggle" onclick="toggleSubmenu(event, this)">
                    <i class="bi bi-people"></i> <span data-key="customer">Customer</span>
                    <i class="bi bi-chevron-down ms-auto arrow-icon"></i>
                </button>
                <ul class="submenu">
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('all', 'all_customer')"><span data-key="all_customer">All Customer</span></a></li>
                    <li><a href="javascript:void(0)" onclick="showAddCustomerForm()"><span data-key="add_customer">Add Customer</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('online', 'online_customer')"><span data-key="online_customer">Online Customer</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('offline', 'offline_customer')"><span data-key="offline_customer">Offline Customer</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('active', 'active_customer')"><span data-key="active_customer">Active Customer</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('left', 'left_customer')"><span data-key="left_customer">Left Customer</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('expire', 'expire_customer')"><span data-key="expire_customer">Expire Customer</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('expire_today_yesterday', 'expire_today_yesterday')"><span data-key="expire_today_yesterday">Expire Today & Yesterday</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('expire_7_days', 'expire_7_days')"><span data-key="expire_7_days">Expire in 7 Days</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('new', 'new_customer')"><span data-key="new_customer">New Customer</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadCustomerSection('due', 'due_collection')"><span data-key="due_collection">Due Collection</span></a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button class="dropdown-toggle" onclick="toggleSubmenu(event, this)">
                    <i class="bi bi-bar-chart"></i> <span data-key="report">Report</span>
                    <i class="bi bi-chevron-down ms-auto arrow-icon"></i>
                </button>
                <ul class="submenu">
                    <li><a href="javascript:void(0)"><span data-key="monthly_collection_due">Monthly Collection & Due</span></a></li>
                    <li><a href="javascript:void(0)"><span data-key="monthly_sales">Monthly Sales</span></a></li>
                    <li><a href="javascript:void(0)"><span data-key="invoice_report">Invoice Report</span></a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button class="dropdown-toggle" onclick="toggleSubmenu(event, this)">
                    <i class="bi bi-credit-card"></i> <span data-key="payments">Payments</span>
                    <i class="bi bi-chevron-down ms-auto arrow-icon"></i>
                </button>
                <ul class="submenu">
                    <li><a href="javascript:void(0)" onclick="loadPaymentsSection('pending', 'pending_invoice')"><span data-key="pending_invoice">Pending Invoice</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadPaymentsSection('all', 'all_payments')"><span data-key="all_payments">All Payments</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadPaymentsSection('requests', 'payment_request')"><span data-key="payment_request">Payment Request</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadPaymentsSection('bkash', 'bkash_payments')"><span data-key="bkash_payments">bKash Payments</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadPaymentsSection('nagad', 'nagad_payments')"><span data-key="nagad_payments">Nagad Payments</span></a></li>
                    <li><a href="javascript:void(0)" onclick="loadPaymentsSection('rocket', 'rocket_payments')"><span data-key="rocket_payments">Rocket Payments</span></a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button class="dropdown-toggle" onclick="toggleSubmenu(event, this)">
                    <i class="bi bi-wifi"></i> <span data-key="hotspot">Hotspot</span>
                    <i class="bi bi-chevron-down ms-auto arrow-icon"></i>
                </button>
                <ul class="submenu">
                    <li><a href="javascript:void(0)" onclick="window.loadHotspotDashboard(); return false;"><span data-key="hotspot_dashboard">Dashboard</span></a></li>
                    <li><a href="javascript:void(0)" onclick="window.loadAddHotspotUserView(); return false;"><span data-key="add_hotspot_user">Add Hotspot User</span></a></li>
                    <li><a href="javascript:void(0)" onclick="window.loadHotspotSection('all', 'all_user'); return false;"><span data-key="hotspot_all_users">All Users</span></a></li>
                    <li><a href="javascript:void(0)" onclick="window.loadHotspotSection('active', 'active_user'); return false;"><span data-key="hotspot_active_users">Active Users</span></a></li>
