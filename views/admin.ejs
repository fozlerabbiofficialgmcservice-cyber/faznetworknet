        function purgeStuckBackdrops() {
            document.querySelectorAll('.modal-backdrop').forEach(function(el) { el.remove(); });
            document.querySelectorAll('.offcanvas-backdrop').forEach(function(el) { el.remove(); });
            document.querySelectorAll('.sidebar-backdrop').forEach(function(el) { el.classList.remove('show'); el.remove(); });
            document.querySelectorAll('.offcanvas.show, .offcanvas.showing, .offcanvas.hiding').forEach(function(el) {
                el.classList.remove('show', 'showing', 'hiding');
                el.setAttribute('aria-hidden', 'true');
            });
            if (document.body) {
                document.body.classList.remove('modal-open', 'offcanvas-open', 'sidebar-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
                document.body.removeAttribute('data-bs-overflow');
                document.body.removeAttribute('data-bs-padding-right');
            }
            var sidebar = document.getElementById('sidebar');
            if (sidebar && window.innerWidth < 768) sidebar.classList.remove('show');
            var sidebarButton = document.getElementById('mobileSidebarToggle');
            if (sidebarButton) sidebarButton.setAttribute('aria-expanded', 'false');
        }

        function syncMobileSidebarState(){const sidebar=document.getElementById('sidebar'),backdrop=document.getElementById('sidebarBackdrop'),button=document.getElementById('mobileSidebarToggle');const open=Boolean(sidebar&&sidebar.classList.contains('show')&&window.innerWidth<768);if(backdrop)backdrop.classList.toggle('show',open);document.body.classList.toggle('sidebar-open',open);if(button)button.setAttribute('aria-expanded',open?'true':'false');}
        function closeSidebarMobile(){purgeStuckBackdrops();const sidebar=document.getElementById('sidebar');if(sidebar)sidebar.classList.remove('show');const backdrop=document.getElementById('sidebarBackdrop');if(backdrop)backdrop.classList.remove('show');if(document.body)document.body.classList.remove('sidebar-open');syncMobileSidebarState();}
        function toggleSidebar(){const sidebar=document.getElementById('sidebar');if(!sidebar||window.innerWidth>=768)return;sidebar.classList.toggle('show');syncMobileSidebarState();}

        function toggleSubmenu(event, button) {
            event.stopPropagation();
            const submenu = button.nextElementSibling;
            if (submenu) submenu.classList.toggle('show');
            const arrow = button.querySelector('.arrow-icon');
            if (arrow) arrow.classList.toggle('bi-chevron-up');
        }
        document.addEventListener('click',function(event){if(window.innerWidth>=768)return;const sidebar=document.getElementById('sidebar');if(!sidebar||!sidebar.classList.contains('show'))return;if(event.target.closest('#sidebar .submenu a')||event.target.closest('#sidebar .sidebar-menu > .menu-item > a'))closeSidebarMobile();});
        window.addEventListener('resize',function(){if(window.innerWidth>=768){closeSidebarMobile();purgeStuckBackdrops();}else{syncMobileSidebarState();}});

        const viewTitles = {
            dashboard: 'Dashboard',
            'add-customer': 'Add New Customer',
            'all-customer': 'All Customer (PPPoE)',
            payments: 'All Payments'
        };

        let currentPaymentChannel = '';
        let currentPaymentGateway = 'all';
        let currentPaymentTitleKey = '';
        let currentPaymentPage = 1;
        let currentPaymentUsers = [];
        let currentPaymentRows = [];
        let currentCustomerTitleKey = '';
        let currentCustomerFilter = 'all';
        let currentCustomerUsers = [];
        let trafficChart = null;
        let trafficTimer = null;
        let metricsTimer = null;

        function switchView(viewName, channel = '') {
            purgeStuckBackdrops();
            currentCustomerTitleKey = '';
            currentPaymentTitleKey = '';
            const target = document.getElementById('view-' + viewName) ? viewName : 'dashboard';
            document.querySelectorAll('.admin-view').forEach(view => view.style.display = 'none');
            document.getElementById('view-' + target).style.display = 'block';

            setPageTitleSafe(viewTitles[target] || 'Dashboard');
            currentPaymentChannel = channel || '';
            if (target === 'dashboard') {
                refreshDashboard();
                startTrafficPolling();
            } else if (target === 'all-customer') {
                fetchCustomers();
            } else if (target === 'payments') {
                fetchPayments(currentPaymentChannel);
            }
            if (window.innerWidth < 768) closeSidebarMobile();
        }

        function updateLanguage(lang) {
            document.documentElement.lang = lang;
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (translations[lang] && translations[lang][key]) el.innerText = translations[lang][key];
            });
            document.querySelectorAll('[data-placeholder-key]').forEach(el => {
                const key = el.getAttribute('data-placeholder-key');
                if (translations[lang] && translations[lang][key]) el.placeholder = translations[lang][key];
            });
            if (currentCustomerTitleKey && translations[lang]?.[currentCustomerTitleKey]) {
                setPageTitleSafe(translations[lang][currentCustomerTitleKey]);
            }
            if (currentPaymentTitleKey && translations[lang]?.[currentPaymentTitleKey]) {
                setPageTitleSafe(translations[lang][currentPaymentTitleKey]);
            }
            if (document.getElementById('paymentSearch')) {
                document.getElementById('paymentSearch').placeholder = translations[lang]?.search_payments || '';
            }
            localStorage.setItem('faz_preferred_lang', lang);
        }

        refreshAdminDbHealth();

        const langSelect = document.getElementById('langSelect');
        const savedLang = localStorage.getItem('faz_preferred_lang') || 'en';
        langSelect.value = savedLang;
        langSelect.addEventListener('change', function() { updateLanguage(this.value); });
        updateLanguage(savedLang);

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]));
        }

        let adminDbConnected = <%= Boolean(typeof dbConnected !== 'undefined' && dbConnected) %>;

        function hideAdminDbWarning() {
            const toast = document.getElementById('adminDbWarningToast');
            if (toast) toast.remove();
            clearTimeout(window.__adminDbWarningTimer);
        }

        async function refreshAdminDbHealth() {
            try {
                const response = await fetch('/api/health/database', { cache: 'no-store' });
                const data = await response.json().catch(() => ({}));
                adminDbConnected = Boolean(response.ok && data.success && data.database?.connected);
                if (adminDbConnected) hideAdminDbWarning();
                return adminDbConnected;
            } catch (_) { return false; }
        }

        function showAdminDbWarning(message) {
            if (adminDbConnected) { hideAdminDbWarning(); return; }
            const text = message || 'Database not connected. Please set DATABASE_URL in Render environment.';
            let toast = document.getElementById('adminDbWarningToast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'adminDbWarningToast';
                toast.className = 'alert alert-warning shadow position-fixed top-0 end-0 m-3';
                toast.style.zIndex = '99999';
                toast.style.maxWidth = '420px';
                document.body.appendChild(toast);
            }
            toast.innerHTML = '<i class="bi bi-database-exclamation me-2"></i>' + escapeHtml(text);
            toast.style.display = 'block';
            clearTimeout(window.__adminDbWarningTimer);
            window.__adminDbWarningTimer = setTimeout(() => { toast.style.display = 'none'; }, 6000);
        }

        async function jsonFetch(url, options = {}) {
            try {
                const response = await fetch(url, options);
                const data = await response.json().catch(() => ({}));
                if (!response.ok || data.success === false) {
                    const message = data.message || data.error || 'Request failed';
                    if (/^\/api\/(hotspot|pppoe)\//.test(url) && /database|DATABASE_URL|database configuration/i.test(message) && !adminDbConnected) {
                        await refreshAdminDbHealth();
                        if (!adminDbConnected) showAdminDbWarning('Database not connected. Please set DATABASE_URL in Render environment.');
                    }
                    throw new Error(message);
                }
                return data;
            } catch (error) {
                if (/^\/api\/(hotspot|pppoe)\//.test(url) && /database|DATABASE_URL|database configuration/i.test(String(error?.message || '')) && !adminDbConnected) {
                    await refreshAdminDbHealth();
                    if (!adminDbConnected) showAdminDbWarning('Database not connected. Please set DATABASE_URL in Render environment.');
                }
                throw error;
            }
        }

