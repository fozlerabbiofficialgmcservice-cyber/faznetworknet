            const totalReceived = Number(summary.total_received || 0);
            const totalTransactions = Number(summary.total_transactions || data.total || 0);
            const unmatched = Number(summary.unmatched_count || 0);

            content.innerHTML = `
                <section id="view-payment-ledger" class="admin-view">
                    <div class="row g-3 mb-4">
                        <div class="col-md-4"><div class="card card-custom payment-kpi h-100"><div class="card-body"><div class="text-muted small" data-key="total_received">${escapeHtml(t.total_received)}</div><div class="fs-4 fw-bold text-success mt-1">৳${totalReceived.toFixed(2)}</div></div></div></div>
                        <div class="col-md-4"><div class="card card-custom payment-kpi h-100"><div class="card-body"><div class="text-muted small" data-key="total_transactions">${escapeHtml(t.total_transactions)}</div><div class="fs-4 fw-bold mt-1">${totalTransactions}</div></div></div></div>
                        <div class="col-md-4"><div class="card card-custom payment-kpi h-100"><div class="card-body"><div class="text-muted small" data-key="unmatched_count">${escapeHtml(t.unmatched_count)}</div><div class="fs-4 fw-bold text-warning mt-1">${unmatched}</div></div></div></div>
                    </div>
                    <div class="card card-custom">
                        <div class="card-custom-header flex-wrap">
                            <div class="d-flex align-items-center gap-2"><i class="bi bi-journal-text text-success fs-5"></i><span data-key="payment_ledger">${escapeHtml(t.payment_ledger)}</span><span class="badge bg-success">${data.total || rows.length}</span></div>
                            <div class="payment-search-wrap ms-auto mt-2 mt-md-0"><div class="input-group input-group-sm"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input id="paymentSearch" type="search" class="form-control" placeholder="${escapeHtml(t.search_payments)}" oninput="filterPaymentRows(this.value)"></div></div>
                            <button class="btn btn-outline-success btn-sm mt-2 mt-md-0" onclick="refreshPaymentsSection()"><i class="bi bi-arrow-clockwise"></i></button>
                        </div>
                        <div class="card-body p-0 table-responsive">
                            <table class="table table-hover mb-0 payment-ledger-table">
                                <thead class="table-light"><tr>
                                    <th>#</th><th data-key="trx_txnid">${escapeHtml(t.trx_txnid)}</th><th data-key="gateway">${escapeHtml(t.gateway)}</th><th data-key="amount">${escapeHtml(t.amount)}</th><th data-key="sender_phone">${escapeHtml(t.sender_phone)}</th><th data-key="matched_customer">${escapeHtml(t.matched_customer)}</th><th data-key="status_badge">${escapeHtml(t.status_badge)}</th><th data-key="date_time">${escapeHtml(t.date_time)}</th><th data-key="actions">${escapeHtml(t.actions)}</th>
                                </tr></thead>
                                <tbody id="paymentLedgerBody">${rows.length ? rows.map((tx,i)=>paymentRowHtml(tx, ((data.page||1)-1)*(data.limit||50)+i+1, t)).join('') : '<tr><td colspan="9" class="text-center py-5 text-muted" data-key="no_payments">' + escapeHtml(t.no_payments) + '</td></tr>'}</tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                            <button class="btn btn-sm btn-outline-success" onclick="changePaymentsPage(-1)" ${(data.page||1)<=1?'disabled':''}><i class="bi bi-chevron-left"></i> <span data-key="previous">${escapeHtml(t.previous)}</span></button>
                            <span class="small text-muted"><span data-key="page">${escapeHtml(t.page)}</span> ${data.page||1} <span data-key="of">${escapeHtml(t.of)}</span> ${data.total_pages||1}</span>
                            <button class="btn btn-sm btn-outline-success" onclick="changePaymentsPage(1)" ${(data.page||1)>=(data.total_pages||1)?'disabled':''}><span data-key="next">${escapeHtml(t.next)}</span> <i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                </section>`;
            updateLanguage(lang);
        }

        function paymentRowHtml(tx, index, t) {
            const unmatched = tx.status === 'unmatched';
            const gateway = String(tx.channel || '').toLowerCase();
            const gatewayLabel = gateway === 'bkash' ? 'bKash' : gateway === 'nagad' ? 'Nagad' : gateway === 'rocket' ? 'Rocket' : gateway || '-';
            const action = unmatched ? '<button class="btn btn-sm btn-outline-success" title="' + escapeHtml(t.manual_match) + '" onclick="openManualMatchModal(' + JSON.stringify(tx.trx_id) + ')"><i class="bi bi-person-check"></i></button>' : '<span class="text-muted">—</span>';
            return '<tr data-payment-row>' +
                '<td>' + index + '</td>' +
                '<td><strong>' + escapeHtml(tx.trx_id || '-') + '</strong></td>' +
                '<td><span class="badge payment-gateway-badge ' + paymentGatewayClass(gateway) + '">' + escapeHtml(gatewayLabel) + '</span></td>' +
                '<td class="fw-semibold">৳' + Number(tx.amount || 0).toFixed(2) + '</td>' +
                '<td>' + escapeHtml(tx.sender_phone || '-') + '</td>' +
                '<td>' + escapeHtml(tx.matched_username || '-') + '</td>' +
                '<td>' + paymentStatusBadge(tx.status, t) + '</td>' +
                '<td>' + escapeHtml(tx.created_at ? new Date(tx.created_at).toLocaleString() : '-') + '</td>' +
                '<td><div class="payment-action-group">' + action + '</div></td>' +
                '</tr>';
        }

        async function loadPaymentsSection(gatewayType, titleKey) {
            purgeStuckBackdrops();
            currentPaymentGateway = gatewayType;
            currentPaymentTitleKey = titleKey;
            currentPaymentPage = 1;
            currentCustomerTitleKey = '';
            document.querySelectorAll('.admin-view').forEach(view => view.style.display = 'none');
            setPageTitleSafe(paymentTitle(titleKey));
            document.getElementById('dynamicPageContent').innerHTML = '<div class="card card-custom"><div class="card-custom-header"><i class="bi bi-hourglass-split text-success me-2"></i>Loading financial ledger...</div><div class="card-body text-center py-5"><div class="spinner-border text-success"></div></div></div>';
            await fetchPaymentsSection();
            if (window.innerWidth <= 768) document.getElementById('sidebar').classList.remove('show');
        }

        async function fetchPaymentsSection() {
            try {
                const data = await jsonFetch('/api/payments/transactions?gateway=' + encodeURIComponent(currentPaymentGateway) + '&page=' + currentPaymentPage + '&limit=50');
                renderPaymentLedger(data);
            } catch (error) {
                document.getElementById('dynamicPageContent').innerHTML = '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>' + escapeHtml(error.message) + '</div>';
            }
        }

        async function refreshPaymentsSection() {
            await fetchPaymentsSection();
        }

        async function changePaymentsPage(delta) {
            currentPaymentPage = Math.max(1, currentPaymentPage + delta);
            await fetchPaymentsSection();
        }

        async function openManualMatchModal(trxId) {
            const lang = localStorage.getItem('faz_preferred_lang') || 'en';
            const t = translations[lang] || translations.en;
            const modal = document.createElement('div');
            modal.className = 'modal fade';
            modal.innerHTML = `
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-person-check text-success me-2"></i>${escapeHtml(t.manual_match)}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                        <div class="modal-body">
                            <div class="mb-3"><label class="form-label" data-key="trx_txnid">${escapeHtml(t.trx_txnid)}</label><input class="form-control" id="manualMatchTrx" value="${escapeHtml(trxId)}" readonly></div>
                            <div class="mb-3"><label class="form-label" data-key="username">${escapeHtml(t.username)}</label><input class="form-control" id="manualMatchUsername" placeholder="${escapeHtml(t.enter_username)}"></div>
                        </div>
                        <div class="modal-footer"><button class="btn btn-light border" data-bs-dismiss="modal" data-key="cancel">${escapeHtml(t.cancel)}</button><button class="btn btn-theme" onclick="submitManualMatch()" data-key="match_payment">${escapeHtml(t.match_payment)}</button></div>
                    </div>
                </div>`;
            document.body.appendChild(modal);
            const instance = new bootstrap.Modal(modal);
            modal.addEventListener('hidden.bs.modal', () => modal.remove());
            instance.show();
            setTimeout(()=>document.getElementById('manualMatchUsername')?.focus(),300);
        }

        async function submitManualMatch() {
            const trxId = document.getElementById('manualMatchTrx')?.value.trim();
            const username = document.getElementById('manualMatchUsername')?.value.trim();
            if (!trxId || !username) return alert('Transaction ID and username are required.');
            try {
                await jsonFetch('/api/payments/manual-match', {
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({trxId, username})
                });
                document.querySelector('.modal.show .btn-close')?.click();
                await fetchPaymentsSection();
            } catch (error) { alert(error.message); }
        }

        function customerTitle(key) {
            const lang = localStorage.getItem('faz_preferred_lang') || 'en';
            return translations[lang]?.[key] || translations.en[key] || key;
        }

        function customerStatus(user) {
            if (user.computed_status === 'expired' || (user.expiry_date && new Date(user.expiry_date).getTime() <= Date.now())) {
                return { key: 'expired_status', cls: 'bg-danger', online: false };
            }
            if (user.online) return { key: 'online_status', cls: 'bg-success', online: true };
            return { key: 'offline_status', cls: 'bg-secondary', online: false };
        }

        function filterCustomerRows(query) {
            const q = String(query || '').trim().toLowerCase();
            document.querySelectorAll('#customerFilterBody tr[data-customer-row]').forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        }

        function renderCustomerTable(users) {
            currentCustomerUsers = users || [];
            const lang = localStorage.getItem('faz_preferred_lang') || 'en';
            const t = translations[lang] || translations.en;
            const content = document.getElementById('dynamicPageContent');
            if (!content) return;

            content.innerHTML = `
                <section id="view-customer-filter" class="admin-view">
                    <div class="card card-custom">
                        <div class="card-custom-header flex-wrap">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-people text-success fs-5"></i>
                                <span data-key="customer_table">${escapeHtml(t.customer_table)}</span>
                                <span class="badge bg-success">${users.length}</span>
                                <span class="badge bg-light text-success border"><i class="bi bi-broadcast"></i> <span data-key="router_live">${escapeHtml(t.router_live)}</span></span>
                            </div>
                            <div class="customer-search-wrap ms-auto mt-2 mt-md-0">
