            switchView('add-customer');
        }

        function paymentTitle(key) {
            const lang = localStorage.getItem('faz_preferred_lang') || 'en';
            return translations[lang]?.[key] || translations.en[key] || key;
        }

        function paymentGatewayClass(channel) {
            return channel === 'bkash' ? 'gateway-bkash' : channel === 'nagad' ? 'gateway-nagad' : channel === 'rocket' ? 'gateway-rocket' : 'bg-secondary';
        }

        function paymentStatusBadge(status, t) {
            const cls = status === 'processed' ? 'bg-success' : status === 'duplicate' ? 'bg-danger' : 'bg-warning text-dark';
            const key = status === 'processed' ? 'processed' : status === 'duplicate' ? 'duplicate' : 'unmatched';
            return '<span class="badge ' + cls + '">' + escapeHtml(t[key] || status || '-') + '</span>';
        }

        function filterPaymentRows(query) {
            const q = String(query || '').trim().toLowerCase();
            document.querySelectorAll('#paymentLedgerBody tr[data-payment-row]').forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        }

