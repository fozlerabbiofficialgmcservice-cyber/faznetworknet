<section class="space-y-7">
  <div>
    <p class="text-sm font-medium text-cyan-600">ROUTER SETTINGS</p>
    <h2 class="text-3xl font-black tracking-tight">MikroTik Router</h2>
    <p class="mt-1 text-slate-500">Review the active API endpoint and verify connectivity.</p>
  </div>

  <div class="max-w-2xl bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200">
      <h3 class="font-bold text-lg">Connection Configuration</h3>
    </div>
    <div class="p-6 space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Router Host</label>
          <div class="rounded-xl bg-slate-50 border border-slate-200 px-4 py-3 font-mono text-sm break-all"><%= routerHost || "Not configured" %></div>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">API Port</label>
          <div class="rounded-xl bg-slate-50 border border-slate-200 px-4 py-3 font-mono text-sm"><%= routerPort %></div>
        </div>
      </div>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Password</label>
        <div class="rounded-xl bg-slate-50 border border-slate-200 px-4 py-3 font-mono text-sm">••••••••</div>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-2">
        <button id="test-router-btn" type="button" class="inline-flex justify-center items-center rounded-xl bg-cyan-700 hover:bg-cyan-800 text-white font-semibold px-5 py-3 transition">
          Test Connection
        </button>
        <div id="router-test-result" class="text-sm text-slate-500" aria-live="polite">Connection has not been tested.</div>
      </div>
    </div>
  </div>
</section>
