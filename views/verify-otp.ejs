<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow">
  <title>Verify sign-in | FAZ NETWORK</title>
  <style>
    :root { color-scheme: light; font-family: Arial, Helvetica, sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; background: #052e2b; color: #0f172a; }
    .card { width: 100%; max-width: 440px; padding: 36px; border-radius: 24px; background: #fff; box-shadow: 0 24px 70px rgba(0,0,0,.28); }
    .brand { margin: 0; text-align: center; font-size: 30px; line-height: 1.2; font-weight: 800; letter-spacing: -.8px; }
    .brand span { color: #059669; }
    .subtitle { margin: 10px 0 0; text-align: center; color: #64748b; font-size: 14px; }
    .alert { margin-top: 24px; padding: 12px 14px; border: 1px solid #fecaca; border-radius: 12px; background: #fef2f2; color: #b91c1c; font-size: 14px; font-weight: 600; line-height: 1.5; }
    form { margin-top: 26px; }
    label { display: block; margin-bottom: 10px; font-size: 14px; font-weight: 700; color: #334155; }
    input { display: block; width: 100%; min-height: 58px; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 12px; text-align: center; font-size: 28px; letter-spacing: .45em; outline: none; }
    input:focus { border-color: #059669; box-shadow: 0 0 0 3px rgba(16,185,129,.18); }
    .hint { margin: 12px 0 20px; color: #64748b; font-size: 13px; line-height: 1.6; }
    button { width: 100%; min-height: 48px; padding: 12px 18px; border: 0; border-radius: 12px; font-size: 15px; font-weight: 700; cursor: pointer; }
    .primary { background: #047857; color: #fff; }
    .primary:hover { background: #065f46; }
    .secondary { margin-top: 12px; border: 1px solid #cbd5e1; background: #fff; color: #475569; }
    @media (max-width: 480px) { body { padding: 16px; } .card { padding: 26px 22px; } }
  </style>
</head>
<body>
  <main class="card">
    <h1 class="brand">FAZ <span>NETWORK</span></h1>
    <p class="subtitle">First-login email verification</p>
    <% if (error) { %>
      <div role="alert" aria-live="polite" class="alert"><%= error %></div>
    <% } %>
    <form method="post" action="/login/verify-otp" autocomplete="on">
      <label for="otp">6-digit verification code</label>
      <input id="otp" name="otp" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" minlength="6" aria-describedby="otp-hint" required autofocus>
      <p id="otp-hint" class="hint">The code expires after 5 minutes. Up to 5 attempts are allowed.</p>
      <button class="primary" type="submit">Verify and continue</button>
    </form>
    <form method="post" action="/logout" style="margin-top:0">
      <button class="secondary" type="submit">Cancel sign-in</button>
    </form>
  </main>
</body>
</html>
