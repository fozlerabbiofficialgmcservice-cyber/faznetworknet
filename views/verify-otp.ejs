<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Verify sign-in | FAZ NETWORK"><script src="https://cdn.tailwindcss.com"></script></head>
<body class="min-h-screen bg-slate-950 text-slate-900 flex items-center justify-center p-4">
<div class="w-full max-w-md rounded-3xl bg-white shadow-2xl p-8">
<div class="text-center"><div class="text-3xl font-black">FAZ <span class="text-emerald-600">NETWORK</span></div><p class="mt-2 text-sm text-slate-500">First-login email verification</p></div>
<% if(error){ %><div role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"><%= error %></div><% } %>
<form method="post" action="/login/verify-otp" class="mt-6 space-y-5">
<label class="block text-sm font-bold text-slate-700" for="otp">6-digit verification code</label>
<input id="otp" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" minlength="6" required class="w-full rounded-xl border border-slate-300 px-4 py-4 text-center text-2xl tracking-[.5em] outline-none focus:ring-2 focus:ring-emerald-500" />
<p class="text-sm text-slate-500">The code expires after 5 minutes. Up to 5 attempts are allowed.</p>
<button class="w-full rounded-xl bg-emerald-700 px-5 py-3 font-bold text-white hover:bg-emerald-800">Verify and continue</button>
</form><form method="post" action="/logout" class="mt-4"><button class="w-full rounded-xl border border-slate-300 px-5 py-3 font-semibold text-slate-600">Cancel sign-in</button></form>
</div></body></html>
