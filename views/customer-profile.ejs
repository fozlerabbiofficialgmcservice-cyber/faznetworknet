<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>FAZ NETWORK · Customer 360</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
body{background:#f8fafc;font-family:Segoe UI,Arial,sans-serif;color:#0f172a}.hero{background:linear-gradient(135deg,#0a3d2e,#0d4d3a);color:#fff}.card{box-shadow:0 .125rem .25rem rgba(0,0,0,.075)}.label{font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:#64748b}.metric{font-size:1.45rem;font-weight:700}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.live-dot{width:9px;height:9px;border-radius:50%;display:inline-block;background:#94a3b8}.live-dot.online{background:#34d399;animation:pulse 1.7s infinite}@keyframes pulse{70%{box-shadow:0 0 0 8px rgba(52,211,153,0)}}.sticky{position:sticky;top:0;z-index:1020;background:rgba(248,250,252,.95);backdrop-filter:blur(8px)}
</style></head>
<body>
<div class="sticky border-bottom py-2 mb-3"><div class="container-fluid px-3 px-lg-4 d-flex justify-content-between"><a href="/admin" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Customers</a><span class="small text-muted">Customer 360 / Master Management Hub</span></div></div>
<main id="app" class="container-fluid px-3 px-lg-4 pb-5" data-id="<%= customerId %>">
<section class="hero rounded-3 p-3 p-lg-4 mb-3"><div class="d-flex flex-column flex-xl-row justify-content-between gap-3 align-items-xl-center">
<div><div class="d-flex gap-2 align-items-center flex-wrap"><h2 id="name" class="mb-0">Loading…</h2><span id="status" class="badge bg-secondary">Loading</span></div><div class="small mt-2 d-flex gap-3 flex-wrap"><span><i class="bi bi-telephone me-1"></i><span id="phone">—</span></span><span class="mono"><i class="bi bi-person-badge me-1"></i><span id="username">—</span></span><span id="liveIp" class="mono">IP — · MAC —</span></div></div>
<div class="d-flex gap-2 flex-wrap"><button id="kick" class="btn btn-outline-warning"><i class="bi bi-lightning-charge me-1"></i>Kick / Restart Session</button><button id="renew" class="btn btn-success"><i class="bi bi-credit-card me-1"></i>Add Payment / Renew</button><button id="edit" class="btn btn-outline-primary"><i class="bi bi-pencil-square me-1"></i>Edit Info</button><button id="suspend" class="btn btn-outline-danger"><i class="bi bi-slash-circle me-1"></i>Suspend Line</button></div>
</div></section>
<section class="row g-3 mb-3">
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Package & Bandwidth</div><div id="pkg" class="metric mt-1">—</div><div id="rate" class="text-muted mt-2">Bandwidth —</div><div class="small mt-2">IP Pool: <strong id="pool">—</strong></div><button id="changePkg" class="btn btn-sm btn-outline-primary mt-3">Change Package</button></div></div></div>
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Validity & Expiry</div><div id="days" class="metric mt-1">—</div><div class="text-muted mt-2">Expiry: <strong id="expiry">—</strong></div><div class="small mt-2">Billing cycle: <strong id="cycle">1 month</strong></div></div></div></div>
<div class="col-xl-4"><div class="card border-0 rounded-3 h-100"><div class="card-body"><div class="label">Real-time Session</div><div id="uptime" class="metric mt-1">Offline</div><div class="small text-muted mt-2">Download <strong id="rx">0 B</strong> · Upload <strong id="tx">0 B</strong></div><div class="small mt-2">Last disconnect: <span id="reason">—</span></div></div></div></div>
</section>
<section class="card border-0 rounded-3 mb-3"><div class="card-body"><div class="row g-4">
<div class="col-lg-6"><h5>Personal & Compliance</h5><div class="row g-3 mt-1"><div class="col-md-6"><div class="label">Full Name</div><div id="fullName">—</div></div><div class="col-md-6"><div class="label">Phone</div><div id="phone2">—</div></div><div class="col-md-6"><div class="label">Alternative Phone</div><div id="alt">—</div></div><div class="col-md-6"><div class="label">NID Number</div><div id="nid">—</div></div><div class="col-12"><div class="label">Installation Address</div><div id="address">—</div></div><div class="col-md-6"><div class="label">Area / Zone</div><div id="area">—</div></div><div class="col-md-6"><div class="label">Connection Date</div><div id="connection">—</div></div></div></div>
<div class="col-lg-6"><h5>Network & Fiber</h5><div class="row g-3 mt-1"><div class="col-md-6"><div class="label">PPPoE Username</div><div id="user2" class="mono">—</div></div><div class="col-md-6"><div class="label">PPPoE Password</div><div class="input-group input-group-sm"><input id="pass" class="form-control mono" type="password" readonly><button id="showPass" class="btn btn-outline-secondary"><i class="bi bi-eye"></i></button></div></div><div class="col-md-6"><div class="label">ONU MAC</div><div id="onu" class="mono">—</div></div><div class="col-md-6"><div class="label">Splitter / Box</div><div id="box">—</div></div><div class="col-md-6"><div class="label">Fiber Core / Port</div><div id="core">—</div></div><div class="col-md-6"><div class="label">OLT PON Port</div><div id="olt">—</div></div><div class="col-md-6"><div class="label">Remote IP / Pool</div><div id="remote" class="mono">—</div></div></div></div>
</div></div></section>
<section class="card border-0 rounded-3"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="mb-1">Billing & Payment History</h5><div class="small text-muted">Recent subscriber ledger</div></div><button id="firstPayment" class="btn btn-sm btn-success">Record First Payment</button></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>#</th><th>Date</th><th>Package Billed</th><th>Amount Paid (৳)</th><th>Method</th><th>Trx ID / Receipt</th><th>Status</th></tr></thead><tbody id="ledger"><tr><td colspan="7" class="text-center text-muted py-4">Loading…</td></tr></tbody></table></div></div></section>
</main>
<div class="modal fade" id="renewModal" tabindex="-1"><div class="modal-dialog"><form id="renewForm" class="modal-content"><div class="modal-header"><h5 class="modal-title">Add Payment / Renew</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><div class="alert alert-info small">The amount must exactly match the package price.</div><label class="form-label">Package</label><input id="renewPkg" class="form-control mb-3" readonly><label class="form-label">Exact Amount (৳)</label><input id="amount" type="number" step="0.01" class="form-control mb-3" required><label class="form-label">Payment Method</label><select id="method" class="form-select mb-3"><option value="cash">Cash</option><option value="bkash">bKash</option><option value="nagad">Nagad</option><option value="rocket">Rocket</option></select><label class="form-label">Trx ID / Receipt</label><input id="trx" class="form-control" placeholder="Required for mobile banking"></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Cancel</button><button class="btn btn-success">Confirm Renewal</button></div></form></div></div>
<div class="modal fade" id="editModal" tabindex="-1"><div class="modal-dialog modal-lg"><form id="editForm" class="modal-content"><div class="modal-header"><h5 class="modal-title">Edit Customer Information</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Full Name</label><input name="fullName" id="eName" class="form-control" required></div><div class="col-md-6"><label class="form-label">Phone</label><input name="phone" id="ePhone" class="form-control" required></div><div class="col-md-6"><label class="form-label">Alternative Phone</label><input name="alternativePhone" id="eAlt" class="form-control"></div><div class="col-md-6"><label class="form-label">NID</label><input name="nid" id="eNid" class="form-control"></div><div class="col-md-6"><label class="form-label">Area / Zone</label><input name="areaZone" id="eArea" class="form-control"></div><div class="col-md-6"><label class="form-label">Connection Date</label><input name="connectionDate" id="eConnection" type="date" class="form-control"></div><div class="col-12"><label class="form-label">Installation Address</label><textarea name="installationAddress" id="eAddress" class="form-control"></textarea></div><div class="col-md-6"><label class="form-label">Splitter / Box</label><input name="distributionBox" id="eBox" class="form-control"></div><div class="col-md-6"><label class="form-label">ONU MAC</label><input name="onuMac" id="eOnu" class="form-control"></div><div class="col-md-6"><label class="form-label">Fiber Core / Port</label><input name="fiberDropCore" id="eCore" class="form-control"></div><div class="col-md-6"><label class="form-label">OLT PON Port</label><input name="oltPonPort" id="eOlt" class="form-control"></div><div class="col-md-6"><label class="form-label">PPPoE Password</label><input name="password" id="ePass" class="form-control"></div><div class="col-md-6"><label class="form-label">Remote Address</label><input name="remoteAddress" id="eRemote" class="form-control"></div></div></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Cancel</button><button class="btn btn-primary">Save Customer</button></div></form></div></div>
<div class="modal fade" id="pkgModal" tabindex="-1"><div class="modal-dialog"><form id="pkgForm" class="modal-content"><div class="modal-header"><h5 class="modal-title">Change Package</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><select id="pkgSelect" class="form-select"></select></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Cancel</button><button class="btn btn-primary">Change Package</button></div></form></div></div>
<div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="toast" class="toast"><div class="toast-body"></div></div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
(()=>{const root=document.getElementById('app'),id=root.dataset.id,$=x=>document.getElementById(x);let state;
const api=async(url,o={})=>{const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(url,{...o,signal:c.signal,headers:{Accept:'application/json',...(o.headers||{})}}),d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw Error(d.message||'Request failed');return d}catch(e){if(e.name==='AbortError')throw Error('Request timed out after 8 seconds.');throw e}finally{clearTimeout(t)}};
const toast=(m,type='success')=>{const e=$('toast');e.className='toast text-bg-'+type;e.querySelector('.toast-body').textContent=m;bootstrap.Toast.getOrCreateInstance(e,{delay:3500}).show()};
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const bytes=v=>{const n=Number(v||0);if(!n)return'0 B';const u=['B','KB','MB','GB','TB'],i=Math.min(Math.floor(Math.log(n)/Math.log(1024)),4);return(n/Math.pow(1024,i)).toFixed(i?1:0)+' '+u[i]};
const date=v=>v?new Date(String(v).slice(0,10)+'T00:00:00Z').toLocaleDateString('en-GB',{timeZone:'UTC'}):'—';
const open=x=>bootstrap.Modal.getOrCreateInstance($(x)).show();
function render(){const c=state.customer,l=state.live,p=state.package||{},online=!!l.isLive,s=String(c.status||'active').toLowerCase(),suspended=s==='suspended'||s==='inactive',expired=s==='expired'||Number(c.remainingDays)<0;
$('name').textContent=c.name||'Customer';$('phone').textContent=c.phone||'—';$('username').textContent=c.username||'—';$('liveIp').textContent=online?'IP '+(l.ip||'—')+' · MAC '+(l.mac||'—'):'Offline';$('status').textContent=online?'Online (Live Session)':suspended?'Suspended':expired?'Expired':'Offline';$('status').className='badge '+(online?'bg-success':suspended?'bg-danger':expired?'bg-warning text-dark':'bg-secondary');
$('pkg').textContent=p.name||c.packageName||'—';$('rate').textContent='Bandwidth '+(p.rateLimit||'Not set');$('pool').textContent=p.poolName||'—';$('days').textContent=c.remainingDays==null?'—':c.remainingDays<0?'Expired '+Math.abs(c.remainingDays)+'d ago':c.remainingDays===0?'Expires today':c.remainingDays+' days';$('expiry').textContent=date(c.expirationDate);$('cycle').textContent=(p.durationMonths||1)+' month'+((p.durationMonths||1)==1?'':'s');$('uptime').textContent=online?(l.uptime||'Connected'):'Offline';$('rx').textContent=bytes(l.bytesIn);$('tx').textContent=bytes(l.bytesOut);$('reason').textContent=l.lastDisconnectReason||c.lastDisconnectReason||'Not available';
[['fullName',c.fullName],['phone2',c.phone],['alt',c.alternativePhone],['nid',c.nid],['address',c.installationAddress],['area',c.areaZone],['connection',date(c.connectionDate)],['user2',c.username],['onu',c.onuMac],['box',c.splitterBox],['core',c.fiberCore],['olt',c.oltPonPort],['remote',c.remoteAddress]].forEach(([k,v])=>$(k).textContent=v||'—');$('pass').value=c.password||'';$('renewPkg').value=p.name||c.packageName||'';$('amount').value=Number(p.price||0).toFixed(2);$('suspend').innerHTML='<i class="bi '+(suspended?'bi-check-circle':'bi-slash-circle')+' me-1"></i>'+(suspended?'Reactivate Line':'Suspend Line');$('pkgSelect').innerHTML=(state.plans||[]).map(x=>'<option value="'+esc(x.id)+'">'+esc(x.name)+' · ৳'+Number(x.price||0).toFixed(2)+'</option>').join('')||'<option>No packages</option>';
const rows=state.payments||[];$('ledger').innerHTML=rows.length?rows.map((x,i)=>'<tr><td>'+(i+1)+'</td><td>'+date(x.date)+'</td><td>'+esc(x.packageName||p.name||'—')+'</td><td>৳'+Number(x.amount||0).toFixed(2)+'</td><td>'+esc(x.method||'—')+'</td><td class="mono">'+esc(x.trxId||'—')+'</td><td><span class="badge bg-success">Paid</span></td></tr>').join(''):'<tr><td colspan="7" class="text-center text-muted py-4">No transactions. Record the first payment above.</td></tr>'}
async function load(){try{state=await api('/api/customers/'+encodeURIComponent(id)+'/profile');render()}catch(e){toast(e.message,'danger')}}async function act(url,body,msg){try{await api(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})});toast(msg);await load()}catch(e){toast(e.message,'danger')}}
$('kick').onclick=()=>{if(confirm('Disconnect this active PPPoE session?'))act('/api/customers/'+id+'/kick',{},'Session disconnected.')};
$('renew').onclick=$('firstPayment').onclick=()=>open('renewModal');
$('renewForm').onsubmit=async e=>{e.preventDefault();const method=$('method').value,trx=$('trx').value.trim(),amount=Number($('amount').value);if(method!=='cash'&&!trx)return toast('Trx ID is required for mobile banking.','danger');if(!confirm('Confirm exact payment of ৳'+amount.toFixed(2)+' and renew +1 month?'))return;try{await api('/api/customers/'+id+'/renew',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount,method,trxId:trx})});bootstrap.Modal.getInstance($('renewModal'))?.hide();toast('Payment recorded and customer renewed.');await load()}catch(e){toast(e.message,'danger')}};
$('suspend').onclick=()=>{const off=['suspended','inactive'].includes(String(state.customer.status).toLowerCase())||state.customer.disabled;if(confirm(off?'Reactivate this line?':'Suspend this line and move it to EXPIRED profile?'))act('/api/customers/'+id+'/toggle-status',{suspend:!off},off?'Customer reactivated.':'Customer suspended.')};
$('changePkg').onclick=()=>open('pkgModal');$('pkgForm').onsubmit=async e=>{e.preventDefault();const packageId=$('pkgSelect').value;if(!confirm('Change this customer to the selected package?'))return;try{await api('/api/customers/'+id+'/change-package',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({packageId})});bootstrap.Modal.getInstance($('pkgModal'))?.hide();toast('Package changed successfully.');await load()}catch(e){toast(e.message,'danger')}};
$('edit').onclick=()=>{const c=state.customer;[['eName',c.fullName],['ePhone',c.phone],['eAlt',c.alternativePhone],['eNid',c.nid],['eArea',c.areaZone],['eConnection',String(c.connectionDate||'').slice(0,10)],['eAddress',c.installationAddress],['eBox',c.splitterBox],['eOnu',c.onuMac],['eCore',c.fiberCore],['eOlt',c.oltPonPort],['ePass',c.password],['eRemote',c.remoteAddress]].forEach(([k,v])=>$(k).value=v||'');open('editModal')};
$('editForm').onsubmit=async e=>{e.preventDefault();try{await api('/api/customers/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target).entries()))});bootstrap.Modal.getInstance($('editModal'))?.hide();toast('Customer information saved.');await load()}catch(e){toast(e.message,'danger')}};
$('showPass').onclick=()=>{$('pass').type=$('pass').type==='password'?'text':'password'};load();setInterval(load,5000)})();
</script></body></html>