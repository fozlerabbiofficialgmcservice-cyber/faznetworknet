<%
const body=`
<section class="space-y-6">
<div class="flex items-end justify-between gap-4"><div><p class="text-sm font-bold text-cyan-600">PAYMENTS</p><h2 class="text-3xl font-black">Transactions</h2><p class="text-slate-500">bKash, Nagad and Rocket payment webhook activity.</p></div><button id="payments-refresh" class="btn-secondary">↻ Refresh</button></div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4"><div class="summary-card"><p class="label">Today's Collection</p><p id="today-collection" class="metric">৳0.00</p></div><div class="summary-card"><p class="label">Processed Today</p><p id="processed-count" class="metric">0</p></div><div class="summary-card"><p class="label">Unmatched</p><p id="unmatched-count" class="metric">0</p></div></div>
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden"><div class="p-4 table-wrap"><table class="data-table"><thead><tr><th>Channel</th><th>Trx ID</th><th>Sender</th><th>Amount</th><th>Status</th><th>User</th><th>Time</th><th>Action</th></tr></thead><tbody id="transactions-body"><tr><td colspan="8" class="empty-cell">Loading...</td></tr></tbody></table></div></div>
