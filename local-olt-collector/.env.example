# Set these locally. Never commit real secrets.
OLT_HOST=192.168.1.10
OLT_SNMP_PORT=161
OLT_SNMP_COMMUNITY=replace-with-read-only-community
OLT_ID=vsol-v1601e04
COLLECTOR_ID=faz-local-collector
RENDER_INGEST_URL=https://faznetwork-web.onrender.com/api/olt/sync-telemetry
OLT_COLLECTOR_TOKEN=replace-with-the-same-long-random-secret-as-Render-OLT_COLLECTOR_TOKEN
POLL_INTERVAL_SECONDS=300
SNMP_TIMEOUT=2.5
SNMP_RETRIES=1
HTTP_TIMEOUT=15
MAX_OID_ROWS=10000
# REQUIRED: replace with OIDs from the exact V-SOL firmware MIB; no guessed defaults.
OID_ONU_MAC=
OID_ONU_STATUS=
OID_ONU_RX_POWER=
OID_ONU_TX_POWER=
OID_ONU_PON_PORT=
# Set scaling only after confirming OLT's units in its MIB/documentation.
RX_POWER_SCALE=1
TX_POWER_SCALE=1
# Optional numeric/status codes copied from the official firmware MIB (leave blank until verified).
ONU_STATUS_ONLINE_VALUE=
ONU_STATUS_OFFLINE_VALUE=
ONU_STATUS_LOS_VALUE=
LOG_LEVEL=INFO

# Optional JSON mapping of the exact SNMP table index/ONU ID to panel PPPoE username.
# Example only: {"1.2.3":"10004"}; replace with verified index-to-customer mappings.
ONU_CUSTOMER_MAP_JSON={}
